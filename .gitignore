# Generated optimized images
public/img/optimized/

# Build-time optimized-image catalog (INTORG-946). The committed
# optimized-image-manifest.stub.json keeps imports resolvable in CI/tests
# without prebuild; optimize:images writes the real catalog here for bundling.
src/generated/optimized-image-manifest.json

# Build-time deployed-image-sources catalog (CDN mode). Committed stub keeps
# imports resolvable; optimize:images writes the real catalog here for bundling.
src/generated/deployed-image-sources-catalog.json

.codex

# Figma token exports. Kept locally, not committed. theme.css is the in-repo
# source of truth for the values mirrored from these files.
/ILF website*.json
/Interledger Global UI color palette*.json

# Vitest coverage reports
coverage/
