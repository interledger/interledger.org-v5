        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "events": {
      "type": "component",
      "repeatable": true,
      "required": true,
      "min": 1,
      "component": "blocks.timeline-event",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
