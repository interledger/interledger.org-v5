{
  "collectionName": "components_blocks_split_layouts",
  "info": {
    "displayName": "Split Layout",
    "icon": "layout",
    "description": "Two-column layout: media (image or video) on one side, content (text or quote) on the other."
  },
  "options": {},
  "attributes": {
    "intro": {
      "type": "component",
      "repeatable": false,
      "component": "shared.block-intro",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "layoutType": {
      "type": "customField",
      "customField": "plugin::split-layout-type-picker.layout-type",
      "required": true,
      "default": "image-text",
      "description": "Controls which fields to fill in. Image + Text: fill image and content. Image + Quote: fill image and quote. Video + Text: fill videoUrl and content. Video + Quote: fill videoUrl and quote.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "required": true,
      "default": "right",
      "description": "Which side the image appears on.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "displayRatio": {
      "type": "enumeration",
      "enum": ["3:2", "2:1", "1:1", "1:2"],
      "required": true,
      "default": "3:2",
      "description": "Content-to-media column ratio. 3:2 (default) is the current design: 60/40 columns with a 4:3 image. 2:1 wider content; 1:1 equal columns; 1:2 wider media.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "media": {
      "type": "component",
      "component": "shared.localized-media",
      "repeatable": false,
      "description": "Image for the media column, or the cover image shown before a video plays.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "videoUrl": {
      "type": "string",
      "description": "YouTube or Vimeo URL for the media column. Takes precedence over image when both are set.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "content": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultMarkdown"
      },
      "description": "Rich text for the content column. Leave empty when using a quote instead.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "quote": {
      "type": "text",
      "description": "Quote for the content column. When set, renders as a blockquote instead of rich text.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "quoteSource": {
      "type": "string",
      "description": "Attribution / source for the quote.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "shared.cta-button",
      "max": 2,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
