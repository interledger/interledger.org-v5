{
  "collectionName": "components_blocks_podcast_items",
  "info": {
    "displayName": "Podcast Item",
    "icon": "microphone",
    "description": "A single podcast episode — a Castopod or YouTube embed link, shown with its series and description."
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "series": {
      "type": "enumeration",
      "enum": ["Interledger Salon", "Future Money", "Off the Ledger"],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
