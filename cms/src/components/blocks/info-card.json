{
  "collectionName": "components_blocks_info_card",
  "info": {
    "displayName": "Info Card",
    "icon": "layout",
    "description": "Info card with a heading and body, or an optional cover image"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "body": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "basicMarkdownPreset"
      },
      "required": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imageAlt": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
