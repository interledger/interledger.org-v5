{
  "collectionName": "components_blocks_cta_strips",
  "info": {
    "displayName": "CTA Strip",
    "icon": "cursor",
    "description": "Purple call-to-action strip with an optional heading, optional description, a required primary CTA, and an optional secondary CTA"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "basicMarkdownPreset"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "primaryButtonText": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "primaryButtonLink": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryButtonText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryButtonLink": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "primaryButtonExternal": {
      "type": "boolean",
      "default": false,
      "description": "Open the primary link in a new tab (shows the external icon).",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "primaryButtonDocument": {
      "type": "boolean",
      "default": false,
      "description": "Treat the primary link as a downloadable document (shows download icon).",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryButtonExternal": {
      "type": "boolean",
      "default": false,
      "description": "Open the secondary link in a new tab (shows the external icon).",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryButtonDocument": {
      "type": "boolean",
      "default": false,
      "description": "Treat the secondary link as a downloadable document (shows download icon).",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
