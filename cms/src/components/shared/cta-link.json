{
  "collectionName": "components_shared_cta_links",
  "info": {
    "displayName": "Call-to-action Link"
  },
  "options": {},
  "attributes": {
    "link": {
      "type": "string",
      "required": true,
      "description": "Internal links must start with a leading slash (e.g. /grant/our-grantmaking). External links must be a full URL starting with http:// or https://. mailto:, tel:, and #anchor links are also supported.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "text": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "style": {
      "type": "enumeration",
      "default": "primary",
      "enum": ["primary", "secondary"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "external": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "config": {}
}
