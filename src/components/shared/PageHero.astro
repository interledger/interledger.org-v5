---
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import { resolveCtaLink, PAGE_TOP_OFFSET_CLASS } from '@/utils'

interface HeroCta {
  text: string
  link: string
  style?: 'primary' | 'secondary'
  external?: boolean
  document?: boolean
}

interface BreadcrumbItem {
  name: string
  href: string
}

interface Props {
  title: string
  description?: string | null
  /** Desktop hero image URL, used in a scrolling parallax panel — upload larger than the display size so it can pan without pixelating. Recommended: ~4000×2500px, under 2MB, AVIF format. */
  image?: string | null
  /** Optional mobile image. Recommended: 768×480px. Falls back to desktop when absent. */
  imageMobile?: string | null
  /** Alt text for the desktop hero image. Leave empty/omit for a purely decorative background. */
  imageAlt?: string | null
  /** Alt text for the mobile hero image. Falls back to `imageAlt` when omitted. */
  imageMobileAlt?: string | null
  cta?: HeroCta | null
  breadcrumbs?: BreadcrumbItem[]
  /**
   * `wide` uses a shorter ~21:9 band on tablet+ so landscape heroes show more
   * horizontal content with object-cover. Default keeps the tall 70vh parallax band.
   */
  imageBand?: 'default' | 'wide'
}

const {
  title,
  description,
  image,
  imageAlt,
  imageMobile,
  imageMobileAlt,
  cta,
  breadcrumbs,
  imageBand = 'default'
} = Astro.props

// Icon by link kind (INTORG-938). This hero always showed `arrow-right`, so an
// external link and a document download both got the wrong glyph. The internal
// case keeps the arrow: arrow-on-internal is scoped to components an editor
// picks, and a page template's own hero is not one (Sarah, INTORG-907, 2026-08-09).
const resolvedCta = cta
  ? resolveCtaLink({
      url: cta.link,
      external: cta.external,
      document: cta.document,
      internalIcon: 'arrow-right'
    })
  : null

const resolvedMobileAlt = imageMobileAlt ?? imageAlt

// The copy band's bottom padding separates the copy from the image band under
// it. With no image there is nothing to separate, and that padding only adds
// to the gap the page stack already supplies. On /about-us/ the two stacked
// into 160px below the hero (Radu, 2026-08-28).
const hasImageBand = Boolean(image || imageMobile)
const copyBandPadding = hasImageBand ? 'pb-3xl tablet:pb-5xl' : ''

const isWideBand = imageBand === 'wide'
const bandClass = isWideBand
  ? 'w-full h-[28vh] tablet:h-[min(55vh,calc(100vw*9/21))]'
  : 'w-full h-[30vh] tablet:h-[70vh]'
const parallaxPictureClass =
  'absolute inset-0 block h-full w-full overflow-hidden'
const parallaxImgClass = isWideBand
  ? 'parallax-img absolute inset-x-0 top-[-25%] h-[150%] w-full min-w-full object-cover object-center'
  : 'parallax-img absolute inset-x-0 top-[-40%] h-[180%] w-full object-cover'
---

<!--
  One root element, so a `page-stack` parent counts the hero as a single child.
  The copy band and the image band below it are one unit. Without the wrapper
  the stack would insert its gap between them.

  Inner div spans full width for the white background; px-content applies the
  standard gutter and content-column caps the inner content at max-w-content
  (1440px), matching every other section on the page.
-->
<div data-component="PageHero">
  <div
    class:list={['bg-white px-content', PAGE_TOP_OFFSET_CLASS, copyBandPadding]}
  >
    <div class="content-column">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <Breadcrumbs
            breadcrumbs={breadcrumbs}
            class="[&_a]:text-body-sm-standard"
          >
            <slot name="after-breadcrumbs" />
          </Breadcrumbs>
        )
      }

      <!--
      Semantic h1 with H2 visual scale (32 → 36 → 56). Caps long titles such as
      "Grantmaking" within the phone gutter without mid-word breaks (INTORG-1149).
    -->
      <h1
        class="text-h2 tablet:text-h2-md desktop:text-h2-lg text-neutral-900 mb-2xl tablet:mb-3xl"
      >
        {title}
      </h1>

      {
        description && (
          <p class="text-h4 tablet:text-h4-md desktop:text-h4-lg font-normal mb-xl tablet:mb-lg whitespace-pre-line">
            {description}
          </p>
        )
      }
      {
        cta && resolvedCta && (
          <LinkButton
            href={resolvedCta.href}
            variant={cta.style === 'secondary' ? 'secondary' : 'primary'}
            external={resolvedCta.external}
            document={resolvedCta.document}
            class="w-full tablet:w-auto"
            linkText={cta.text}
            umamiLabel="button_cta"
            umamiBaseComponent="hero"
          >
            {cta.text}
            <Icon name={resolvedCta.icon} slot="icon-right" />
          </LinkButton>
        )
      }
    </div>
  </div>

  <!-- Parallax image: image is taller than the frame so we can pan as you scroll -->
  {
    (image || imageMobile) && (
      <div
        class:list={[
          'parallax-wrapper relative w-full overflow-hidden bg-neutral-900',
          bandClass
        ]}
        data-image-band={imageBand}
      >
        {imageMobile ? (
          <>
            <OptimizedImage
              src={imageMobile}
              alt={resolvedMobileAlt ?? ''}
              width={768}
              height={480}
              loading="eager"
              fetchpriority="high"
              pictureClass={parallaxPictureClass}
              class:list={[parallaxImgClass, 'block tablet:hidden']}
            />
            <OptimizedImage
              src={image ?? imageMobile!}
              alt={imageAlt ?? ''}
              width={1920}
              height={940}
              loading="eager"
              fetchpriority="high"
              pictureClass={parallaxPictureClass}
              class:list={[parallaxImgClass, 'hidden tablet:block']}
            />
          </>
        ) : (
          <OptimizedImage
            src={image}
            alt={imageAlt ?? ''}
            width={1920}
            height={940}
            loading="eager"
            fetchpriority="high"
            pictureClass={parallaxPictureClass}
            class={parallaxImgClass}
          />
        )}
      </div>
    )
  }
</div>

<script>
  // Image is 180% of the frame height — extra height gives room to pan on scroll.
  // Progress tracks how far the hero has moved through the viewport (0 → 1).
  const wrapper = document.querySelector<HTMLElement>('.parallax-wrapper')
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  if (wrapper && !prefersReducedMotion) {
    const isWideBand = wrapper.dataset.imageBand === 'wide'
    const images = wrapper.querySelectorAll<HTMLElement>('.parallax-img')
    let ticking = false

    const updateParallax = () => {
      const rect = wrapper.getBoundingClientRect()
      const totalTransit = window.innerHeight + rect.height
      const progress = Math.max(
        0,
        Math.min(1, (window.innerHeight - rect.top) / totalTransit)
      )
      // Pan from neutral crop toward the top as the hero scrolls up the page.
      const maxOffset = isWideBand
        ? rect.height * 0.25
        : (rect.height * 0.8) / 2
      const offset = maxOffset * progress

      images.forEach((img) => {
        img.style.transform = `translateY(${offset}px)`
      })
      ticking = false
    }

    const onScrollOrResize = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(updateParallax)
    }

    window.addEventListener('scroll', onScrollOrResize, { passive: true })
    window.addEventListener('resize', onScrollOrResize)
    updateParallax()
  }
</script>
