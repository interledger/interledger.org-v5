---
import LinkButton from './LinkButton.astro'
import Icon from './Icon.astro'
import { buildUmamiAttrs, resolveCtaLink } from '@/utils'

interface Props {
  heading: string
  subheading?: string
  buttonUrl: string
  buttonText: string
  buttonExternal?: boolean
  buttonDocument?: boolean
  secondButtonUrl?: string
  secondButtonText?: string
  secondButtonExternal?: boolean
  secondButtonDocument?: boolean
}

const {
  heading,
  subheading,
  buttonUrl,
  buttonText,
  buttonExternal = false,
  buttonDocument = false,
  secondButtonUrl,
  secondButtonText,
  secondButtonExternal = false,
  secondButtonDocument = false
} = Astro.props

const { routeLocale } = Astro.locals

const {
  href,
  external,
  icon: trailingIcon,
  // Mouse-only "whole card is clickable" overlay shares the button's target
  // and its download attribute. Without the second one, clicking the card body
  // navigates to the file while the button downloads it (Jonathan, #483).
  targetAttrs: overlayTargetAttrs,
  downloadAttrs: overlayDownloadAttrs
} = resolveCtaLink({
  url: buttonUrl,
  external: buttonExternal,
  document: buttonDocument
})

const overlayUmamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_card',
  baseComponent: 'title_cards',
  href,
  linkText: buttonText
})

const hasSecondButton = Boolean(
  secondButtonUrl?.trim() && secondButtonText?.trim()
)
const secondResolved = hasSecondButton
  ? resolveCtaLink({
      url: secondButtonUrl!,
      external: secondButtonExternal,
      document: secondButtonDocument
    })
  : null

const buttonClass =
  'tablet:self-start z-1 group-hover/card:border-neutral-900 group-hover/card:text-neutral-900 dark:group-hover/card:border-neutral-0 dark:group-hover/card:text-neutral-0'

const bgClasses = `
nth-[6n+1]:[--card-bg:var(--color-deep-teal-50)] 
nth-[6n+2]:[--card-bg:var(--color-coral-red-50)] 
nth-[6n+3]:[--card-bg:var(--color-tangerine-50)] 
nth-[6n+4]:[--card-bg:var(--color-periwinkle-50)] 
nth-[6n+5]:[--card-bg:var(--color-lagoon-50)] 
nth-[6n+6]:[--card-bg:var(--color-pistachio-50)]
nth-[5n+1]:dark:[--card-bg:var(--color-royal-purple-100)] 
nth-[5n+2]:dark:[--card-bg:var(--color-ocean-100)] 
nth-[5n+3]:dark:[--card-bg:var(--color-wine-100)] 
nth-[5n+4]:dark:[--card-bg:var(--color-forest-green-100)] 
nth-[5n+5]:dark:[--card-bg:var(--color-orchid-100)] 
`
---

<article
  class={`group/card relative flex h-full flex-col justify-between gap-xl p-xl rounded-3xl border border-neutral-50 dark:border-neutral-75 bg-[var(--card-bg)] tablet:bg-white tablet:dark:bg-neutral-900 tablet:hover:bg-[var(--card-bg)] transition-colors duration-200 ${bgClasses}`}
>
  <div class="flex flex-col gap-lg">
    <h3
      class="m-0 text-neutral-900 dark:text-neutral-0 text-h3 tablet:text-h3-md desktop:text-h3-lg"
    >
      {heading}
    </h3>
    {
      subheading && (
        <p class="m-0 text-neutral-100 dark:text-neutral-50 text-h4 tablet:text-h4-md desktop:text-h4-lg">
          {subheading}
        </p>
      )
    }
    <div
      class="text-body-lg-standard text-neutral-100 dark:text-neutral-50 [&_a]:relative [&_a]:z-1 [&_p]:m-0 [&_:is(p,li,a)]:text-body-lg-standard [&_:is(p,li,a)]:tablet:text-body-lg-standard-md [&_:is(p,li)]:text-inherit"
    >
      <slot />
    </div>
  </div>
  <div class="flex flex-col gap-sm z-1 tablet:flex-row tablet:flex-wrap">
    <LinkButton
      href={href}
      variant="secondary"
      mode="auto"
      size="lg"
      external={external}
      document={buttonDocument}
      iconSide={trailingIcon ? 'right' : 'none'}
      class={buttonClass}
      linkText={buttonText}
      umamiLabel="button_card"
      umamiBaseComponent="title_cards"
    >
      {buttonText}
      {
        trailingIcon && (
          <Icon name={trailingIcon} slot="icon-right" class="size-5" />
        )
      }
    </LinkButton>
    {
      secondResolved && (
        <LinkButton
          href={secondResolved.href}
          variant="secondary"
          mode="auto"
          size="lg"
          external={secondResolved.external}
          document={secondButtonDocument}
          iconSide={secondResolved.icon ? 'right' : 'none'}
          class={buttonClass}
          linkText={secondButtonText}
          umamiLabel="button_card"
          umamiBaseComponent="title_cards"
        >
          {secondButtonText}
          {secondResolved.icon && (
            <Icon name={secondResolved.icon} slot="icon-right" class="size-5" />
          )}
        </LinkButton>
      )
    }
  </div>
  {
    !hasSecondButton && (
      <a
        href={href}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 z-0"
        {...overlayTargetAttrs}
        {...overlayDownloadAttrs}
        {...overlayUmamiAttrs}
      />
    )
  }
</article>
