---
import Icon from '@/components/shared/Icon.astro'
import { buildUmamiAttrs } from '@/utils'

interface Props {
  url: string
  label?: string
}
const { url, label = 'Download PDF' } = Astro.props
const { routeLocale } = Astro.locals

// Unique ID per instance so multiple PdfEmbeds on the same page don't collide
const id = `pdf-${Math.random().toString(36).slice(2, 9)}`

const downloadAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_cta',
  baseComponent: 'download_button',
  href: url,
  linkText: label
})
---

<div class="w-full" data-component="PdfEmbed">
  <object
    id={id}
    data={url}
    type="application/pdf"
    width="100%"
    class="min-h-150 w-full"></object>

  <!--
    Fallback download link — hidden by default via inline style (not a Tailwind class)
    so it can't be overridden by other display utilities like `inline-flex`.
    JS shows it only if the <object> fails to render the PDF.

    `target="_blank"` is load-bearing, not cosmetic. The Umami tracker binds a
    capture-phase click listener to every `[data-umami-event]` element. For an
    anchor it calls `preventDefault()`, sends the event, then navigates itself
    with `location.href`. It never looks for `download`, so the attribute was
    discarded and the PDF opened in the tab instead of downloading
    (INTORG-1090, the same bug fixed on `LinkButton` in INTORG-938).

    Umami skips that path when the anchor targets a new context, which leaves
    the default action intact so the browser honours `download`, and no tab is
    left behind. The event is still sent, because only the manual navigation is
    conditional. If the tracker ever learns about `download`, this can go.
  -->
  <a
    id={`${id}-fallback`}
    href={url}
    download
    target="_blank"
    rel="noopener noreferrer"
    style={{ display: 'none' }}
    class="group inline-flex items-center gap-s rounded-full px-xl py-lg text-h4 tablet:text-h4-md desktop:text-h4-lg font-medium no-underline bg-primary text-btn-txt transition-all duration-fast focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary hover:underline"
    {...downloadAttrs}
  >
    {label}
    <Icon
      name="download"
      class="h-[0.75em] w-[0.75em] transition-transform duration-fast group-hover:translate-y-0.5"
    />
  </a>
</div>

<script is:inline define:vars={{ id }}>
  const obj = document.getElementById(id)
  const fallback = document.getElementById(`${id}-fallback`)

  function showFallback() {
    // Hide the <object> and reveal the download link
    obj.style.display = 'none'
    fallback.style.display = 'inline-flex'
  }

  // Fired when the browser can't load or render the embedded content at all
  obj.addEventListener('error', showFallback)

  // Some browsers (e.g. Firefox without a PDF plugin) fire load but render a
  // blank or "plugin not supported" page inside the object. Inspect the content
  // document text to catch that case.
  obj.addEventListener('load', () => {
    try {
      if (obj.contentDocument && obj.contentDocument.body) {
        const text = obj.contentDocument.body.innerText || ''
        if (text.includes('Plugin') || text.includes('not supported')) {
          showFallback()
        }
      }
    } catch {
      // contentDocument access throws for cross-origin content (e.g. a CDN URL).
      // If we can't read it, the PDF almost certainly loaded fine — do nothing.
    }
  })
</script>
