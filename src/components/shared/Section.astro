---
import ContentGutter from './ContentGutter.astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  columnClass?: string
}

const { class: className, columnClass, id, ...rest } = Astro.props
---

<ContentGutter
  as="section"
  class={className}
  columnClass={columnClass}
  id={id}
  {...rest}
>
  <slot />
</ContentGutter>
