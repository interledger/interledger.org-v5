---
/**
 * Navigation card — white bordered card with an inset orchid accent bar
 * (rounded ends, not a flush border) and secondary CTA.
 */
import LinkButton from './LinkButton.astro'
import Icon from './Icon.astro'
import { buildUmamiAttrs, resolveCtaLink } from '@/utils'

interface Props {
  heading: string
  buttonUrl: string
  buttonText: string
  buttonExternal?: boolean
  buttonDocument?: boolean
}

const {
  heading,
  buttonUrl,
  buttonText,
  buttonExternal = false,
  buttonDocument = false
} = Astro.props

const { routeLocale } = Astro.locals

const {
  href,
  external,
  icon: trailingIcon,
  // The overlay anchor needs the download attribute as well as the target, or
  // the card body navigates to the file while the button downloads it
  // (Jonathan, #483).
  targetAttrs: overlayTargetAttrs,
  downloadAttrs: overlayDownloadAttrs
} = resolveCtaLink({
  url: buttonUrl,
  external: buttonExternal,
  document: buttonDocument
})

const overlayUmamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_card',
  baseComponent: 'nav_cards',
  href,
  linkText: buttonText
})
---

<article
  class="relative flex h-full gap-lg rounded-3xl border border-neutral-50 bg-white dark:bg-neutral-100 dark:border-neutral-75 p-xl tablet:gap-xl"
>
  <div
    class="w-1.5 shrink-0 self-stretch rounded-full bg-orchid-100"
    aria-hidden="true"
  >
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-between gap-2xl">
    <h3
      class="m-0 text-h4 text-neutral-900 dark:text-neutral-25 tablet:text-h4-md desktop:text-h4-lg"
    >
      {heading}
    </h3>
    <LinkButton
      href={href}
      variant="secondary"
      mode="auto"
      size="lg"
      external={external}
      document={buttonDocument}
      class="z-[1] w-full tablet:w-fit tablet:self-start"
      class="self-start z-[1]"
      linkText={buttonText}
      umamiLabel="button_card"
      umamiBaseComponent="nav_cards"
    >
      {buttonText}
      {
        trailingIcon && (
          <Icon name={trailingIcon} slot="icon-right" class="size-5" />
        )
      }
    </LinkButton>
  </div>
  <a
    href={href}
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 z-0"
    {...overlayTargetAttrs}
    {...overlayDownloadAttrs}
    {...overlayUmamiAttrs}></a>
</article>
