---
// Rounded status pill: `mint` with the language icon for the Spanish
// fallback disclaimer, `indigo` for a session's "Recording available".
import type { ComponentProps } from 'astro/types'
import Icon from '@/components/shared/Icon.astro'
import { twMerge } from '@/utils'

interface Props {
  tone: 'mint' | 'indigo'
  icon?: ComponentProps<typeof Icon>['name']
  class?: string
}

const TONE_CLASSES: Record<Props['tone'], string> = {
  mint: 'bg-ice-mint-100',
  indigo: 'bg-ice-indigo-100'
}

const { tone, icon, class: className } = Astro.props
const chipClasses = twMerge(
  'mb-0 inline-flex max-w-full shrink-0 items-center gap-sm rounded-full px-lg py-sm text-body-sm-standard text-periwinkle-150 [html[data-theme=dark]_&]:bg-ocean-150 [html[data-theme=dark]_&]:text-soft-indigo-100',
  TONE_CLASSES[tone],
  className
)
---

<p class={chipClasses}>
  {icon && <Icon name={icon} class="size-4 shrink-0" />}
  <slot />
</p>
