---
/**
 * Rich-text / simple blockquote — dual raspberry edges, optional "– source"
 * attribution (design image #1). For author portrait + link use `Quote.astro`.
 */
import { parseMarkdownInline } from '@/utils'

interface Props {
  source?: string
  /** Plain-text quote. If omitted, slot content is used (MDX usage). */
  quote?: string
  umamiContext?: string
}

const { source, quote, umamiContext } = Astro.props
const { routeLocale } = Astro.locals
const htmlSource = parseMarkdownInline(source, {
  page: umamiContext,
  pathname: Astro.url.pathname,
  lang: routeLocale
})
---

<figure
  data-component="blockquote"
  data-umami-component="blockquote"
  class="mb-xl border-x-2 border-raspberry-100 px-xl py-0 tablet:px-xl [&_blockquote]:m-0 [&_blockquote]:border-0 [&_blockquote]:p-0 [&>p]:my-0"
>
  <blockquote
    class="quote-body m-0 border-0 p-0 text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-100"
  >
    {
      // String prop: marks share the text run. Slot (MDX): CSS keeps marks
      // inline on first/last child so they don't become separate paragraphs.
      quote != null && quote !== '' ? (
        <p class="m-0">{`“${quote}”`}</p>
      ) : (
        <div class="quote-slot">
          <slot />
        </div>
      )
    }
  </blockquote>
  {
    htmlSource && (
      <figcaption class="mt-0">
        <p class="m-0 font-poppins text-body-lg-standard text-neutral-100">
          – <cite class="not-italic" set:html={htmlSource} />
        </p>
      </figcaption>
    )
  }
</figure>

<!--
  Styling rendered HTML from set:html

  Since set:html injects raw HTML that doesn't receive Astro's scoped data
  attributes, we use :global() to target injected child elements while keeping
  the parent selector scoped to this component.
-->
<style>
  .quote-slot :global(> p) {
    margin: 0;
  }
  .quote-slot:has(p) :global(> p:first-child)::before {
    content: '“';
  }
  .quote-slot:has(p) :global(> p:last-child)::after {
    content: '”';
  }
  .quote-slot:not(:has(p))::before {
    content: '“';
  }
  .quote-slot:not(:has(p))::after {
    content: '”';
  }

  cite {
    font-weight: 400;
    font-style: normal;
  }

  cite :global(strong) {
    color: inherit;
    font-weight: 400;
    font-style: italic;
  }

  cite :global(em) {
    font-style: italic;
  }
</style>
