---
import { safeAbsoluteHref, useTranslations, buildUmamiAttrs } from '@/utils'
import type { AuthorBioType } from '@/schemas/content.ts'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import FallbackAuthorIcon from '@/components/shared/FallbackAuthorIcon.astro'
import Icon from '@/components/shared/Icon.astro'

interface Props {
  authors: AuthorBioType[]
}

const { authors } = Astro.props

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const umamiAttrs = (href: string, linkText: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'link',
    baseComponent: 'blog',
    href,
    linkText
  })
---

<address
  class="flex flex-wrap gap-lg not-italic"
  role="group"
  aria-label={t('aria.authors')}
>
  {
    authors.map((bio, index) => {
      const href = safeAbsoluteHref(bio.link)
      return (
        <div class="flex flex-nowrap items-center gap-sm text-body-sm-standard text-neutral-100">
          {bio.image ? (
            <OptimizedImage
              src={bio.image}
              alt=""
              width={40}
              height={40}
              class="m-0 size-10 rounded-full object-cover"
              pictureClass="shrink-0"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <FallbackAuthorIcon
              index={index}
              svgClasses="w-[40px] h-[40px] rounded-full shrink-0"
            />
          )}
          {href ? (
            <a
              href={href}
              aria-label={t('aria.author_profile', {
                author: bio.author,
                newTab: t('aria.opens_new_tab')
              })}
              class="flex items-center gap-sm text-neutral-100 text-body-sm-standard decoration-transparent transition-all duration-200 [&_svg]:text-link hover:text-link hover:decoration-link"
              target="_blank"
              rel="author noopener noreferrer"
              {...umamiAttrs(href, bio.author)}
            >
              {bio.author}
              <Icon name="link-rounded" class="size-6" />
            </a>
          ) : (
            <span>{bio.author}</span>
          )}
        </div>
      )
    })
  }
</address>
