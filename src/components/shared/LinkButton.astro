---
import { buttonVariants } from './buttonVariants'
import {
  twMerge,
  useTranslations,
  buildUmamiAttrs,
  resolveDownloadName
} from '@/utils'
import type { HTMLAttributes } from 'astro/types'

type ButtonOpts = NonNullable<Parameters<typeof buttonVariants>[0]>
type ButtonVariant = ButtonOpts['variant']
type ButtonMode = ButtonOpts['mode']
type ButtonSize = ButtonOpts['size']
type ButtonIconOnly = ButtonOpts['iconOnly']
type ButtonIconSide = ButtonOpts['iconSide']

interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'href'> {
  href: string
  variant?: ButtonVariant
  mode?: ButtonMode
  size?: ButtonSize
  iconOnly?: ButtonIconOnly
  iconSide?: ButtonIconSide
  external?: boolean
  /**
   * Document / file CTA: sets the native `download` attribute (same-origin
   * downloads; cross-origin may still open inline depending on CORS) and the
   * screen-reader "(downloads a file)" hint.
   */
  document?: boolean
  ariaDisabled?: boolean
  class?: string
}

const {
  href,
  external = false,
  document: isDocument = false,
  ariaDisabled = false,
  variant,
  mode,
  size,
  iconOnly,
  iconSide,
  class: className,
  ...rest
} = Astro.props

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const resolvedIconSide: ButtonIconSide =
  iconSide ??
  (Astro.slots.has('icon-left')
    ? 'left'
    : Astro.slots.has('icon-right')
      ? 'right'
      : 'none')

if (iconOnly && !rest['aria-label']) {
  // eslint-disable-next-line no-console
  console.warn('[LinkButton] iconOnly={true} requires aria-label')
}

// A download also opens in a new browsing context, and that is load-bearing
// rather than cosmetic.
//
// The Umami tracker binds a capture-phase click listener to every
// `[data-umami-event]` element. For an anchor it calls `preventDefault()`,
// sends the event, then navigates itself with `location.href = href`. It never
// looks for `download`, so the attribute was discarded and the file opened in
// the tab instead of downloading (INTORG-938).
//
// Umami skips that path when the anchor targets a new context, so `_blank`
// leaves the default action intact. The browser then honours `download` and no
// tab is left behind. The event is still sent: Umami tracks either way, and
// only the manual navigation is conditional.
//
// If the tracker ever learns about `download`, this can go back to `external`
// alone. Until then, do not remove it to tidy the markup.
const opensNewContext = external || isDocument
const targetAttrs = opensNewContext
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {}
// Anchors can't be natively disabled. Strip href so Enter activation does
// nothing, add tabindex="-1" so the element drops out of tab order, and
// expose aria-disabled to screen readers. aria-disabled alone is advisory:
// without stripping href, keyboard users can still navigate to and activate
// the link.
const resolvedHref = ariaDisabled ? undefined : href

// The filename derivation moved into the CTA helper so the card overlays get
// the same attribute this button does (Jonathan, #483).
const downloadAttr =
  isDocument && resolvedHref ? resolveDownloadName(resolvedHref) : undefined

const ariaLabel =
  typeof rest['aria-label'] === 'string' ? rest['aria-label'] : ''

// Callers may pass explicit tracking attrs (buildUmamiAttrs or
// buildDeferredUmamiAttrs). Those must win: spreading auto attrs after
// rest would either overwrite data-umami-event* (losing section/action) or
// leave both data-track-event* and data-umami-event* on the element
// (double-fire + Umami still preventDefault-delays same-tab navigation).
const restRecord = rest as Record<string, unknown>
const callerProvidesTracking =
  typeof restRecord['data-umami-event'] === 'string' ||
  typeof restRecord['data-track-event'] === 'string'

const umamiAttrs = callerProvidesTracking
  ? {}
  : buildUmamiAttrs({
      pathname: Astro.url.pathname,
      lang: routeLocale,
      section: 'link',
      href: resolvedHref,
      ariaLabel: ariaLabel
    })
---

<a
  {...rest}
  href={resolvedHref}
  class={twMerge(
    buttonVariants({
      variant,
      mode,
      size,
      iconOnly,
      iconSide: resolvedIconSide,
      class: className
    })
  )}
  data-component="LinkButton"
  {...targetAttrs}
  download={downloadAttr}
  aria-disabled={ariaDisabled ? true : undefined}
  tabindex={ariaDisabled ? -1 : undefined}
  {...umamiAttrs}
>
  <slot name="icon-left" />
  <slot />
  <slot name="icon-right" />
  {external && <span class="sr-only">{t('aria.opens_new_tab')}</span>}
  {isDocument && <span class="sr-only">{t('aria.downloads_file')}</span>}
</a>
