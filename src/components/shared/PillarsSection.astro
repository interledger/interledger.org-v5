---
// Three Card layout
// On desktop, cards stagger-pin via sticky offsets while the heading fades behind them.
// Mobile/tablet: plain vertical stack.
// All animations are scroll-driven (animation-timeline) — no JS.
// Equal-height floor for cards lives in <style> as --card-min-h (see comment there for anchors).

import PillarCard from '@/components/shared/PillarCard.astro'
import { useTranslations, buildUmamiAttrs } from '@/utils'

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

// Icon-only button (an arrow, no visible text) — its accessible name is the
// `aria-label={title}` PillarCard sets directly on the element, so that same
// title has to flow into tracking as `ariaLabel` too, or link_text silently
// drops per ADR-006's "falls back to aria-label" rule.
const pillarUmamiAttrs = (href: string, title: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'button_card',
    baseComponent: 'card',
    href,
    ariaLabel: title
  })

const sectionClasses = `
  px-lg py-5xl font-poppins bg-ice-indigo-100 text-neutral-900
  tablet:py-0 tablet:px-xl tablet:min-h-screen
  desktop:px-5xl
  `
const sectionContainerClasses = `
  flex flex-col gap-2xl 
  tablet:gap-lg tablet:pb-[20vh] 
  desktop:relative
  desktop:max-w-content desktop:mx-auto desktop:pb-[20vh]
  `
const headingClasses = `
  pillars-heading
  text-h2
  tablet:text-h2-md tablet:pt-[20vh] tablet:animate-rise-in-view
  desktop:text-h2-lg
  desktop:z-0 desktop:sticky desktop:top-0 
  `
const cardsContainerClasses = `
  flex flex-col gap-lg 
  list-none pl-0 mb-0
  tablet:pt-4xl
  desktop:flex-row desktop:gap-4xl desktop:items-start
  desktop:pt-0 
  desktop:z-[1]
  desktop:after:content-[''] desktop:after:absolute desktop:after:w-full desktop:after:h-[85vh] desktop:after:bottom-[30vh] desktop:after:-z-[1]
  desktop:after:bg-gradient-to-b desktop:after:from-ice-indigo-100/0 desktop:after:via-ice-indigo-100/100 desktop:after:to-ice-indigo-100/100
  `
//300px (initial offset), 75vh (stagger step), 35vh (sticky pin point), 100px (rise distance)
const cardDivs = `
  pillar-card animate-rise-in-view
  flex-1 m-0
  desktop:flex desktop:flex-col desktop:animate-none
  desktop:min-h-[var(--card-min-h)]
  desktop:first:mt-[300px]
  desktop:nth-[2]:mt-[calc(300px+75vh)]
  desktop:nth-[3]:mt-[calc(300px+2*75vh)]
  desktop:sticky desktop:top-[35vh]
  `
const threePillars = [
  {
    title: t('pillarsSection.card1_title'),
    description: t('pillarsSection.card1_description'),
    href: '/interledger',
    bg: 'bg-aqua-mint-100'
  },
  {
    title: t('pillarsSection.card2_title'),
    description: t('pillarsSection.card2_description'),
    href: '/grant/our-grantmaking',
    bg: 'bg-apricot-100'
  },
  {
    title: t('pillarsSection.card3_title'),
    description: t('pillarsSection.card3_description'),
    href: '/policy-and-advocacy',
    bg: 'bg-soft-indigo-100'
  }
] as const
---

<section aria-labelledby="pillars-heading" class={sectionClasses}>
  <div class={sectionContainerClasses}>
    <h2 id="pillars-heading" class={headingClasses}>
      {t('pillarsSection.heading')}
    </h2>
    <ul class={cardsContainerClasses} role="list">
      {
        threePillars.map((pillar) => (
          <li class={cardDivs}>
            <PillarCard
              title={pillar.title}
              description={pillar.description}
              href={pillar.href}
              class={pillar.bg}
              umamiAttr={pillarUmamiAttrs(pillar.href, pillar.title)}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pillar-card {
    /* Equal-height floor for the cards: staggered top margins break normal
       flex-stretch. Real content height steps down as text re-wraps —
       492px at 1200-1279px, 462px at 1280-1480px, 432px at 1481px+ — so this
       line is anchored to each step's last width (1280px→492px, 1481px→462px)
       to never undershoot. Re-measure if card copy or layout changes. */
    --card-min-h: clamp(432px, calc(683px - 14.9vw), 492px);
  }

  @media (min-width: 1200px) {
    section:has(:focus-visible) .pillar-card {
      position: static;
      margin-top: 0;
      padding-top: var(--spacing-5xl);
    }
    section:has(:focus-visible) ul {
      align-items: stretch;
    }
    section:has(:focus-visible) .pillar-card article {
      height: 100%;
    }
    section:has(:focus-visible) .pillars-heading {
      position: static;
    }
    .pillars-heading {
      animation: shrink linear forwards;
      animation-timeline: view();
      animation-range-start: 10%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillars-heading {
      animation: none;
    }

    @media (min-width: 1200px) {
      .pillar-card {
        position: static;
        margin-top: 0;
        padding-top: var(--spacing-5xl);
      }
      .pillars-heading {
        position: static;
      }
      section ul {
        align-items: stretch;
      }
    }
  }

  @keyframes shrink {
    from {
      scale: 1;
    }
    to {
      scale: 0.6;
    }
  }
</style>
