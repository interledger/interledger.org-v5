---
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import ProfileAvatarFallback from '@/components/shared/ProfileAvatarFallback.astro'
import { defaultLocale, buildUmamiAttrs } from '@/utils'
import { getProfileAvatarColorClass } from '@/components/shared/profileColors'

interface Props {
  name: string
  /** Full site path for foundation profiles, or section-relative path for summit/hackathon. */
  pathSlug: string
  /** Site section — controls the URL prefix (/summit, /hackathon, or none for foundation). */
  section?: string | null
  photo?: string
  photoAlt?: string
  tagline?: string
  umamiContext?: string
  colorIndex?: number
}

const {
  name,
  pathSlug,
  section,
  photo,
  photoAlt,
  tagline,
  umamiContext,
  colorIndex = 0
} = Astro.props
const colorClass = getProfileAvatarColorClass(colorIndex)
const { routeLocale } = Astro.locals
const langPrefix = routeLocale === defaultLocale ? '' : `/${routeLocale}`
const sectionPrefix = section && section !== 'foundation' ? `/${section}` : ''
const profileLink = `${langPrefix}${sectionPrefix}/${pathSlug}`

const umamiBase = {
  currentPath: umamiContext,
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_card' as const,
  baseComponent: 'profile_grid'
}
---

<article class="text-center" data-component="ProfileCard">
  <a
    href={profileLink}
    data-component="ProfileCard"
    class="text-neutral-900 no-underline hover:no-underline dark:text-neutral-0"
    {...buildUmamiAttrs({
      ...umamiBase,
      href: profileLink,
      linkText: `${name} profile`
    })}
  >
    <div
      class={`mx-auto aspect-square w-full max-w-[220px] overflow-hidden rounded-full ${colorClass}`}
    >
      {
        photo ? (
          <OptimizedImage
            src={photo}
            alt={photoAlt ?? name}
            width={240}
            height={240}
            loading="lazy"
            sizes="150px"
            pictureClass="block h-full w-full"
            class="h-full w-full object-cover object-[center_18%]"
          />
        ) : (
          <ProfileAvatarFallback />
        )
      }
    </div>
    <div class="max-w-100 mx-auto mt-xl">
      <h3
        class="mb-sm text-h4 font-normal text-neutral-900 tablet:text-h4-md desktop:text-h4-lg dark:text-neutral-0"
      >
        {name}
      </h3>
      {
        tagline && (
          <p class="mb-xl text-body-lg-standard text-neutral-100 tablet:text-body-lg-standard-md dark:text-neutral-50">
            {tagline}
          </p>
        )
      }
    </div>
  </a>
</article>

<style>
  :global([data-prose] a[data-component='ProfileCard']),
  :global([data-prose] a[data-component='ProfileCard']:hover) {
    text-decoration-line: none;
  }
</style>
