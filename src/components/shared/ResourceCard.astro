---
/**
 * Resource card — white bordered horizontal layout: heading | description + CTA.
 */
import LinkButton from './LinkButton.astro'
import Icon from './Icon.astro'
import { buildUmamiAttrs, resolveCtaLink } from '@/utils'

interface Props {
  heading: string
  buttonUrl: string
  buttonText: string
  buttonExternal?: boolean
  buttonDocument?: boolean
}

const {
  heading,
  buttonUrl,
  buttonText,
  buttonExternal = false,
  buttonDocument = false
} = Astro.props

const { routeLocale } = Astro.locals

const {
  href,
  external,
  icon: trailingIcon,
  // The overlay anchor needs the download attribute as well as the target, or
  // the card body navigates to the file while the button downloads it
  // (Jonathan, #483).
  targetAttrs: overlayTargetAttrs,
  downloadAttrs: overlayDownloadAttrs
} = resolveCtaLink({
  url: buttonUrl,
  external: buttonExternal,
  document: buttonDocument
})

const overlayUmamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_card',
  baseComponent: 'resource_cards',
  href,
  linkText: buttonText
})
---

<article
  class="relative flex h-full flex-col gap-xl rounded-3xl border border-neutral-50 bg-white dark:border-neutral-75 dark:bg-neutral-900 p-xl tablet:flex-row tablet:items-start tablet:gap-2xl"
>
  <h3
    class="m-0 shrink-0 text-h3 text-neutral-900 dark:text-neutral-0 tablet:w-1/2 tablet:text-h3-md desktop:text-h4-lg"
  >
    {heading}
  </h3>
  <div class="flex min-w-0 flex-1 flex-col gap-xl">
    <div
      class="text-h5 text-neutral-50 [&_a]:relative [&_a]:z-[1] [&_p]:m-0 [&_p]:text-inherit [&_p]:text-h5 [&_p]:tablet:text-h5-md [&_p]:desktop:text-h5-lg"
    >
      <slot />
    </div>
    <LinkButton
      href={href}
      variant="secondary"
      mode="auto"
      size="lg"
      external={external}
      document={buttonDocument}
      iconSide={trailingIcon ? 'right' : 'none'}
      class="tablet:self-start z-[1]"
      umamiLabel="button_card"
      umamiBaseComponent="resource_cards"
    >
      {buttonText}
      {
        trailingIcon && (
          <Icon name={trailingIcon} slot="icon-right" class="size-5" />
        )
      }
    </LinkButton>
  </div>
  <a
    href={href}
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 z-0"
    {...overlayTargetAttrs}
    {...overlayDownloadAttrs}
    {...overlayUmamiAttrs}></a>
</article>
