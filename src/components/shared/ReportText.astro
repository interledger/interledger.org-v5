---
/**
 * Paragraph (body copy) or Disclaimer (smaller, muted fine print) block.
 *
 * Disclaimer differs from blocks.paragraph in two ways: it's styled
 * differently, and its richtext is more limited — CKEditor's
 * `basicMarkdownPreset` rather than paragraph's full preset.
 *
 * Disclaimer styles target `p`/`li`/`a` directly instead of the wrapper,
 * since `prose/default.css` styles those tags on `main` and a matching
 * rule beats inheritance — same pattern as FaqItem.astro.
 */
import type { ReportTextType } from '@/types/report'
import CtaButtons from '@/components/blocks/CtaButtons.astro'
import { useTranslations } from '@/utils'

interface Props {
  type: ReportTextType
  buttonText?: string
  buttonLink?: string
  buttonStyle?: 'primary' | 'secondary'
  buttonExternal?: boolean
  buttonDocument?: boolean
}

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const {
  type,
  buttonText,
  buttonLink,
  buttonStyle,
  buttonExternal,
  buttonDocument
} = Astro.props
// List margin/padding utilities live on paragraphClasses/disclaimerClasses,
// not here — they'd otherwise beat footnotes.css's own list/counter layout
// (Tailwind's utilities layer always wins over footnotes.css's `@layer
// components` rules regardless of source order) for the References branch,
// which relies on footnotes.css alone to look like a real footnote list.
const sharedClasses = `
px-lg [&_*:last-child]:mb-0
text-body-lg-standard [&_:is(p,a,li)]:text-body-lg-standard
tablet:px-0 tablet:text-body-lg-standard-md [&_:is(p,a,li)]:tablet:text-body-lg-standard-md
`
const listSpacingClasses = `[&_:is(p,ol,ul,a,h3,h4,h5,h6)]:mb-xl [&_li]:mb-md [&_:is(ol,ul)]:pl-lg [&_:is(ol,ul)]:tablet:pl-xl`
const disclaimerClasses = `p-lg text-h5 text-neutral-150 rounded-3xl border border-neutral-75 bg-ice-indigo-100 [&_:is(p,ul,ol)]:m-0 [&_:is(p,li)]:text-neutral-150 [&_:is(p,li,a)]:text-h5 tablet:p-xl tablet:[&_:is(p,li,a)]:text-h5-md desktop:[&_:is(p,li,a)]:text-h5-lg ${listSpacingClasses}`
const paragraphClasses = `[&_table]:w-full [&_:is(th,td)]:p-md [&_th]:text-neutral-75 [&_thead_th]:text-body-sm-emphasis desktop:[&_thead_th]:text-body-lg-emphasis-md ${listSpacingClasses}`
---

{
  type === 'Button' ? (
    // CtaButtons manages its own spacing/typography (see its own comment on
    // mt-xl/mb-section) — it must not sit inside sharedClasses below, whose
    // prose-tuned `[&_*:last-child]:mb-0` and `[&_:is(p,a,li)]:text-*` rules
    // would override the button's margin and label size.
    buttonText &&
    buttonLink && (
      <div data-report-text="button">
        <CtaButtons
          buttons={[
            {
              text: buttonText,
              link: buttonLink,
              style: buttonStyle,
              external: buttonExternal,
              document: buttonDocument
            }
          ]}
        />
      </div>
    )
  ) : (
    <div class={sharedClasses}>
      {
        type === 'Disclaimer' ? (
          <div
            data-report-text="disclaimer"
            role="note"
            aria-label={t('report.disclaimer_label')}
            class={disclaimerClasses}
          >
            <slot />
          </div>
        ) : type === 'References' ? (
          <div data-report-text="references">
            <slot />
          </div>
        ) : (
          <div data-report-text="paragraph" class={paragraphClasses}>
            <slot />
          </div>
        )
      }
    </div>
  )
}
