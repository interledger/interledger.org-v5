---
// Pill with the language icon, for translation notices: the Spanish fallback
// disclaimer and a summit session's live-translation note.
import Icon from '@/components/shared/Icon.astro'
import { twMerge } from '@/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const chipClasses = twMerge(
  'mb-0 inline-flex max-w-full shrink-0 items-center gap-sm rounded-full bg-ice-mint-100 px-lg py-sm text-body-sm-standard text-periwinkle-150 [html[data-theme=dark]_&]:bg-ocean-150 [html[data-theme=dark]_&]:text-soft-indigo-100',
  className
)
---

<p class={chipClasses}>
  <Icon name="language" class="size-4 shrink-0" />
  <slot />
</p>
