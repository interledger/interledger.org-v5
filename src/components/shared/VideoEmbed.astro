---
import { YouTube } from '@astro-community/astro-embed-youtube'
import { Vimeo } from '@astro-community/astro-embed-vimeo'
import {
  detectVideoProvider,
  buildUmamiAttrs,
  getOptimizedImage
} from '@/utils'

interface Props {
  url: string
  title: string
  poster?: string
}

const { url, title, poster } = Astro.props
const { routeLocale } = Astro.locals
const provider = detectVideoProvider(url)

// A poster lands either in a `poster` attribute or — for the YouTube facade —
// in a CSS background, and neither can carry a srcset. So it takes the single
// full-size URL, exactly as `getHeroSectionStyle` does. Netlify clamps to the
// source width, so asking for the top rung never upscales.
//
// `fullSrc` is null when the source is missing from this deploy; the raw path
// is then the honest fallback.
const posterSrc = poster
  ? (getOptimizedImage(poster).fullSrc ?? poster)
  : undefined

const videoAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'link',
  baseComponent: 'video_embed',
  href: url,
  linkText: title
})

const embedWrapperClass = 'video-embed w-full overflow-hidden rounded-3xl'

/** Provider facade posters cannot use srcset — request the highest thumbnail tier. */
const embedPosterQuality = 'max' as const
---

{
  provider === 'youtube' ? (
    <div class={embedWrapperClass}>
      <YouTube
        id={url}
        playlabel={title}
        poster={posterSrc}
        posterQuality={embedPosterQuality}
      />
    </div>
  ) : provider === 'vimeo' ? (
    <div class={embedWrapperClass}>
      <Vimeo
        id={url}
        playlabel={title}
        poster={posterSrc}
        posterQuality={embedPosterQuality}
      />
    </div>
  ) : provider === 'file' ? (
    <div class={embedWrapperClass}>
      <video
        src={url}
        poster={posterSrc}
        controls
        loop
        muted
        autoplay
        playsinline
        aria-label={title}
        class="block w-full border-0"
      >
        <a href={url} target="_blank" rel="noopener noreferrer" {...videoAttrs}>
          {title}
        </a>
      </video>
    </div>
  ) : (
    <a href={url} target="_blank" rel="noopener noreferrer" {...videoAttrs}>
      {title}
    </a>
  )
}

<style>
  .video-embed :is(lite-youtube, lite-vimeo, video) {
    display: block;
    width: 100%;
  }

  lite-youtube {
    max-width: unset;
  }
</style>
