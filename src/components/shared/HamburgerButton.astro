---
import Icon from '@/components/shared/Icon.astro'
import { useTranslations, buildUmamiAttrs } from '@/utils'

interface Props {
  controlsId: string
  iconId: string
}

const { controlsId, iconId } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const toggleLabel = t('nav.toggle_menu')
const umamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'toggle',
  baseComponent: 'hamburger_menu',
  ariaLabel: toggleLabel
})
---

<button
  type="button"
  class="desktop:hidden inline-flex h-full items-center justify-center self-center cursor-pointer border-0 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
  aria-controls={controlsId}
  aria-expanded="false"
  aria-label={toggleLabel}
  title={toggleLabel}
  data-component="HamburgerButton"
  data-nav-toggle
  {...umamiAttrs}
>
  <div
    id={iconId}
    class="group relative inline-flex size-6 items-center justify-center"
    data-open="false"
  >
    <Icon
      name="menu"
      class="absolute inset-0 size-full group-data-[open=true]:hidden"
    />
    <Icon
      name="close"
      class="absolute inset-0 size-full group-data-[open=false]:hidden"
    />
  </div>
</button>
