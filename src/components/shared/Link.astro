---
import Icon from './Icon.astro'
import { buildUmamiAttrs, resolveCtaLink, type UmamiLabel } from '@/utils'

interface Props {
  href?: string
  text?: string
  style?: string
  variant?: 'hero' | 'default'
  external?: boolean
  /** Downloadable file: shows the download icon and sets `download`. */
  document?: boolean
  /** Umami event label for this link. */
  umamiLabel: UmamiLabel
  /** Umami base_component for this link, e.g. `primary_cta`. */
  umamiBaseComponent: string
}

const {
  href,
  style,
  external,
  document: isDocument,
  text,
  variant,
  umamiLabel,
  umamiBaseComponent
} = Astro.props as Props
const { routeLocale } = Astro.locals

// Icon by link kind (INTORG-938). This component is the older of the two
// buttons and carried its own hardcoded external SVG, a different glyph from
// the one every other CTA uses. It now shares `resolveCtaLink` and `Icon`, so
// the three kinds agree site-wide.
//
// Icons only. The pill shape, the fluid padding and the white-on-purple
// colours stay as they are: this hero is a different design from `PageHero`,
// not the same design built twice. Restyling it needs Radu (INTORG-938).
//
// An internal link keeps showing nothing, which is what it does today.
const resolved = href
  ? resolveCtaLink({ url: href, external, document: isDocument })
  : null

const classes: Record<string, string> = {
  'hero-primary':
    'inline-block w-fit rounded-full bg-white text-primary font-semibold no-underline transition-colors hover:bg-white/90',
  'hero-secondary':
    'inline-block w-fit rounded-full border-2 border-white text-white font-semibold no-underline transition-colors hover:bg-white/15',
  secondary:
    'inline-block w-fit rounded-full bg-white/70 text-primary no-underline transition-colors hover:bg-white/90',
  primary:
    'inline-block w-fit rounded-full bg-primary text-white no-underline transition-colors hover:bg-primary-hover'
}

const key =
  variant === 'hero'
    ? style === 'secondary'
      ? 'hero-secondary'
      : 'hero-primary'
    : style === 'secondary'
      ? 'secondary'
      : 'primary'

const umamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: umamiLabel,
  baseComponent: umamiBaseComponent,
  linkText: text,
  href
})
---

<a
  href={resolved?.href ?? href ?? ''}
  class={classes[key]}
  style={`padding: clamp(0.625rem, 0.56rem + 0.29vi, 0.8rem) clamp(1.25rem, 1.1rem + 0.65vi, 1.6rem);`}
  {...umamiAttrs}
  {...resolved?.targetAttrs}
  {...resolved?.downloadAttrs}
  >{text ?? 'Click'}
  {
    resolved?.icon && (
      <Icon
        name={resolved.icon}
        class="inline-block h-[0.75em] w-[0.75em] align-baseline"
      />
    )
  }
</a>
