---
import {
  buildImageSrcset,
  getOptimizedImage,
  isOptimizableSource,
  resolveOptimizedImage,
  sanitizeBlurPlaceholder
} from '@/utils'

export interface OptimizedImageAlternateSource {
  src: string
  media: string
  sizes: string
  /** CDN width ladder for this source; defaults to the capped default. */
  widths?: readonly number[]
  /**
   * Intrinsic width of `src`, when known. Collapses the ladder's clamped rungs
   * into one at this width — served as the source file itself for an AVIF or
   * WebP source, since a transform there re-encodes without resizing. Set this
   * on any source opting into 2560/3840 via `widths`.
   */
  intrinsicWidth?: number
}

interface Props {
  src: string
  alt: string
  width?: number
  height?: number
  class?: string
  /** Applies to the wrapping `<picture>`, which is always emitted. */
  pictureClass?: string
  loading?: 'lazy' | 'eager'
  sizes?: string
  fetchpriority?: 'high' | 'low' | 'auto'
  decoding?: 'async' | 'sync' | 'auto'
  media?: string
  draggable?: boolean
  /**
   * CDN widths for `src`. The default is `DEFAULT_CDN_WIDTHS`.
   *
   * Use a shorter list for images that never render large. Each width is a
   * separate transform with its own price and its own edge-cache entry.
   * Netlify does not upscale. A width above the intrinsic width of the source
   * therefore returns the same pixels as the width below it.
   *
   * Use `AVATAR_CDN_WIDTHS` for profile photos.
   */
  widths?: readonly number[]
  /** Optional art-directed sources (most specific `media` first). */
  alternateSources?: OptimizedImageAlternateSource[]
  /**
   * Base64 LQIP blur placeholder (`data:image/webp;base64,...`), from a
   * `*Blur` frontmatter field. Painted as a CSS background behind the `<img>`
   * — the opaque real photo covers it the instant it decodes, so this needs
   * no fade/JS. Requires `width`/`height` to reserve the box beforehand.
   */
  placeholder?: string
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  pictureClass: pictureClassName,
  loading = 'lazy',
  sizes = '100vw',
  fetchpriority,
  decoding = 'async',
  media,
  draggable,
  widths,
  alternateSources = [],
  placeholder
} = Astro.props

const safePlaceholder = sanitizeBlurPlaceholder(placeholder)
const placeholderStyle = safePlaceholder
  ? {
      backgroundImage: `url('${safePlaceholder}')`,
      backgroundSize: 'cover',
      backgroundPosition: 'center'
    }
  : undefined

const { variants, fullSrc, avifVariants, avifFullSrc } = src
  ? getOptimizedImage(src, widths)
  : { variants: [], fullSrc: null, avifVariants: [], avifFullSrc: null }

const alternatePictureSources = alternateSources.flatMap(
  ({
    src: alternateSrc,
    media: alternateMedia,
    sizes: alternateSizes,
    widths: alternateWidths,
    intrinsicWidth
  }) => {
    const alternate = resolveOptimizedImage(
      alternateSrc,
      alternateWidths,
      intrinsicWidth
    )
    const sources: Array<{
      type: string
      media: string
      srcset: string
      sizes: string
    }> = []

    if (alternate.avifVariants.length > 0) {
      sources.push({
        type: 'image/avif',
        media: alternateMedia,
        srcset: buildImageSrcset(alternate.avifVariants),
        sizes: alternateSizes
      })
    }

    if (alternate.variants.length > 0) {
      sources.push({
        type: 'image/webp',
        media: alternateMedia,
        srcset: buildImageSrcset(alternate.variants),
        sizes: alternateSizes
      })
    }

    return sources
  }
)

const hasResponsive = variants.length > 0 || alternatePictureSources.length > 0
const webpSrcset = variants.map((v) => `${v.src} ${v.width}w`).join(', ')
const avifSrcset = avifVariants.map((v) => `${v.src} ${v.width}w`).join(', ')
// When a media query is provided, omit <img> src so browsers that don't match
// the <source> media condition don't fetch the image at all.
const imgSrc = media ? undefined : src
---

{
  hasResponsive ? (
    <picture class={pictureClassName}>
      {alternatePictureSources.map((source) => (
        <source
          type={source.type}
          media={source.media}
          srcset={source.srcset}
          sizes={source.sizes}
        />
      ))}
      {avifVariants.length > 0 && (
        <source
          type="image/avif"
          srcset={avifSrcset}
          sizes={sizes}
          media={media}
        />
      )}
      {variants.length > 0 && (
        <source
          type="image/webp"
          srcset={webpSrcset}
          sizes={sizes}
          media={media}
        />
      )}
      <img
        src={imgSrc}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        decoding={decoding}
        style={placeholderStyle}
        data-blur-placeholder={safePlaceholder ? '' : undefined}
        fetchpriority={fetchpriority}
        draggable={draggable}
      />
    </picture>
  ) : fullSrc ? (
    <picture class={pictureClassName}>
      {avifFullSrc && (
        <source type="image/avif" srcset={avifFullSrc} media={media} />
      )}
      <source type="image/webp" srcset={fullSrc} media={media} />
      <img
        src={imgSrc}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        decoding={decoding}
        style={placeholderStyle}
        data-blur-placeholder={safePlaceholder ? '' : undefined}
        fetchpriority={fetchpriority}
        draggable={draggable}
      />
    </picture>
  ) : (
    // Wrapped even with no <source>, so `pictureClass` applies in every branch.
    // Callers put semantics there (breakpoint toggles), and which branch runs
    // depends on deploy state, not on the call site.
    <picture class={pictureClassName}>
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        decoding={decoding}
        style={placeholderStyle}
        data-blur-placeholder={safePlaceholder ? '' : undefined}
        fetchpriority={fetchpriority}
        draggable={draggable}
        data-unoptimized-src={src && isOptimizableSource(src) ? src : undefined}
      />
    </picture>
  )
}

<script>
  // Drops the blur placeholder once the real image has painted. A source with
  // transparency (the hackathon hero, the SVG blog banners) would otherwise
  // keep showing the blur through its own alpha channel forever, since the
  // placeholder is a CSS background sitting behind the image. CSS has no
  // "image loaded" signal, so this is the one part of the blur-up that needs
  // JS — `complete` covers images that finished before this script ran, which
  // eager/high-priority heroes usually do.
  const dropBlurPlaceholder = (img: HTMLImageElement) => {
    img.style.backgroundImage = 'none'
    img.removeAttribute('data-blur-placeholder')
  }

  for (const img of document.querySelectorAll<HTMLImageElement>(
    'img[data-blur-placeholder]'
  )) {
    if (img.complete) {
      dropBlurPlaceholder(img)
    } else {
      // Only on `load`: a failed image should keep the blur rather than fall
      // back to an empty box.
      img.addEventListener('load', () => dropBlurPlaceholder(img), {
        once: true
      })
    }
  }

  if (import.meta.env.DEV) {
    // Surfaces images that fell back to the unoptimized original (e.g. a CDN
    // upload missing from this deploy). Idempotent so duplicate inclusion across
    // components can't double-warn.
    for (const img of document.querySelectorAll(
      'img[data-unoptimized-src]:not([data-unoptimized-warned])'
    )) {
      img.setAttribute('data-unoptimized-warned', '')
      console.warn(
        '[images] Serving unoptimized full-size image: ' +
          img.getAttribute('data-unoptimized-src') +
          ' — not present in this deploy or not eligible for optimization.'
      )
    }
  }
</script>
