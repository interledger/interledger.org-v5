---
import { buildImageSrcset, type OptimizedImage } from '@/utils'

interface Props {
  image: OptimizedImage | null
  /** Original (un-optimized) URL — rendered as a last-resort <source> when no variant exists. */
  rawSrc?: string
  media?: string
  sizes?: string
}

const { image, rawSrc, media, sizes = '100vw' } = Astro.props
---

{
  image && image.avifVariants.length > 0 && (
    <source
      type="image/avif"
      srcset={buildImageSrcset(image.avifVariants)}
      sizes={sizes}
      media={media}
    />
  )
}
{
  image && image.variants.length > 0 && (
    <source
      type="image/webp"
      srcset={buildImageSrcset(image.variants)}
      sizes={sizes}
      media={media}
    />
  )
}
{rawSrc && !image?.variants.length && <source srcset={rawSrc} media={media} />}
