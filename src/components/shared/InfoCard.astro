---
/**
 * Single info card — used by grant `InfoCards` and CardGrid `variant="Info"`.
 */
interface Props {
  heading: string
}

const { heading } = Astro.props
---

<article
  class="flex flex-1 flex-col gap-lg rounded-3xl bg-ice-indigo-100 p-lg text-neutral-900 tablet:gap-xl tablet:p-xl"
>
  <h3 class="m-0 text-h3 text-neutral-900 tablet:text-h3-md desktop:text-h3-lg">
    {heading}
  </h3>
  <div
    class="text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-900 [&_p]:mb-lg [&_p:last-child]:mb-0 [&_ul]:mb-0 [&_ul]:list-disc [&_ul]:ps-2xl [&_li]:mb-md [&_li:last-child]:mb-0"
  >
    <slot />
  </div>
</article>
