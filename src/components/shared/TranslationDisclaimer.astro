---
import LanguageChip from '@/components/shared/LanguageChip.astro'

interface Props {
  isVisible?: boolean
  style?: 'foundation' | 'summit'
}

const { routeLocale } = Astro.locals
const { isVisible = false } = Astro.props
const spanishDisclaimer = 'Esta página aún no está disponible en español.'
---

{isVisible && routeLocale === 'es' && <LanguageChip>
  {spanishDisclaimer}
</LanguageChip>}
