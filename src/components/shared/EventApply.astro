---
/**
 * Event card "Apply" column — title + primary CTA only (no body text field).
 */
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import { buildUmamiAttrs, ensureLeadingSlash } from '@/utils'

interface Props {
  title: string
  buttonText: string
  buttonUrl: string
  buttonExternal?: boolean
}

const { title, buttonText, buttonUrl, buttonExternal = false } = Astro.props

const { routeLocale } = Astro.locals

// Absolute scheme URLs must not go through ensureLeadingSlash (would become
// `/https://…`). Auto-detect so a missing external flag still navigates.
const isAbsoluteUrl = /^https?:\/\//i.test(buttonUrl)
const external = buttonExternal || isAbsoluteUrl
const href = isAbsoluteUrl ? buttonUrl : ensureLeadingSlash(buttonUrl)
---

<div class="flex min-w-0 flex-col gap-lg" data-event-column="apply">
  <h3
    class="m-0 font-poppins text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-100"
  >
    {title}
  </h3>

  <LinkButton
    href={href}
    variant="primary"
    size="lg"
    external={external}
    class="self-start"
    {...buildUmamiAttrs({
      pathname: Astro.url.pathname,
      lang: routeLocale,
      section: 'cta',
      href,
      linkText: buttonText
    })}
  >
    {buttonText}
    <Icon
      name={external ? 'external-link' : 'arrow-right'}
      slot="icon-right"
    />
  </LinkButton>
</div>
