---
/**
 * Event card "Apply" column — title + primary CTA only (no body text field).
 * Self-closing only: no default slot; MDX authors must not put children inside.
 */
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import { buildUmamiAttrs, resolveCtaLink } from '@/utils'

interface Props {
  title: string
  buttonText: string
  buttonUrl: string
  buttonExternal?: boolean
  buttonDocument?: boolean
}

const {
  title,
  buttonText,
  buttonUrl,
  buttonExternal = false,
  buttonDocument = false
} = Astro.props

const { routeLocale } = Astro.locals

// Icon by link kind (INTORG-938). This button hard-coded
// `external ? 'external-link' : 'arrow-right'` and had no download case, so a
// document CTA showed an arrow and never set the `download` attribute.
//
// The internal case keeps the arrow: this CTA belongs to the event card
// template, not to a component an editor picks (Sarah, INTORG-907,
// 2026-08-09).
const resolved = resolveCtaLink({
  url: buttonUrl,
  external: buttonExternal,
  document: buttonDocument,
  internalIcon: 'arrow-right'
})
---

<div class="flex min-w-0 flex-col gap-lg" data-event-column="apply">
  <h3
    class="m-0 font-poppins text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-100"
  >
    {title}
  </h3>

  <LinkButton
    href={resolved.href}
    variant="primary"
    size="lg"
    external={resolved.external}
    document={resolved.document}
    class="self-start"
    {...buildUmamiAttrs({
      pathname: Astro.url.pathname,
      lang: routeLocale,
      section: 'cta',
      href: resolved.href,
      linkText: buttonText
    })}
  >
    {buttonText}
    <Icon name={resolved.icon} slot="icon-right" />
  </LinkButton>
</div>
