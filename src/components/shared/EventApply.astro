---
/**
 * Event card "Apply" column — title, optional body text, and a CtaButtons
 * primary with no trailing icon.
 */
import CtaButtons from '@/components/blocks/CtaButtons.astro'

interface Props {
  title?: string
  text?: string
  buttonText: string
  buttonUrl: string
  buttonExternal?: boolean
  buttonDocument?: boolean
}

const {
  title,
  text,
  buttonText,
  buttonUrl,
  buttonExternal = false,
  buttonDocument = false
} = Astro.props
const hasText = Boolean(text) || Astro.slots.has('default')
---

<div class="flex min-w-0 flex-col gap-xl" data-event-column="apply">
  {
    title && (
      <h3 class="m-0 font-poppins text-h3 text-neutral-100 dark:text-neutral-0 tablet:text-h3-md desktop:text-h3-lg">
        {title}
      </h3>
    )
  }

  {
    hasText && (
      <div
        data-event-copy
        class="font-poppins text-h5 text-neutral-100 dark:text-neutral-0 [&_p]:m-0"
      >
        <slot>{text}</slot>
      </div>
    )
  }

  <div class="[&_[data-component='CtaButtons']]:m-0">
    <CtaButtons
      hideIcons
      buttons={[
        {
          text: buttonText,
          link: buttonUrl,
          style: 'primary',
          external: buttonExternal,
          document: buttonDocument
        }
      ]}
    />
  </div>
</div>
