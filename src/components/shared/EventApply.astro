---
/**
 * Event card "Apply" column — MDX authoring + internal render from EventCard.
 */
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import { buildUmamiAttrs, ensureLeadingSlash } from '@/utils'

interface Props {
  title: string
  text?: string
  buttonText: string
  buttonUrl: string
  buttonExternal?: boolean
}

const {
  title,
  text,
  buttonText,
  buttonUrl,
  buttonExternal = false
} = Astro.props

const { routeLocale } = Astro.locals
const href = buttonExternal ? buttonUrl : ensureLeadingSlash(buttonUrl)
const hasText = Boolean(text) || Astro.slots.has('default')
---

<div class="flex min-w-0 flex-col gap-lg" data-event-column="apply">
  <h3
    class="m-0 font-poppins text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-100"
  >
    {title}
  </h3>

  {
    hasText && (
      <div class="font-poppins text-body-lg-standard text-neutral-100 [&_p]:m-0">
        <slot>{text}</slot>
      </div>
    )
  }

  <LinkButton
    href={href}
    variant="primary"
    size="lg"
    external={buttonExternal}
    class="self-start"
    {...buildUmamiAttrs({
      pathname: Astro.url.pathname,
      lang: routeLocale,
      section: 'cta',
      href,
      linkText: buttonText
    })}
  >
    {buttonText}
    <Icon name="arrow-right" slot="icon-right" />
  </LinkButton>
</div>
