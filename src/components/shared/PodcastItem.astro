---
/**
 * Podcast Item — series, title, description + player for a single episode.
 *
 * Playback is delegated to the real embed rather than custom player chrome:
 * any URL VideoEmbed recognizes (YouTube, Vimeo, direct file) renders through
 * it; Castopod / unrecognized URLs fall back to a raw iframe. Neither can be
 * driven by an external scrubber, so no fake play/seek UI is built.
 */
import { detectVideoProvider, twMerge } from '@/utils'
import VideoEmbed from './VideoEmbed.astro'
import type { Podcast } from '@/types/podcast'

interface Props {
  podcast: Podcast
  theme?: 'light' | 'dark'
}

const { podcast, theme = 'light' } = Astro.props
const { title, description, url, series } = podcast
const isDark = theme === 'dark'
const provider = detectVideoProvider(url)
---

<article
  class={twMerge(
    'flex w-full flex-col gap-xl desktop:flex-row desktop:items-center desktop:gap-2xl'
  )}
>
  <div
    class={twMerge(
      'flex flex-col gap-md desktop:w-1/2',
      isDark ? 'text-neutral-0' : 'text-neutral-900'
    )}
  >
    <p
      class={twMerge(
        'm-0 text-caption uppercase tracking-wide',
        isDark ? 'text-neutral-50' : 'text-neutral-75'
      )}
    >
      {series}
    </p>
    <h3
      class="m-0 text-h4 tablet:text-h4-md desktop:text-h4-lg"
    >
      {title}
    </h3>
    <p
      class={twMerge(
        'm-0 text-h5 tablet:text-h5-md desktop:text-h5-lg',
        isDark ? 'text-neutral-25' : 'text-neutral-100'
      )}
    >
      {description}
    </p>
  </div>

  <div
    class={twMerge(
      'rounded-3xl border p-lg desktop:w-1/2',
      isDark ? 'border-neutral-75' : 'border-neutral-50'
    )}
  >
    <div class="flex min-w-0 flex-col gap-md">
      {
        provider ? (
          <VideoEmbed url={url} title={title} />
        ) : (
          <iframe
            title={`${title} — podcast player`}
            class="h-28 w-full"
            loading="lazy"
            src={url}
          />
        )
      }
    </div>
  </div>
</article>
