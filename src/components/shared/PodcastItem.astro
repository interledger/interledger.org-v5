---
/**
 * Podcast Item — series, title, description + player for a single episode.
 *
 * Playback is delegated to the real embed rather than custom player chrome:
 * any URL VideoEmbed recognizes (YouTube, Vimeo, direct file) renders through
 * it; Castopod / unrecognized URLs fall back to a raw iframe. Neither can be
 * driven by an external scrubber, so no fake play/seek UI is built.
 */
import { detectVideoProvider } from '@/utils'
import VideoEmbed from './VideoEmbed.astro'
import type { Podcast } from '@/types/podcast'

interface Props {
  podcast: Podcast
}

const { podcast } = Astro.props
const { title, description, url, series } = podcast
const provider = detectVideoProvider(url)
---

<article
  class="flex w-full flex-col gap-xl desktop:flex-row desktop:items-center desktop:gap-2xl"
>
  <div class="flex flex-col gap-md text-neutral-900 desktop:w-1/2">
    <p class="m-0 text-caption uppercase tracking-wide text-neutral-75">
      {series}
    </p>
    <h3 class="m-0 text-h4 tablet:text-h4-md desktop:text-h4-lg">
      {title}
    </h3>
    <p
      class="m-0 text-h5 text-neutral-100 tablet:text-h5-md desktop:text-h5-lg"
    >
      {description}
    </p>
  </div>

  <div class="rounded-3xl border border-neutral-50 p-lg desktop:w-1/2">
    <div class="flex min-w-0 flex-col gap-md">
      {
        provider ? (
          <VideoEmbed url={url} title={title} />
        ) : (
          <iframe
            title={`${title} — podcast player`}
            class="h-28 w-full"
            loading="lazy"
            src={url}
          />
        )
      }
    </div>
  </div>
</article>
