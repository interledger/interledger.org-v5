---
/**
 * Podcast Item — description + player card for a single episode.
 *
 * The card shell (thumbnail, episode, series, title) matches the design, but
 * playback itself is delegated to the real embed rather than custom player
 * chrome: any URL VideoEmbed recognizes (YouTube, Vimeo, direct file) renders
 * through it; anything else (Castopod, unrecognized) falls back to the raw
 * iframe pattern used by the site's other podcast embeds. Neither can be
 * driven by an external scrubber, so no fake play/seek UI is built.
 */
import { detectVideoProvider, twMerge } from '@/utils'
import VideoEmbed from './VideoEmbed.astro'
import type { Podcast } from '@/types/podcast'

interface Props {
  podcast: Podcast
  theme?: 'light' | 'dark'
}

const { podcast, theme = 'light' } = Astro.props
const { title, description, url } = podcast
const isDark = theme === 'dark'
const provider = detectVideoProvider(url)
---

<article
  class={twMerge(
    'flex w-full flex-col gap-xl desktop:flex-row desktop:items-center desktop:gap-2xl'
  )}
>
  <p
    class={twMerge(
      'mb-0 text-h5 tablet:text-h5-md desktop:w-1/2 desktop:text-h5-lg',
      isDark ? 'text-neutral-0' : 'text-neutral-900'
    )}
  >
    {description}
  </p>

  <div
    class={twMerge(
      'rounded-3xl border p-lg desktop:w-1/2',
      isDark ? 'border-neutral-75' : 'border-neutral-50'
    )}
  >
    <div class="flex items-center gap-lg">
      <div class="flex min-w-0 flex-1 flex-col gap-md">
        {
          provider ? (
            <VideoEmbed url={url} title={title} />
          ) : (
            <iframe
              title={`${title} — podcast player`}
              class="h-28 w-full"
              loading="lazy"
              src={url}
            />
          )
        }
      </div>
    </div>
  </div>
</article>
