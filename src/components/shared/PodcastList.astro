---
/**
 * Podcast List — renders a page of the /podcast episode list.
 * podcasts is a plain frontmatter array (page-owned, not a relation), so
 * there's no category/relation lookup here — just a direct map. Callers pass
 * episodes already in display order (see paginatePodcastEpisodes).
 */
import PodcastItem from './PodcastItem.astro'
import type { Podcast } from '@/types/podcast'

interface Props {
  podcasts: Podcast[]
  theme?: 'light' | 'dark'
}

const { podcasts, theme = 'light' } = Astro.props
const isDark = theme === 'dark'
---

<ul class="m-0 flex list-none flex-col p-0" role="list">
  {
    podcasts.map((podcast) => (
      <li
        class:list={[
          'border-b py-3xl first:pt-0 last:border-b-0 last:pb-0',
          isDark ? 'border-neutral-75' : 'border-neutral-50'
        ]}
      >
        <PodcastItem podcast={podcast} theme={theme} />
      </li>
    ))
  }
</ul>
