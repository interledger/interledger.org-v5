---
/**
 * Event card "Where" column — MDX authoring + internal render from EventCard.
 */
import Icon from '@/components/shared/Icon.astro'
import { useTranslations } from '@/utils'

interface Props {
  title: string
  text?: string
  location?: string
}

const { title, text, location } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const hasText = Boolean(text) || Astro.slots.has('default')
---

<div class="flex min-w-0 flex-col gap-xl" data-event-column="where">
  <h3
    class="m-0 font-poppins text-h3 text-neutral-100 dark:text-neutral-0 tablet:text-h3-md desktop:text-h3-lg"
  >
    {title}
  </h3>

  {
    location && (
      <div class="flex items-center gap-lg text-neutral-100 dark:text-neutral-0">
        <Icon
          name="map-pin"
          class="size-[26px] shrink-0 text-neutral-75 dark:text-neutral-0 desktop:size-8"
        />
        <p
          data-event-meta
          class="m-0 whitespace-pre-line font-poppins text-h4 tablet:text-h4-md desktop:text-h4-lg"
        >
          <span class="sr-only">{t('eventCard.locationLabel')}: </span>
          {location}
        </p>
      </div>
    )
  }

  {
    hasText && (
      <div
        data-event-copy
        class="font-poppins text-h5 text-neutral-100 dark:text-neutral-0 [&_p]:m-0"
      >
        <slot>{text}</slot>
      </div>
    )
  }
</div>
