---
import LabelWithTrailingIcon from '@/components/shared/LabelWithTrailingIcon.astro'
import { buildNavLinkUmamiAttrs, useTranslations } from '@/utils'

interface Props {
  href: string
  label: string
  theme?: 'light' | 'dark'
  openInNewTab?: boolean
}

const { href, label, theme = 'light', openInNewTab = false } = Astro.props

const isDark = theme === 'dark'
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const umamiAttrs = buildNavLinkUmamiAttrs(
  Astro.url.pathname,
  routeLocale,
  href,
  label
)

const itemTextClass = isDark ? 'text-neutral-25' : 'text-black'

const navLinkClass =
  'nav-link relative no-underline focus-visible:outline-none group/navlink'

const labelSpanClass =
  'relative inline-block after:absolute after:inset-x-0 after:-bottom-[4px] after:h-[2px] ' +
  'after:origin-left after:bg-current after:scale-x-0 after:transition-transform after:duration-200 after:ease-out after:content-[""] ' +
  'after:hidden desktop:after:block desktop:group-hover/navlink:after:scale-x-100 desktop:group-focus-visible/navlink:after:scale-x-100 ' +
  'desktop:group-data-[active=true]/navlink:after:scale-x-100 group-data-[active=true]/navlink:after:transition-none ' +
  'motion-reduce:after:transition-none'

const className = [
  navLinkClass,
  'text-base',
  itemTextClass,
  'block',
  'max-desktop:-mx-lg max-desktop:px-lg max-desktop:py-md',
  'px-0 desktop:py-md desktop:pe-md'
].join(' ')
---

<a
  href={href}
  class={className}
  data-component="NavMenuLink"
  {...umamiAttrs}
  {...openInNewTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class={labelSpanClass}>
    {
      openInNewTab ? (
        <LabelWithTrailingIcon label={label} icon="external-link" />
      ) : (
        label
      )
    }
  </span>
  {openInNewTab && <span class="sr-only">{t('aria.opens_new_tab')}</span>}
</a>
