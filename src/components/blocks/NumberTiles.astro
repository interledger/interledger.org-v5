---
// Row of stat tiles for foundation, summit, hackathon, and grant-overview
// dynamic zones. Reuses the homepage's StatCard/AnimatedNumber trio rather
// than duplicating the count-up + accessibility pattern. Strapi stores plain
// digits (e.g. "1000"); we format with commas for display while the animation
// still counts up to the parsed numeric value.
//
// Layout: CSS Grid instead of flexbox so the gap doesn't need subtracting out
// of each item's width — 2 tiles per row on mobile/tablet, up to 4 per row on
// desktop; a 5th+ tile wraps to a new row, left-aligned (grid auto-placement's
// default behavior, no extra CSS needed).
import StatCard from '@/components/shared/StatCard.astro'
import {
  buildNumberTileAriaLabel,
  formatStatNumber,
  parseStatNumber
} from '@/utils'

interface Tile {
  number: string
  /** Currency symbol or similar, rendered tight against the number (e.g. "$1,234M+"). */
  prefix?: string
  suffix?: string
  description: string
}

interface Props {
  title?: string
  tiles: Tile[]
}

const { tiles } = Astro.props
const title = Astro.props.title?.trim() || undefined
const titleId = title
  ? `number-tiles-heading-${crypto.randomUUID()}`
  : undefined

// Number tiles use the h2 heading scale (56px at desktop), smaller than
// StatsSection's homepage h1. Suffix steps down one type size and sits
// 8px off the number's bottom edge so "+" / "H" read as a raised label.
const NUMBER_CLASS =
  'font-poppins font-semibold text-h2 text-neutral-900 tablet:text-h2-md desktop:text-h2-lg dark:text-neutral-0'
const SUFFIX_CLASS =
  'self-end mb-sm text-h3 font-normal tablet:text-h3-md desktop:text-h3-lg'
const LABEL_CLASS = 'text-left text-neutral-75 dark:text-neutral-0'
---

<section
  data-component="NumberTiles"
  data-umami-component="number-tiles"
  aria-labelledby={titleId}
  class:list={[title && 'flex flex-col gap-block-heading']}
>
  {
    title && titleId && (
      <h2
        id={titleId}
        class="m-0 font-poppins text-h2 text-neutral-900 tablet:text-h2-md dark:text-neutral-0 desktop:text-h2-lg"
      >
        {title}
      </h2>
    )
  }
  <ul
    role="list"
    class="m-0 grid list-none grid-cols-2 gap-x-xl gap-y-xl p-0 desktop:grid-cols-4"
    data-animated-number-trigger
  >
    {
      tiles.map((tile) => {
        const parsed = parseStatNumber(tile.number)
        // Strapi stores plain digits (e.g. "1000"); format for display with
        // commas. Non-numeric free text falls back to the raw field value.
        const display = parsed !== null ? formatStatNumber(parsed) : tile.number
        // Expand freeform affixes (e.g. "$" + "M+") so screen readers don't
        // mangle them — undefined when no affixes so StatCard reads natively.
        const ariaLabel = buildNumberTileAriaLabel(
          display,
          tile.description,
          tile.prefix,
          tile.suffix
        )
        return (
          <StatCard
            value={parsed ?? 0}
            display={display}
            prefix={tile.prefix}
            suffix={tile.suffix}
            numberClass={NUMBER_CLASS}
            suffixClass={SUFFIX_CLASS}
            label={tile.description}
            labelClass={LABEL_CLASS}
            ariaLabel={ariaLabel}
            class="w-full items-start py-0 pl-0 desktop:p-0"
          />
        )
      })
    }
  </ul>
</section>
