---
/**
 * FAQ block — an optional intro above an accordion of question/answer pairs.
 *
 * Full width within the page's content column; the block adds no width
 * constraint of its own (INTORG-909).
 */
import {
  blockIntroA11y,
  parseMarkdown,
  resolveBlockIntro,
  useTranslations
} from '@/utils'
import BlockIntro from '@/components/shared/BlockIntro.astro'
import type { BlockIntroData } from '@/types/blockIntro'
import FaqItem from '@/components/shared/FaqItem.astro'
import { faqAccordionGroupName } from '@/scripts/faq-accordion'

interface StrapiFaqItem {
  question: string
  /** Markdown from the CKEditor `answer` field. */
  answer: string
}

interface Props {
  intro?: BlockIntroData | null
  /** @deprecated Legacy heading, rendered as the intro heading. */
  heading?: string
  items?: StrapiFaqItem[]
}

const { items } = Astro.props
const intro = resolveBlockIntro(Astro.props.intro, Astro.props.heading)
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const { headingId, ariaLabel } = blockIntroA11y(
  intro,
  'faq',
  t('faq.block_label')
)

// Unique so two Faq blocks on one page don't exclusive-close each other
// when JS is off. Locals lets MDX-slotted <FaqItem> children share this
// group instead of falling back to a document-wide `name="faq"`.
const faqGroup = faqAccordionGroupName()
Astro.locals.faqAccordionGroupName = faqGroup

// Strapi preview (DynamicZone.astro) passes `items` with markdown answers that
// still need rendering; MDX authoring passes <FaqItem> children that Astro has
// already rendered, so we fall through to the slot.
const renderedItems = items
  ? await Promise.all(
      items.map(async (item) => ({
        question: item.question,
        answerHtml: await parseMarkdown(item.answer, {
          pathname: Astro.url.pathname,
          lang: routeLocale
        })
      }))
    )
  : null
---

<section
  data-component="Faq"
  data-intro-variant="universal"
  aria-labelledby={headingId}
  aria-label={ariaLabel}
>
  <BlockIntro intro={intro} headingId={headingId} />
  <div class="flex w-full flex-col gap-xl" data-faq-accordion>
    {renderedItems ? (
      renderedItems.map((item) => <FaqItem
        question={item.question}
        group={faqGroup}
      >
        <Fragment set:html={item.answerHtml} />
      </FaqItem>)
    ) : (
      <slot />
    )}
  </div>
</section>

<script>
  import { initFaqAccordion } from '@/scripts/faq-accordion'

  initFaqAccordion()
</script>
