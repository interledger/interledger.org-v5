---
import { parseMarkdown, parseMarkdownInline, useTranslations } from '@/utils'

interface AgendaItem {
  time: string
  activity: string
  additionalInfo?: string
}

interface Props {
  heading?: string
  items: AgendaItem[]
  umamiContext?: string
}

const { heading, items, umamiContext }: Props = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const markdownContext = {
  page: umamiContext,
  pathname: Astro.url.pathname,
  lang: routeLocale
}
const renderedHeading = parseMarkdownInline(heading, markdownContext)
// Stable for this render; unique across multiple Agenda blocks on one page.
const headingId = renderedHeading
  ? `agenda-heading-${crypto.randomUUID()}`
  : undefined
const renderedItems = await Promise.all(
  items.map(async (item) => {
    const additionalInfo = await parseMarkdown(
      item.additionalInfo,
      markdownContext
    )
    return {
      time: parseMarkdownInline(item.time, markdownContext),
      activity: parseMarkdownInline(item.activity, markdownContext),
      additionalInfo,
      hasAdditionalInfo: additionalInfo.trim().length > 0
    }
  })
)
---

<section
  data-component="Agenda"
  data-umami-component="agenda"
  aria-labelledby={headingId}
  aria-label={headingId ? undefined : t('agenda.label')}
>
  {
    renderedHeading && headingId && (
      <h2
        id={headingId}
        class="mb-xl text-h4-lg text-neutral-900 dark:text-neutral-0 tablet:mb-2xl"
        set:html={renderedHeading}
      />
    )
  }

  <ol
    role="list"
    class="m-0 flex list-none flex-col gap-lg p-0 tablet:grid tablet:grid-cols-[minmax(0,300px)_minmax(0,1fr)] tablet:gap-x-0"
  >
    {
      renderedItems.map((item, index) => (
        <li class="relative tablet:col-span-2 tablet:grid tablet:grid-cols-subgrid">
          <div
            aria-hidden="true"
            class="absolute top-[calc(var(--spacing-lg)-1px)] tablet:top-[calc(var(--spacing-xl)-1px)] bottom-0 left-md z-10 flex w-2xl justify-center"
          >
            <svg
              class="relative z-10 size-xl shrink-0 rounded-full text-neutral-75 dark:text-neutral-0"
              viewBox="0 0 24 24"
              fill="none"
            >
              <path
                d="M14.935 16.223L11.5 12.789V7.923H12.5V12.387L15.623 15.51L14.935 16.223ZM11.5 6V4H12.5V6H11.5ZM18 12.5V11.5H20V12.5H18ZM11.5 20V18H12.5V20H11.5ZM4 12.5V11.5H6V12.5H4ZM12.003 21C10.7583 21 9.58833 20.764 8.493 20.292C7.39767 19.8193 6.44467 19.178 5.634 18.368C4.82333 17.558 4.18167 16.606 3.709 15.512C3.23633 14.418 3 13.2483 3 12.003C3 10.7577 3.23633 9.58767 3.709 8.493C4.181 7.39767 4.82133 6.44467 5.63 5.634C6.43867 4.82333 7.391 4.18167 8.487 3.709C9.583 3.23633 10.753 3 11.997 3C13.241 3 14.411 3.23633 15.507 3.709C16.6023 4.181 17.5553 4.82167 18.366 5.631C19.1767 6.44033 19.8183 7.39267 20.291 8.488C20.7637 9.58333 21 10.753 21 11.997C21 13.241 20.764 14.411 20.292 15.507C19.82 16.603 19.1787 17.556 18.368 18.366C17.5573 19.176 16.6053 19.8177 15.512 20.291C14.4187 20.7643 13.249 21.0007 12.003 21ZM12 20C14.2333 20 16.125 19.225 17.675 17.675C19.225 16.125 20 14.2333 20 12C20 9.76667 19.225 7.875 17.675 6.325C16.125 4.775 14.2333 4 12 4C9.76667 4 7.875 4.775 6.325 6.325C4.775 7.875 4 9.76667 4 12C4 14.2333 4.775 16.125 6.325 17.675C7.875 19.225 9.76667 20 12 20Z"
                fill="currentColor"
              />
            </svg>
            {index < renderedItems.length - 1 && (
              <span class="absolute top-xl left-1/2 w-px -translate-x-1/2 bg-neutral-75 dark:bg-neutral-25 bottom-[calc(-1*(var(--spacing-lg)+var(--spacing-lg)+0.5rem+3px))] tablet:bottom-[calc(-1*(var(--spacing-lg)+var(--spacing-xl)+0.5rem+3px))]" />
            )}
          </div>

          <dl
            class:list={[
              'm-0 min-w-0 rounded-2xl py-lg pr-2xl pl-3xl text-neutral-100 dark:text-neutral-0 tablet:col-span-2 tablet:grid tablet:grid-cols-subgrid tablet:items-stretch tablet:rounded-lg dark:tablet:rounded-2xl tablet:py-xl tablet:pr-3xl',
              index % 2 === 0
                ? 'bg-ice-indigo-50 dark:bg-ocean-100'
                : 'bg-rose-mint-100 dark:bg-royal-purple-100'
            ]}
          >
            <div
              class:list={[
                'min-w-0',
                item.hasAdditionalInfo
                  ? 'max-w-[300px] tablet:pr-xl'
                  : 'tablet:col-span-2'
              ]}
            >
              <dt class="sr-only">{t('agenda.timeLabel')}</dt>
              <dd
                class="m-0 text-body-lg-emphasis tablet:text-body-lg-emphasis-md [&_p]:m-0"
                set:html={item.time}
              />
              <dt class="sr-only">{t('agenda.activityLabel')}</dt>
              <dd
                class="mt-md mb-0 text-h5 text-primary dark:text-lavender-100 tablet:mt-sm tablet:text-h5-md desktop:text-h5-lg [&_p]:m-0"
                set:html={item.activity}
              />
            </div>

            {item.hasAdditionalInfo && (
              <div class="mt-md min-w-0 pl-md tablet:mt-0 tablet:border-l tablet:border-neutral-50 dark:tablet:border-neutral-75 tablet:pl-2xl flex flex-col justify-center">
                <dt class="sr-only">{t('agenda.additionalInfoLabel')}</dt>
                <dd
                  data-agenda-info
                  class="m-0 text-body-lg-standard tablet:text-body-lg-standard-md [&_ul]:mb-0 [&_ol]:mb-0 [&_a]:text-inherit [&_blockquote]:text-inherit [&_ol]:text-inherit [&_p]:text-inherit [&_ul]:text-inherit"
                  set:html={item.additionalInfo}
                />
              </div>
            )}
          </dl>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /*
   * End spacing is 6xl after a day (or the last day in a run).
   * Consecutive days: previous mb-6xl + this negative pull = 3xl gap.
   * Uses adjacent sibling only (no :has) so MDX sibling days always match.
   */
  :global([data-component='Agenda']) {
    margin-block-end: var(--spacing-6xl);
  }

  :global([data-component='Agenda'] + [data-component='Agenda']) {
    margin-block-start: calc(var(--spacing-3xl) - var(--spacing-6xl));
  }

  /* Prefer real markdown lists for bullets (a11y); plain paragraphs stay paragraphs. */
  [data-agenda-info] :global(p) {
    margin: 0 0 var(--spacing-sm);
    font-size: inherit;
  }

  [data-agenda-info] :global(p:last-child) {
    margin-block-end: 0;
  }

  [data-agenda-info] :global(ul),
  [data-agenda-info] :global(ol) {
    margin: 0;
    padding-inline-start: var(--spacing-xs);
    font-size: inherit;
    list-style-position: outside;
  }

  @media (min-width: 810px) {
    [data-agenda-info] :global(ul),
    [data-agenda-info] :global(ol) {
      padding-inline-start: var(--spacing-sm);
    }
  }

  [data-agenda-info] :global(ul) {
    list-style-type: disc;
  }

  [data-agenda-info] :global(ol) {
    list-style-type: decimal;
  }

  [data-agenda-info] :global(li) {
    margin-block-end: var(--spacing-sm);
  }

  [data-agenda-info] :global(li:last-of-type) {
    margin-block-end: 0;
  }

  /* Beat page-prose ul/li spacing. After the list matches the gap between lines. */
  :global([data-prose] [data-component='Agenda'] [data-agenda-info] ul),
  :global([data-prose] [data-component='Agenda'] [data-agenda-info] ol) {
    margin-block-end: 0;
    padding-block-end: 0;
    padding-inline-start: var(--spacing-xs);
  }

  @media (min-width: 810px) {
    :global([data-prose] [data-component='Agenda'] [data-agenda-info] ul),
    :global([data-prose] [data-component='Agenda'] [data-agenda-info] ol) {
      padding-inline-start: var(--spacing-sm);
    }
  }

  :global([data-prose] [data-component='Agenda'] [data-agenda-info] li) {
    margin-block-end: var(--spacing-sm);
  }

  :global(
    [data-prose] [data-component='Agenda'] [data-agenda-info] li:last-of-type
  ) {
    margin-block-end: 0;
  }
</style>
