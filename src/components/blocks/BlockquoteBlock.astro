---
/**
 * Blockquote block: the shared Blockquote inside the block frame (ADR-009).
 * The Strapi preview passes `quote`; MDX passes the quote as children, which
 * reach Blockquote.astro through the slot. Blockquote.astro parses `source`.
 */

import Blockquote from '@/components/shared/Blockquote.astro'
import IntroBlockFrame from '@/components/shared/IntroBlockFrame.astro'
import type { BlockIntroData } from '@/types/blockIntro'

interface Props {
  intro?: BlockIntroData | null
  quote?: string
  source?: string
}

const { intro, quote, source } = Astro.props
---

<IntroBlockFrame component="Blockquote" intro={intro}>
  <Blockquote quote={quote} source={source}><slot /></Blockquote>
</IntroBlockFrame>
