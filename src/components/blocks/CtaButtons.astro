---
/**
 * CTA Buttons block — one call-to-action button, or two side by side.
 *
 * Composition rules (Sarah, INTORG-938, 2026-07-29) are enforced on both write
 * paths, the MDX parser and the admin validator, so by the time a payload
 * reaches here it is already known good. This component renders what it is
 * given rather than re-deriving the rules.
 *
 * Layout: stacked and full width below `tablet`, inline above it.
 *
 * Spacing (Radu, 2026-08-12): a CTA belongs to the paragraph above it, so the
 * gap above is tight, 24px up to `desktop` and 32px from there. The block that
 * follows is independent and takes the standard 120px.
 *
 * The block sits in the prose flow, where a paragraph carries a 32px bottom
 * margin. Adjacent margins collapse to the larger of the pair, so that 32px
 * would win over the 24px above and the tablet and mobile gap would read
 * 32px. Desktop would look right either way, because 32px is also the value it
 * wants. `prose/default.css` zeroes that paragraph by matching the
 * `data-component` attribute below, so treat the attribute as load-bearing,
 * not only a test hook.
 */
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import { buildUmamiAttrs, resolveCtaLink, type UmamiLabel } from '@/utils'

interface CtaButtonProp {
  text: string
  link: string
  style?: 'primary' | 'secondary'
  external?: boolean
  document?: boolean
}

interface Props {
  buttons?: CtaButtonProp[]
  /** Template surfaces (event card, hackathon hero) can drop the trailing icon. */
  hideIcons?: boolean
  umamiLabel?: UmamiLabel
  umamiBaseComponent?: string
}

const {
  buttons = [],
  hideIcons = false,
  umamiLabel,
  umamiBaseComponent
} = Astro.props
const { routeLocale, site } = Astro.locals

// A hackathon primary carries no arrow (INTORG-1072). Read from `Astro.locals`,
// the same value `BaseLayout` writes to `data-site` for the button tokens, so the
// arrow and the fill cannot disagree (Jonathan, #520).
const isHackathon = site === 'hackathon'

// Strapi drafts can be saved mid-edit, so a button may arrive without its text
// or link. Skip those rather than rendering an empty or dead button.
const resolved = buttons
  .filter((button) => button?.text?.trim() && button?.link?.trim())
  .map((button) => {
    const variant =
      button.style === 'secondary'
        ? ('secondary' as const)
        : ('primary' as const)

    return {
      text: button.text.trim(),
      variant,
      ...resolveCtaLink({
        url: button.link.trim(),
        external: button.external,
        document: button.document,
        // Only the internal case depends on the style: primary keeps the
        // arrow, secondary shows nothing, matching a secondary in a CTA strip
        // or a split layout. Documents and external links keep their own icon
        // on both styles.
        //
        // Scoped to components an editor picks. Template pages and the home
        // page follow their own Figma spec, so this must not become the shared
        // default (INTORG-1086).
        internalIcon:
          variant === 'primary' && !isHackathon ? 'arrow-right' : null
      })
    }
  })
---

{
  resolved.length > 0 && (
    <div
      data-component="CtaButtons"
      class="mt-xl mb-section [&:last-child]:mb-0 desktop:mt-2xl flex w-full flex-col items-stretch gap-sm tablet:w-auto tablet:flex-row tablet:items-start"
    >
      {/*
        `iconSide` is explicit because LinkButton otherwise infers it from
        `Astro.slots.has('icon-right')`, which reports true even when the slot
        holds a falsy conditional and renders nothing. An icon-less button then
        keeps the with-icon padding and its label sits 8px off centre.
      */}
      {resolved.map((button) => (
        <LinkButton
          href={button.href}
          variant={button.variant}
          mode="auto"
          external={button.external}
          document={button.document}
          iconSide={button.icon ? 'right' : 'none'}
          class="w-full tablet:w-auto"
          {...buildUmamiAttrs({
            pathname: Astro.url.pathname,
            lang: routeLocale,
            label: umamiLabel ?? 'button_cta',
            baseComponent:
              umamiBaseComponent ??
              (button.variant === 'secondary'
                ? 'secondary_cta'
                : 'primary_cta'),
            href: button.href,
            linkText: button.text
          })}
        >
          {button.text}
          {!hideIcons && button.icon && (
            <Icon name={button.icon} slot="icon-right" />
          )}
        </LinkButton>
      ))}
    </div>
  )
}
