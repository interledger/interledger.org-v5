---
/**
 * Report Section block — a heading followed by a repeatable list of typed
 * content blocks (Paragraph or Disclaimer), authored via MDX only.
 *
 * The heading is a real markdown `##` inside the slot, not a prop — so
 * Astro's heading collector can pick it up for ReportSectionsNav, and so
 * the client script below (see its own comment) has to move the rendered
 * <h2> into a <summary> at runtime to build the mobile accordion.
 */
import Icon from '@/components/shared/Icon.astro'
---

<section
  data-component="report-section"
  class="flex flex-col gap-xl [&_h2]:m-0 [&_h2]:min-w-0 [&_h2]:text-neutral-100 [&_h2]:text-h3 [&_h2]:scroll-mt-(--site-header-height-desktop) tablet:[&_h2]:text-neutral-900 tablet:[&_h2]:text-h3-md desktop:[&_h2]:text-h3-lg"
>
  <span data-report-section-icon class="hidden">
    <Icon
      name="arrow-down"
      class="size-8 shrink-0 text-primary transition-transform duration-200 group-open/section:rotate-180 tablet:hidden"
    />
  </span>
  <slot />
</section>

<script>
  // Mobile: each section becomes its own accordion (first open, rest
  // closed) by moving its rendered <h2>/icon into a <summary> at runtime —
  // the heading is opaque slot markup here, not a prop we can place directly.
  // Tablet+: flat, no <details>/<summary> at all — <summary> keeps native
  // disclosure semantics and keyboard focus no matter what ARIA/CSS is
  // applied to it, so it's torn back down instead of just forced open.
  // 810px matches the `tablet:` breakpoint
  document
    .querySelectorAll<HTMLElement>('[data-component="report-section"]')
    .forEach((section, index) => {
      const tabletQuery = window.matchMedia('(min-width: 810px)')
      let details: HTMLDetailsElement | null = null
      let summary: HTMLElement | null = null
      let body: HTMLElement | null = null

      const buildDisclosure = () => {
        const heading = section.querySelector('h2')
        if (!heading) return null

        const newDetails = document.createElement('details')
        newDetails.className = 'group/section flex flex-col'

        const newSummary = document.createElement('summary')
        newSummary.className = `flex list-none items-center justify-between gap-lg
        px-lg py-md bg-neutral-25
        rounded-lg border-b border-transparent
        cursor-pointer [&::-webkit-details-marker]:hidden
        group-open/section:[&_h2]:text-primary group-open/section:mb-2xl
        [&_h2]:transition-all [&_h2]:duration-200 transition-all duration-200
        group-open/section:rounded-b-none group-open/section:border-primary`

        const newBody = document.createElement('div')
        newBody.className = 'flex flex-col gap-xl'

        newSummary.append(heading)
        const icon = section.querySelector('[data-report-section-icon]')
        if (icon) {
          icon.classList.remove('hidden')
          newSummary.append(icon)
        }
        while (section.firstChild) newBody.append(section.firstChild)

        newDetails.append(newSummary, newBody)
        section.append(newDetails)

        summary = newSummary
        body = newBody
        return newDetails
      }

      // Reverses buildDisclosure: moves the icon/heading/body content back
      // to being direct children of `section`, in their original order.
      const teardownDisclosure = () => {
        if (!details || !summary || !body) return

        const icon = summary.querySelector('[data-report-section-icon]')
        if (icon) {
          icon.classList.add('hidden')
          section.append(icon)
        }
        const heading = summary.querySelector('h2')
        if (heading) section.append(heading)
        while (body.firstChild) section.append(body.firstChild)

        details.remove()
        details = null
        summary = null
        body = null
      }

      const applyMode = (isTablet: boolean) => {
        if (isTablet) {
          teardownDisclosure()
          return
        }
        details ??= buildDisclosure()
        if (details) details.open = index === 0
      }

      applyMode(tabletQuery.matches)
      tabletQuery.addEventListener('change', (event) =>
        applyMode(event.matches)
      )
    })
</script>
