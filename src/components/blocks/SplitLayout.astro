---
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import VideoEmbed from '@/components/shared/VideoEmbed.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import Blockquote from '@/components/shared/Blockquote.astro'
import { resolveCtaLink } from '@/utils'

/** Content-to-media column ratio (admin labels). Astro maps these to grid `fr` tracks. */
export type SplitLayoutDisplayRatio = '1:1' | '1:2' | '2:1'

interface Props {
  layoutType?: 'image-text' | 'image-quote' | 'video-text' | 'video-quote'
  /** Which side the image or video column appears on. Default: right. */
  imagePosition?: 'left' | 'right'
  /**
   * Content : media width ratio. Default: 2:1 (matches the pre-ratio layout:
   * media roughly capped near 22rem with content taking the rest).
   * Uses CSS grid `fr` units with the design-system 120px (`gap-6xl`) gutter.
   */
  displayRatio?: SplitLayoutDisplayRatio
  imageSrc?: string
  /** Sourced from the SplitLayout block’s per-locale media component (`shared.localized-media.alternativeText`) */
  imageAlt?: string
  videoUrl?: string
  quote?: string
  quoteSource?: string
  ctaText?: string
  ctaLink?: string
  ctaStyle?: string
  ctaExternal?: boolean
  ctaDocument?: boolean
}

const DISPLAY_RATIOS = ['1:1', '1:2', '2:1'] as const

/** Full class strings so Tailwind can detect them at build time. */
const GRID_COLS_BY_ORDER_AND_RATIO = {
  // media column first in the DOM (imagePosition=left)
  left: {
    '1:1': 'tablet:grid-cols-2',
    // content:media 2:1 → media 1fr, content 2fr
    '2:1': 'tablet:grid-cols-[1fr_2fr]',
    // content:media 1:2 → media 2fr, content 1fr
    '1:2': 'tablet:grid-cols-[2fr_1fr]'
  },
  // content column first in the DOM (imagePosition=right)
  right: {
    '1:1': 'tablet:grid-cols-2',
    '2:1': 'tablet:grid-cols-[2fr_1fr]',
    '1:2': 'tablet:grid-cols-[1fr_2fr]'
  }
} as const satisfies Record<
  'left' | 'right',
  Record<SplitLayoutDisplayRatio, string>
>

const {
  layoutType,
  imagePosition = 'right',
  displayRatio: displayRatioProp,
  imageSrc,
  imageAlt,
  videoUrl,
  quote,
  quoteSource,
  ctaText,
  ctaLink,
  ctaStyle,
  ctaExternal,
  ctaDocument
} = Astro.props

// Icon by link kind (INTORG-938). Before this the block showed `arrow-right`
// when the link was external, which is the rule inverted. An internal link
// still shows nothing: the arrow-on-internal rule covers components an editor
// picks, and this CTA belongs to a page template (Sarah, INTORG-907, 2026-08-09).
const resolvedCta = ctaLink
  ? resolveCtaLink({
      url: ctaLink,
      external: ctaExternal,
      document: ctaDocument
    })
  : null

// Unknown ratios fall back to 2:1 here; sync handler/serializer hard-fail instead.
const displayRatio: SplitLayoutDisplayRatio =
  displayRatioProp &&
  (DISPLAY_RATIOS as readonly string[]).includes(displayRatioProp)
    ? displayRatioProp
    : '2:1'

const isVideoLayout = layoutType
  ? layoutType.startsWith('video')
  : Boolean(videoUrl)
const isQuoteLayout = layoutType
  ? layoutType.endsWith('-quote')
  : Boolean(quote)
const hasMedia = isVideoLayout ? Boolean(videoUrl) : Boolean(imageSrc)
const mediaFirst = imagePosition === 'left'

const gridColsClass = hasMedia
  ? GRID_COLS_BY_ORDER_AND_RATIO[mediaFirst ? 'left' : 'right'][displayRatio]
  : 'tablet:grid-cols-1'

const columnClass = 'w-full min-w-0'
const contentColumnClass = `${columnClass} flex flex-col gap-2xl`
---

<div
  data-component="SplitLayout"
  class:list={[
    'mt-xl mb-5xl flex flex-col gap-3xl tablet:my-5xl tablet:grid tablet:items-center tablet:gap-6xl desktop:my-6xl',
    gridColsClass
  ]}
>
  {
    mediaFirst && hasMedia && (
      <div class={columnClass}>
        {isVideoLayout && videoUrl ? (
          <VideoEmbed url={videoUrl} title="Video" />
        ) : imageSrc ? (
          <OptimizedImage
            src={imageSrc}
            alt={imageAlt ?? ''}
            width={640}
            height={480}
            loading="lazy"
            class="w-full h-auto rounded-lg object-cover"
          />
        ) : null}
      </div>
    )
  }

  <div class={contentColumnClass}>
    {
      isQuoteLayout && quote ? (
        <Blockquote quote={quote} source={quoteSource} />
      ) : (
        <>
          <div class="[&>*:last-child]:mb-0">
            <slot />
          </div>
          {ctaText && resolvedCta && (
            <div>
              {/*
                `mode="auto"` because this block renders on foundation (light)
                as well as on the two permanently dark microsites. Without it
                the secondary falls back to `light`, whose `text-neutral-100`
                label measures 1.10:1 on the hackathon's `neutral-150` page and
                is effectively invisible (INTORG-1072).

                `iconSide` is explicit because LinkButton otherwise infers it
                from `Astro.slots.has('icon-right')`, which reports true even
                when the slot holds a falsy conditional and renders nothing.
                An icon-less button then keeps the with-icon padding and its
                label sits 8px off centre.
              */}
              <LinkButton
                href={resolvedCta.href}
                variant={ctaStyle === 'secondary' ? 'secondary' : 'primary'}
                mode="auto"
                external={resolvedCta.external}
                document={resolvedCta.document}
                iconSide={resolvedCta.icon ? 'right' : 'none'}
              >
                {ctaText}
                {resolvedCta.icon && (
                  <Icon name={resolvedCta.icon} slot="icon-right" />
                )}
              </LinkButton>
            </div>
          )}
        </>
      )
    }
  </div>

  {
    !mediaFirst && hasMedia && (
      <div class={columnClass}>
        {isVideoLayout && videoUrl ? (
          <VideoEmbed url={videoUrl} title="Video" />
        ) : imageSrc ? (
          <OptimizedImage
            src={imageSrc}
            alt={imageAlt ?? ''}
            width={640}
            height={480}
            loading="lazy"
            class="w-full h-auto rounded-lg object-cover"
          />
        ) : null}
      </div>
    )
  }
</div>
