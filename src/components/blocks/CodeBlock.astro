---
import { bundledThemes, codeToHtml } from 'shiki'
import {
  tryCatchAsync,
  useTranslations,
  buildUmamiAttrs,
  buildCodeTheme,
  LIGHT_CODE_PALETTE,
  DARK_CODE_PALETTE
} from '@/utils'

const FALLBACK_LANGUAGE = 'text'

interface Props {
  code: string
  language: string
  title?: string
}

// Last-resort render when Shiki fails entirely: escape the source and keep the
// same `.line` structure so line numbers and blank-line handling still apply.
function renderPlainCode(source: string): string {
  const escaped = source
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
  const lines = escaped
    .split('\n')
    .map((line) => `<span class="line">${line}</span>`)
    .join('\n')
  return `<pre class="shiki"><code>${lines}</code></pre>`
}

const [lightBase, darkBase] = await Promise.all([
  bundledThemes['github-light'](),
  bundledThemes['github-dark']()
])
// Light is inlined; dark ships as --shiki-dark* custom properties that the
// styles below switch on under [data-theme='dark'] (summit, hackathon).
const codeThemes = {
  light: buildCodeTheme(
    lightBase.default,
    'interledger-code-light',
    LIGHT_CODE_PALETTE
  ),
  dark: buildCodeTheme(
    darkBase.default,
    'interledger-code-dark',
    DARK_CODE_PALETTE
  )
}
const highlightOptions = { themes: codeThemes, defaultColor: 'light' } as const

const { code, language, title } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const copyLabel = t('codeBlock.copy')
const copyButtonUmamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'toggle',
  baseComponent: 'code_block',
  ariaLabel: copyLabel
})

// Raw markdown fences can carry a language Shiki doesn't bundle. Fall back to
// plain text, and if even that fails, render the escaped source, so an unknown
// (or broken) language degrades gracefully instead of failing the build.
const primary = await tryCatchAsync(() =>
  codeToHtml(code, { lang: language, ...highlightOptions })
)
const fallback =
  primary instanceof Error
    ? await tryCatchAsync(() =>
        codeToHtml(code, { lang: FALLBACK_LANGUAGE, ...highlightOptions })
      )
    : primary
const highlighted = fallback instanceof Error ? renderPlainCode(code) : fallback
---

<figure
  class="my-2xl w-full min-w-0 rounded-xl border border-neutral-25 dark:border-neutral-75 text-body-sm-standard tablet:text-h5-md desktop:text-h5-lg"
  data-component="code-block"
>
  <div class="code-block-header flex items-center rounded-t-xl">
    <div class="flex items-center gap-[6px] shrink-0" aria-hidden="true">
      <span class="block h-3 w-3 rounded-full bg-[#ff5f57]"></span>
      <span class="block h-3 w-3 rounded-full bg-[#febc2e]"></span>
      <span class="block h-3 w-3 rounded-full bg-[#28c840]"></span>
    </div>

    <span class="code-block-title flex-1 min-w-0 truncate">
      {title ?? language}
    </span>

    <button
      type="button"
      class="copy-btn code-block-copy-btn shrink-0 inline-flex items-center cursor-pointer
             transition-colors focus-visible:outline focus-visible:outline-2
             focus-visible:outline-offset-2 focus-visible:outline-neutral-900/40
             dark:focus-visible:outline-neutral-0/60"
      data-code={code}
      data-copy-label={copyLabel}
      data-copied-label={t('codeBlock.copied')}
      {...copyButtonUmamiAttrs}
      aria-label={copyLabel}
    >
      <span data-copy-label-text>{copyLabel}</span>
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="h-3.5 w-3.5 shrink-0"
        fill="none"
      >
        <rect
          x="5.5"
          y="1.5"
          width="9"
          height="11"
          rx="1.5"
          stroke="currentColor"
          stroke-width="1.25"></rect>
        <path
          d="M3.5 4.5H2a1 1 0 0 0-1 1V14a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1.5"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div
    class="code-block-scroll rounded-b-xl"
    data-lenis-prevent-touch
    set:html={highlighted}
  />
</figure>

<style>
  /* Shiki: block .line + newline nodes between spans; contain:inline-size for mobile scroll. */
  [data-component='code-block'] {
    --code-block-header-bg: var(--color-ice-indigo-50);
    --code-block-divider: var(--color-neutral-25);
    --code-block-label: var(--color-neutral-900);
    --code-block-copy: color-mix(
      in srgb,
      var(--color-neutral-900) 40%,
      transparent
    );
    --code-block-text: var(--color-neutral-900);
    --code-block-line-number: var(--color-neutral-50);
    contain: inline-size;
  }

  :global([data-theme='dark']) [data-component='code-block'] {
    --code-block-header-bg: var(--color-neutral-100);
    --code-block-divider: var(--color-neutral-75);
    --code-block-label: var(--color-neutral-0);
    --code-block-copy: color-mix(
      in srgb,
      var(--color-neutral-0) 60%,
      transparent
    );
    --code-block-text: var(--color-neutral-25);
    --code-block-line-number: var(--color-neutral-75);
  }

  /* Shiki inlines the light colours; the dark ones ride on --shiki-dark*
     custom properties, and !important is the documented way past the
     inline style. Plain-text fallback output carries neither. */
  :global([data-theme='dark'])
    [data-component='code-block']
    .code-block-scroll
    :global(.shiki) {
    background-color: var(--shiki-dark-bg, var(--color-neutral-150)) !important;
  }

  :global([data-theme='dark'])
    [data-component='code-block']
    .code-block-scroll
    :global(.shiki),
  :global([data-theme='dark'])
    [data-component='code-block']
    .code-block-scroll
    :global(.shiki span) {
    color: var(--shiki-dark, var(--code-block-text)) !important;
  }

  [data-component='code-block'] .code-block-header {
    gap: var(--spacing-lg);
    padding-block: var(--spacing-s);
    padding-inline: var(--spacing-xl);
    background-color: var(--code-block-header-bg);
    border-bottom: 1px solid var(--code-block-divider);
  }

  [data-component='code-block'] .code-block-title,
  [data-component='code-block'] .code-block-copy-btn {
    font-size: var(--text-caption);
  }

  [data-component='code-block'] .code-block-title {
    color: var(--code-block-label);
  }

  [data-component='code-block'] .code-block-copy-btn {
    gap: 5px;
    color: var(--code-block-copy);
  }

  [data-component='code-block'] .code-block-copy-btn:hover {
    color: var(--code-block-label);
  }

  [data-component='code-block'] .code-block-scroll {
    display: block;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    line-height: 1.5;
  }

  [data-component='code-block'] .code-block-scroll :global(pre) {
    display: block;
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: var(--spacing-xl);
    color: var(--code-block-text);
    white-space: normal;
  }

  [data-component='code-block'] .code-block-scroll :global(code) {
    display: block;
    width: max-content;
    min-width: 100%;
    counter-reset: code-line;
    font-family: ui-monospace, monospace;
    font-size: 0.8125rem;
    line-height: inherit;
  }

  [data-component='code-block'] .code-block-scroll :global(.line) {
    display: block;
    width: max-content;
    min-width: 100%;
    white-space: pre;
    counter-increment: code-line;
  }

  [data-component='code-block'] .code-block-scroll :global(.line::before) {
    content: counter(code-line);
    display: inline-block;
    width: 1.75em;
    margin-right: var(--spacing-lg);
    text-align: right;
    color: var(--code-block-line-number);
    user-select: none;
  }

  /* Empty .line spans (blank lines) have no content, so browsers give them
     zero height; a zero-width space forces a line box so the blank line renders. */
  [data-component='code-block'] .code-block-scroll :global(.line:empty::after) {
    content: '\200b';
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element)?.closest<HTMLButtonElement>(
      '[data-component="code-block"] .copy-btn'
    )
    if (!btn) return

    const code = btn.dataset.code ?? ''
    const copyLabel = btn.dataset.copyLabel ?? 'Copy'
    const copiedLabel = btn.dataset.copiedLabel ?? 'Copied!'
    const label = btn.querySelector('[data-copy-label-text]')
    if (!label) return

    navigator.clipboard.writeText(code).then(() => {
      label.textContent = copiedLabel
      btn.setAttribute('aria-label', copiedLabel)
      setTimeout(() => {
        label.textContent = copyLabel
        btn.setAttribute('aria-label', copyLabel)
      }, 2000)
    })
  })
</script>
