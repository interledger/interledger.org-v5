---
/**
 * A standalone call-to-action link, authored in the body of a page.
 *
 * The icon follows the link kind: a document downloads, an external link
 * opens a new tab, and anything else is internal. Before INTORG-938 this
 * component showed `arrow-right` when the link was external, which is the
 * opposite of the rule, and it had no download case at all.
 *
 * Internal links get the arrow here. That is Sarah's rule for components an
 * editor picks, as opposed to a CTA baked into a page template, which keeps
 * whatever its own design says (INTORG-938, 2026-08-10).
 */
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import { resolveCtaLink } from '@/utils'

interface Props {
  text: string
  link: string
  style?: 'primary' | 'secondary'
  external?: boolean
  document?: boolean
}

const {
  text,
  link,
  style = 'primary',
  external = false,
  document: isDocument = false
} = Astro.props

const resolved = resolveCtaLink({
  url: link,
  external,
  document: isDocument,
  internalIcon: 'arrow-right'
})
---

<LinkButton
  href={resolved.href}
  variant={style}
  external={resolved.external}
  document={resolved.document}
>
  {text}
  <Icon name={resolved.icon} slot="icon-right" />
</LinkButton>
