---
/**
 * A standalone call-to-action link, authored in the body of a page.
 *
 * The icon follows the link kind: a document downloads, an external link opens
 * a new tab, and anything else is internal. An internal link shows the arrow on
 * the primary style only, matching a secondary in a CTA strip or a split
 * layout. `CtaButtons` follows the same rule, so keep the two in step.
 *
 * The internal arrow stays scoped to components an editor picks. A CTA baked
 * into a page template keeps whatever its own design says (Sarah, INTORG-907,
 * 2026-08-09).
 */
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import { resolveCtaLink } from '@/utils'

interface Props {
  text: string
  link: string
  style?: 'primary' | 'secondary'
  external?: boolean
  document?: boolean
}

const {
  text,
  link,
  style = 'primary',
  external = false,
  document: isDocument = false
} = Astro.props

// Spacing (Radu, 2026-08-12): a CTA belongs to the paragraph above it, so that
// gap is tight (24px, 32px from desktop) and the gap below is the full block
// gap of 120px. `Paragraph` tightens its own bottom margin when it sees
// `.cta-link` next to it, and the 120px below comes from here. Before this the
// CTA had no margin at all, so the following heading sat flush against it
// (INTORG-1045).
//
// `cta-link` is the hook `Paragraph` matches on. Keep the two in step.
const spacingClass = 'cta-link mb-6xl'

const resolved = resolveCtaLink({
  url: link,
  external,
  document: isDocument,
  internalIcon: style === 'primary' ? 'arrow-right' : null
})
---

<LinkButton
  href={resolved.href}
  variant={style}
  external={resolved.external}
  document={resolved.document}
  class={spacingClass}
  linkText={text}
  umamiLabel="button_cta"
  umamiBaseComponent={style === 'secondary' ? 'secondary_cta' : 'primary_cta'}
>
  {text}
  {resolved.icon && <Icon name={resolved.icon} slot="icon-right" />}
</LinkButton>
