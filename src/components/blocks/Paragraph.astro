---
import type { BlockIntroVariant } from '@/types/blockIntro'
import { parseMarkdown } from '@/utils'

interface Props {
  content?: string
  alignment?: 'left' | 'center' | 'right'
  umamiContext?: string
  /**
   * Keep the prose rhythm instead of the Paragraph block spacing (ADR-009,
   * D3). Profile pages only, until their narrow-page spacing is designed.
   */
  legacySpacing?: boolean
}

const {
  content,
  alignment = 'left',
  umamiContext,
  legacySpacing = false
} = Astro.props
const { routeLocale } = Astro.locals

const alignmentClass =
  alignment === 'center'
    ? 'text-center'
    : alignment === 'right'
      ? 'text-right'
      : undefined

// The block owns its spacing (components/prose/paragraph-block.css), the CTA
// that follows it included.
const introVariant: BlockIntroVariant | undefined = legacySpacing
  ? undefined
  : 'paragraph'

const hasContent = content != null && content !== ''
const htmlContent = hasContent
  ? await parseMarkdown(content, {
      page: umamiContext,
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  : null
---

{hasContent ? (
  <div
    data-component="Paragraph"
    data-intro-variant={introVariant}
    class={alignmentClass}
    set:html={htmlContent}
  />
) : (
  <div
    data-component="Paragraph"
    data-intro-variant={introVariant}
    class={alignmentClass}
  >
    <slot />
  </div>
)}
