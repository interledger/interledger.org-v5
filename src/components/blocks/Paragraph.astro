---
import { parseMarkdown } from '@/utils'

interface Props {
  content?: string
  alignment?: 'left' | 'center' | 'right'
  umamiContext?: string
}

const { content, alignment = 'left', umamiContext } = Astro.props
const { routeLocale } = Astro.locals

const alignmentClass =
  alignment === 'center'
    ? 'text-center'
    : alignment === 'right'
      ? 'text-right'
      : undefined

const hasContent = content != null && content !== ''
const htmlContent = hasContent
  ? await parseMarkdown(content, {
      page: umamiContext,
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  : null
---

{/* The block owns its spacing (components/prose/paragraph-block.css), the
  CTA that follows it included, on every template (ADR-009, D3). */}
{hasContent ? (
  <div
    data-component="Paragraph"
    data-intro-variant="paragraph"
    class={alignmentClass}
    set:html={htmlContent}
  />
) : (
  <div
    data-component="Paragraph"
    data-intro-variant="paragraph"
    class={alignmentClass}
  >
    <slot />
  </div>
)}
