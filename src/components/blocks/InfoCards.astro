---
/**
 * Grant-page info cards section (`blocks.info-cards` / grant frontmatter
 * `infoCards`) — fixed three-card row. The optional section heading is its
 * intro heading (ADR-009), the field's only intro content.
 *
 * Not the removed `blocks.info-card-grid` dynamic-zone block. DZ / MDX grids
 * use `CardGrid` with `variant="Info"` instead.
 */
import { blockIntroA11y, resolveBlockIntro, parseMarkdown } from '@/utils'
import BlockIntro from '@/components/shared/BlockIntro.astro'
import InfoCard from '@/components/shared/InfoCard.astro'

interface InfoCardData {
  heading: string
  body: string
}

interface Props {
  heading?: string
  cards: [InfoCardData, InfoCardData, InfoCardData]
  umamiContext?: string
}

const { heading, cards, umamiContext } = Astro.props
const { routeLocale } = Astro.locals

const intro = resolveBlockIntro(null, heading)
const { headingId } = blockIntroA11y(intro, 'info-cards')

const htmlCards = await Promise.all(
  cards.map(async (card) => ({
    heading: card.heading,
    html: await parseMarkdown(card.body, {
      page: umamiContext,
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  }))
)
---

<section
  data-component="InfoCards"
  data-intro-variant="universal"
  aria-labelledby={headingId}
>
  <BlockIntro intro={intro} headingId={headingId} umamiContext={umamiContext} />
  <div class="flex flex-col gap-xl desktop:flex-row desktop:gap-2xl">
    {htmlCards.map((card) => <InfoCard heading={card.heading}>
      <Fragment set:html={card.html} />
    </InfoCard>)}
  </div>
</section>
