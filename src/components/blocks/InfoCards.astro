---
/**
 * Grant-page info cards section (`blocks.info-cards` / grant frontmatter
 * `infoCards`) — fixed three-card row with optional section heading.
 *
 * Not the removed `blocks.info-card-grid` dynamic-zone block. DZ / MDX grids
 * use `CardGrid` with `variant="Info"` instead.
 */
import { parseMarkdown } from '@/utils'
import InfoCard from '@/components/shared/InfoCard.astro'

interface InfoCardData {
  heading: string
  body: string
}

interface Props {
  heading?: string
  cards: [InfoCardData, InfoCardData, InfoCardData]
  umamiContext?: string
}

const { heading, cards, umamiContext } = Astro.props
const { routeLocale } = Astro.locals

const htmlCards = await Promise.all(
  cards.map(async (card) => ({
    heading: card.heading,
    html: await parseMarkdown(card.body, {
      page: umamiContext,
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  }))
)
---

<div class="flex flex-col gap-block-heading">
  {
    heading && (
      <h2 class="m-0 text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-900">
        {heading}
      </h2>
    )
  }
  <div class="flex flex-col gap-xl desktop:flex-row desktop:gap-2xl">
    {
      htmlCards.map((card) => (
        <InfoCard heading={card.heading}>
          <Fragment set:html={card.html} />
        </InfoCard>
      ))
    }
  </div>
</div>
