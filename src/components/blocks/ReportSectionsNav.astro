---
import {
  useTranslations,
  buildSectionNavLinkUmamiAttrs,
  type Locale
} from '@/utils'

interface ReportNavSection {
  id: string
  heading: string
}

interface Props {
  sections: ReportNavSection[]
  uiLocale: Locale
}

const { sections, uiLocale } = Astro.props
const t = useTranslations(uiLocale)
const { routeLocale } = Astro.locals

const sectionNavAttrs = (id: string, heading: string) =>
  buildSectionNavLinkUmamiAttrs(
    Astro.url.pathname,
    routeLocale,
    'report',
    id,
    heading
  )
---

<nav
  data-report-nav
  data-lenis-prevent
  aria-label={t('report.sections_nav')}
  class="tablet:sticky tablet:top-[calc(var(--site-header-height)+var(--spacing-2xl))] tablet:max-h-[calc(100dvh-var(--site-header-height)-var(--spacing-2xl)-var(--spacing-2xl))] tablet:overflow-y-auto desktop:top-[calc(var(--site-header-height-desktop)+var(--spacing-2xl))] desktop:max-h-[calc(100dvh-var(--site-header-height-desktop)-var(--spacing-2xl)-var(--spacing-2xl))]"
>
  <ol class="m-0 flex flex-col gap-2xl p-0">
    {
      sections.map((section, index) => (
        <li class="m-0">
          <a
            href={`#${section.id}`}
            data-report-nav-link
            data-target={section.id}
            data-active={index === 0 ? 'true' : 'false'}
            aria-current={index === 0 ? 'true' : undefined}
            class="group flex flex-col gap-sm rounded-lg no-underline focus-visible:outline-none focus-visible:ring focus-visible:ring-link"
            {...sectionNavAttrs(section.id, section.heading)}
          >
            <span class="text-body-sm-standard text-neutral-75 transition-colors duration-200 group-hover:text-neutral-900 group-data-[active=true]:text-link">
              {section.heading}
            </span>
            <span
              aria-hidden="true"
              class="h-px w-0 bg-link transition-all duration-200 group-data-[active=true]:w-full"
            />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  // Scoped per instance via [data-report-nav] so multiple report pages'
  // scripts don't collide (matches src/components/blocks/Carousel.astro's
  // multi-instance idiom).
  import { initSectionNavScrollspy } from '@/scripts/section-nav-scrollspy'

  initSectionNavScrollspy({
    containerSelector: '[data-report-nav]',
    linkSelector: '[data-report-nav-link]'
  })
</script>

<style>
  /* Reuse the shared 5px <ol> marker; tighter gutter than body copy, orchid
     when the section is in view. */
  :global([data-report-nav] ol) {
    margin: 0;
    padding-inline-start: 0;
  }
  :global([data-report-nav] ol > li) {
    margin: 0;
    padding-inline-start: var(--spacing-lg);
  }
  :global([data-report-nav] ol > li::before) {
    left: 0;
    top: calc(0.5em - (var(--ol-marker-size, 5px) / 2) + 1px);
    transform: none;
  }
  :global([data-report-nav] ol > li:has([data-active='true'])::before) {
    background-color: var(--color-link);
  }
</style>
