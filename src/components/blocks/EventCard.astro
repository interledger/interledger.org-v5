---
/**
 * Event Card — full-width When / Where / optional Apply columns.
 *
 * One card per use (no multi-card grid). When Apply is omitted, When and Where
 * expand across the available width (INTORG-891).
 *
 * Strapi preview passes structured `when` / `where` / `apply` props.
 * MDX authoring passes <EventWhen>, <EventWhere>, and optional <EventApply>
 * as children.
 */
import EventWhen from '@/components/shared/EventWhen.astro'
import EventWhere from '@/components/shared/EventWhere.astro'
import EventApply from '@/components/shared/EventApply.astro'
import { useTranslations } from '@/utils'

interface EventWhenData {
  title: string
  text?: string
  date?: string
  time?: string
}

interface EventWhereData {
  title: string
  text?: string
  location?: string
}

interface EventApplyData {
  title: string
  primaryCta: {
    text: string
    link: string
    external?: boolean
  }
}

interface Props {
  when?: EventWhenData
  where?: EventWhereData
  apply?: EventApplyData | null
}

const { when, where, apply } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const fromStrapi = Boolean(when && where)
const hasApply = Boolean(
  apply?.title && apply?.primaryCta?.text && apply?.primaryCta?.link
)

// Populate gaps (e.g. preview missing nested when/where) must not paint an
// empty bordered shell. MDX authoring always has default-slot children.
if (!fromStrapi && !Astro.slots.has('default')) {
  return
}
---

<section
  data-component="EventCard"
  aria-label={t('eventCard.block_label')}
  class:list={[
    'mb-6xl w-full rounded-3xl border border-neutral-50 bg-white',
    'px-xl py-xl tablet:px-2xl tablet:py-2xl',
    // Summit/Hackathon prose wrappers use [&_h3]/[&_ul]/[&_li]/[&_p] descendant
    // utilities (specificity 0,1,1) that beat column m-0/p-0/text-h3 classes
    // (0,1,0). Reset at the card root so When/Where/Apply stay self-contained.
    '[&_h3]:!m-0 [&_h3]:!text-h3 [&_h3]:tablet:!text-h3-md [&_h3]:desktop:!text-h3-lg',
    '[&_p]:!m-0',
    '[&_ul]:!m-0 [&_ul]:!p-0 [&_ul]:!ps-0',
    '[&_li]:!m-0 [&_li]:!mb-0'
  ]}
>
  {
    /*
    Mobile: stacked columns with horizontal divider lines between sections.
    Tablet+: side-by-side columns with vertical rules; When Apply is present,
    expand to 3 columns.
  */
  }
  <div
    class:list={[
      'grid grid-cols-1',
      // Mobile: horizontal rules between When / Where / Apply
      '[&>[data-event-column]:not(:last-child)]:border-b',
      '[&>[data-event-column]:not(:last-child)]:border-neutral-50',
      '[&>[data-event-column]:not(:last-child)]:pb-xl',
      '[&>[data-event-column]:not(:first-child)]:pt-xl',
      // Tablet+: multi-column, drop horizontal rules, use vertical rules
      'tablet:grid-cols-2',
      'tablet:has-[[data-event-column=apply]]:grid-cols-3',
      'tablet:[&>[data-event-column]:not(:last-child)]:border-b-0',
      'tablet:[&>[data-event-column]:not(:last-child)]:pb-0',
      'tablet:[&>[data-event-column]:not(:first-child)]:pt-0',
      'tablet:[&>[data-event-column]+[data-event-column]]:border-s',
      'tablet:[&>[data-event-column]+[data-event-column]]:border-neutral-50',
      // Column padding when side-by-side; outer edges flush with card padding
      'tablet:[&>[data-event-column]]:px-xl',
      'tablet:[&>[data-event-column]:first-child]:ps-0',
      'tablet:[&>[data-event-column]:last-child]:pe-0'
    ]}
  >
    {
      fromStrapi ? (
        <>
          <EventWhen
            title={when!.title}
            text={when!.text}
            date={when!.date}
            time={when!.time}
          />
          <EventWhere
            title={where!.title}
            text={where!.text}
            location={where!.location}
          />
          {hasApply && apply && (
            <EventApply
              title={apply.title}
              buttonText={apply.primaryCta.text}
              buttonUrl={apply.primaryCta.link}
              buttonExternal={apply.primaryCta.external}
            />
          )}
        </>
      ) : (
        <slot />
      )
    }
  </div>
</section>
