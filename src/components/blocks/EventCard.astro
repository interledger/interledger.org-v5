---
/**
 * Event Card — full-width When / Where / optional Apply columns.
 *
 * One card per use (no multi-card grid). When Apply is omitted, When and Where
 * expand across the available width (INTORG-891). Optional `title` sits above
 * the card, not inside the bordered surface.
 *
 * Strapi preview passes structured `when` / `where` / `apply` props.
 * MDX authoring passes <EventWhen>, <EventWhere>, and optional <EventApply>
 * as children.
 */
import EventWhen from '@/components/shared/EventWhen.astro'
import EventWhere from '@/components/shared/EventWhere.astro'
import EventApply from '@/components/shared/EventApply.astro'
import { useTranslations } from '@/utils'

interface EventWhenData {
  title: string
  text?: string
  date?: string
  time?: string
}

interface EventWhereData {
  title: string
  text?: string
  location?: string
}

interface EventApplyData {
  title?: string
  text?: string
  primaryCta: {
    text: string
    link: string
    external?: boolean
    document?: boolean
  }
}

interface Props {
  title?: string
  when?: EventWhenData
  where?: EventWhereData
  apply?: EventApplyData | null
}

const { title, when, where, apply } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const fromStrapi = Boolean(when && where)
const hasApply = Boolean(apply?.primaryCta?.text && apply?.primaryCta?.link)
const heading = title?.trim()
const headingId = heading
  ? `event-card-heading-${crypto.randomUUID()}`
  : undefined

// Populate gaps (e.g. preview missing nested when/where) must not paint an
// empty bordered shell. MDX authoring always has default-slot children.
if (!fromStrapi && !Astro.slots.has('default')) {
  return
}
---

<section
  data-component="EventCard"
  aria-label={heading ? undefined : t('eventCard.block_label')}
  aria-labelledby={headingId}
  class="mb-6xl w-full"
>
  {
    heading && headingId && (
      <h2
        id={headingId}
        class="mt-0 !mb-3xl text-h2 font-semibold text-neutral-100 tablet:!mb-4xl tablet:text-h2-md dark:text-neutral-0 desktop:text-h2-lg"
      >
        {heading}
      </h2>
    )
  }
  <div
    class:list={[
      'rounded-3xl border border-neutral-50 bg-white',
      'dark:border-neutral-75 dark:bg-neutral-100',
      'px-xl py-xl',
      '[&_h3]:!m-0 [&_h3]:!text-h3 tablet:[&_h3]:!text-h3-md desktop:[&_h3]:!text-h3-lg',
      'dark:[&_h3]:!text-neutral-0',
      '[&_p]:!m-0',
      '[&_[data-event-meta]]:!text-h4 tablet:[&_[data-event-meta]]:!text-h4-md desktop:[&_[data-event-meta]]:!text-h4-lg',
      '[&_[data-event-copy]]:!text-h5',
      '[&_[data-event-copy]_p]:!text-h5',
      'dark:[&_[data-event-meta]]:!text-neutral-0',
      'dark:[&_[data-event-copy]]:!text-neutral-0',
      'dark:[&_[data-event-copy]_p]:!text-neutral-0',
      '[&_ul]:!m-0 [&_ul]:!p-0 [&_ul]:!ps-0',
      '[&_li]:!m-0 [&_li]:!mb-0',
      '[&_[data-component=LinkButton]]:!no-underline',
      '[&_[data-component=LinkButton]:hover]:!no-underline'
    ]}
  >
    <div
      class:list={[
        'event-card-grid grid',
        '[&>[data-event-column]:not(:last-child)]:border-b',
        '[&>[data-event-column]:not(:last-child)]:border-neutral-50',
        'dark:[&>[data-event-column]:not(:last-child)]:border-neutral-75',
        '[&>[data-event-column]:not(:last-child)]:pb-xl',
        '[&>[data-event-column]:not(:first-child)]:pt-xl',
        'tablet:[&>[data-event-column]:not(:last-child)]:border-b-0',
        'tablet:[&>[data-event-column]:not(:last-child)]:pb-0',
        'tablet:[&>[data-event-column]:not(:first-child)]:pt-0',
        'tablet:[&>[data-event-column]+[data-event-column]]:border-s',
        'tablet:[&>[data-event-column]+[data-event-column]]:border-neutral-50',
        'dark:tablet:[&>[data-event-column]+[data-event-column]]:border-neutral-75',
        'tablet:[&>[data-event-column]]:px-xl',
        'tablet:[&>[data-event-column]:first-child]:ps-0',
        'tablet:[&>[data-event-column]+[data-event-column]]:ps-2xl',
        'tablet:[&>[data-event-column]:last-child]:pe-0'
      ]}
    >
      {
        fromStrapi ? (
          <>
            <EventWhen
              title={when!.title}
              text={when!.text}
              date={when!.date}
              time={when!.time}
            />
            <EventWhere
              title={where!.title}
              text={where!.text}
              location={where!.location}
            />
            {hasApply && apply && (
              <EventApply
                title={apply.title}
                text={apply.text}
                buttonText={apply.primaryCta.text}
                buttonUrl={apply.primaryCta.link}
                buttonExternal={apply.primaryCta.external}
                buttonDocument={apply.primaryCta.document}
              />
            )}
          </>
        ) : (
          <slot />
        )
      }
    </div>
  </div>
</section>

<style>
  .event-card-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 810px) {
    .event-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .event-card-grid:has(> [data-event-column='apply']) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.5fr);
    }
  }
</style>
