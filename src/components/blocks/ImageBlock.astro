---
import {
  getOptimizedImage,
  hasOptimizedVariants,
  isOptimizableSource,
  buildUmamiAttrs
} from '@/utils'
import ResponsiveSources from '@/components/shared/ResponsiveSources.astro'

interface MediaFile {
  url?: string
  alternativeText?: string | null
}

interface LocalizedMedia {
  image?: MediaFile | null
  alternativeText?: string | null
}

interface Props {
  src?: string
  alt?: string
  tabletSrc?: string
  mobileSrc?: string
  needsFullView?: boolean
  needsOutline?: boolean
  /** Strapi DynamicZone preview — `shared.localized-media` on the required image. */
  media?: LocalizedMedia
  tabletImage?: MediaFile | null
  mobileImage?: MediaFile | null
}

const {
  src: srcProp,
  alt: altProp,
  tabletSrc: tabletSrcProp,
  mobileSrc: mobileSrcProp,
  needsFullView = false,
  needsOutline = false,
  media,
  tabletImage,
  mobileImage
} = Astro.props

// MDX serializes `src` / `tabletSrc` / `mobileSrc`. Preview spreads the raw
// Strapi block (`media` / `tabletImage` / `mobileImage`).
const src = srcProp ?? media?.image?.url
const alt =
  altProp ?? media?.alternativeText ?? media?.image?.alternativeText ?? ''
const tabletSrc = tabletSrcProp ?? tabletImage?.url
const mobileSrc = mobileSrcProp ?? mobileImage?.url

const { routeLocale } = Astro.locals

const fullImageAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'link',
  baseComponent: 'image_block',
  href: src,
  linkText: 'View full image'
})

const desktop = src ? getOptimizedImage(src) : null
const tablet = tabletSrc ? getOptimizedImage(tabletSrc) : null
const mobile = mobileSrc ? getOptimizedImage(mobileSrc) : null

// The <img> is the picture fallback; it serves the unoptimized original only
// when the desktop source degraded (e.g. a CDN upload missing from this deploy).
const desktopUnoptimized =
  !!src &&
  desktop !== null &&
  !hasOptimizedVariants(desktop) &&
  isOptimizableSource(src)

// Breakpoints from tailwind.config.mjs: tablet=810px, desktop=1200px
// Sources are ordered narrow-first so the first matching <source> wins.
const MOBILE_MQ = '(max-width: 809px)'
const TABLET_MQ = '(max-width: 1199px)'
---

{
  src && (
    <figure class="my-0" data-component="ImageBlock">
      <picture>
        <ResponsiveSources
          image={mobile}
          rawSrc={mobileSrc}
          media={MOBILE_MQ}
        />
        <ResponsiveSources
          image={tablet}
          rawSrc={tabletSrc}
          media={TABLET_MQ}
        />
        <ResponsiveSources image={desktop} />

        <img
          src={src}
          alt={alt}
          loading="lazy"
          decoding="async"
          class:list={[
            'w-full rounded',
            needsOutline && 'ring-1 ring-neutral-25'
          ]}
          data-unoptimized-src={desktopUnoptimized ? src : undefined}
        />
      </picture>

      {needsFullView && (
        <figcaption class="mt-s text-right">
          <a
            href={src}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-xs text-body-sm-standard tablet:text-h5-md desktop:text-h5-lg text-neutral-75 hover:text-link underline-offset-2 hover:underline transition-colors"
            {...fullImageAttrs}
          >
            View full image
            <svg
              aria-hidden="true"
              viewBox="0 0 18 18"
              class="h-3 w-3 shrink-0"
              fill="none"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 3H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M11 1h6m0 0v6m0-6L7 11"
              />
            </svg>
          </a>
        </figcaption>
      )}
    </figure>
  )
}

<script>
  if (import.meta.env.DEV) {
    // Surfaces images that fell back to the unoptimized original (e.g. a CDN
    // upload missing from this deploy). Idempotent so duplicate inclusion across
    // components can't double-warn.
    for (const img of document.querySelectorAll(
      'img[data-unoptimized-src]:not([data-unoptimized-warned])'
    )) {
      img.setAttribute('data-unoptimized-warned', '')
      console.warn(
        '[images] Serving unoptimized full-size image: ' +
          img.getAttribute('data-unoptimized-src') +
          ' — not present in this deploy or not eligible for optimization.'
      )
    }
  }
</script>
