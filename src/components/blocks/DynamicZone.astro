---
/**
 * DynamicZone - Maps Strapi block types to Astro components
 * Used for SSR preview of draft content from Strapi
 *
 * Note: We use 'any' for the component map because TypeScript cannot
 * statically verify props for dynamically selected components.
 * The Strapi schema ensures correct props at runtime.
 */
import Paragraph from './Paragraph.astro'
import LogoCarousel from './LogoCarousel.astro'
import CtaStrip from './CtaStrip.astro'
import ProfileBlock from './ProfileBlock.astro'
import ProfileGridBlock from './ProfileGridBlock.astro'
import BlockquoteBlock from './BlockquoteBlock.astro'
import CalloutTextBlock from './CalloutTextBlock.astro'
import PdfEmbedBlock from './PdfEmbedBlock.astro'
import VideoEmbedBlock from './VideoEmbedBlock.astro'
import ImageBlock from './ImageBlock.astro'
import CodeBlock from './CodeBlock.astro'
import SplitLayout from './SplitLayout.astro'
import NumberTiles from './NumberTiles.astro'
import CardGrid from './CardGrid.astro'
import Agenda from './Agenda.astro'
import Faq from './Faq.astro'
import EventCard from './EventCard.astro'
import Quote from './Quote.astro'
import CtaLink from './CtaLink.astro'
import CtaButtons from './CtaButtons.astro'
import HackathonAnimation from '@/components/hackathon/HackathonAnimation.astro'

interface Block {
  __component: string
  [key: string]: unknown
}

interface Props {
  blocks: Block[]
}

const { blocks } = Astro.props

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const componentMap: Record<string, any> = {
  'blocks.paragraph': Paragraph,
  'blocks.carousel': LogoCarousel,
  'blocks.cta-strip': CtaStrip,
  'blocks.profile': ProfileBlock,
  'blocks.profile-grid': ProfileGridBlock,
  'blocks.blockquote': BlockquoteBlock,
  'blocks.callout-text': CalloutTextBlock,
  'blocks.pdf-embed': PdfEmbedBlock,
  'blocks.video-embed': VideoEmbedBlock,
  'blocks.image-block': ImageBlock,
  'blocks.code-block': CodeBlock,
  'blocks.split-layout': SplitLayout,
  'blocks.number-tiles': NumberTiles,
  'blocks.card-grid': CardGrid,
  'blocks.agenda': Agenda,
  'blocks.faq': Faq,
  'blocks.event-card': EventCard,
  'blocks.quote': Quote,
  'shared.cta-link': CtaLink,
  'blocks.cta-buttons': CtaButtons,
  'blocks.hackathon-animation': HackathonAnimation
}

const resolvedBlocks = blocks
  .map((block) => {
    const Component = componentMap[block.__component]
    if (!Component) {
      // eslint-disable-next-line no-console
      console.warn(`Unknown component type: ${block.__component}`)
      return null
    }
    return { Component, props: block, uid: block.__component }
  })
  .filter((item): item is NonNullable<typeof item> => item !== null)

// Blocks are separated by the standard section gap on every item after the
// first. That is the same value `page-stack` and prose/rhythm.css apply on a
// live page, so a block sits in the same place in the preview and the export.
// It is written per item so a block can opt out and own its spacing instead.
//
// A block only belongs in OWNS_ITS_SPACING if it renders in both the Strapi
// preview (this file) and in an exported MDX page. In MDX there is no wrapper,
// so the component's own margin is the only spacing it gets. Leaving the
// wrapper margin in place as well would make the same block sit further down
// in the preview than on the live page.
const OWNS_ITS_SPACING = new Set(['blocks.cta-buttons'])
const BLOCK_GAP = 'mt-section'
---

<div class="flex flex-col">
  {
    resolvedBlocks.map(({ Component, props, uid }, index) => (
      <div
        class:list={[
          'w-full',
          index > 0 && !OWNS_ITS_SPACING.has(uid) && BLOCK_GAP
        ]}
      >
        <Component {...props} />
      </div>
    ))
  }
</div>
