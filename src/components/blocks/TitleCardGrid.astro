---
/**
 * Thin alias: legacy TitleCardGrid → CardGrid variant Title.
 * Kept for DynamicZone preview of old blocks and MDX back-compat.
 */
import CardGrid from './CardGrid.astro'

interface StrapiTitleCard {
  heading: string
  subHeading?: string
  description: string
  secondaryCta: {
    link: string
    text: string
    external?: boolean
    document?: boolean
  }
}

interface Props {
  ariaLabel: string
  columns: 'Two' | 'Three'
  titleCards?: StrapiTitleCard[]
}

const { ariaLabel, columns, titleCards }: Props = Astro.props

const cards = titleCards?.map((card) => ({
  __component: 'blocks.title-card',
  ...card
}))
---

{
  cards ? (
    <CardGrid
      ariaLabel={ariaLabel}
      variant="Title"
      columns={columns}
      cards={cards}
    />
  ) : (
    <CardGrid ariaLabel={ariaLabel} variant="Title" columns={columns}>
      <slot />
    </CardGrid>
  )
}
