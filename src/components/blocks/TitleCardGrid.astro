---
import TitleCard from '@/components/shared/TitleCard.astro'
import { parseMarkdown } from '@/utils'

const GRID_COLUMNS_CLASS = {
  Two: 'desktop:grid-cols-2',
  Three: 'desktop:grid-cols-3'
} as const satisfies Record<string, string>

interface StrapiTitleCard {
  heading: string
  subHeading?: string
  description: string
  secondaryCta: {
    link: string
    text: string
    external?: boolean
  }
}

interface Props {
  ariaLabel: string
  columns: keyof typeof GRID_COLUMNS_CLASS
  titleCards?: StrapiTitleCard[]
  umamiContext?: string
}

const { ariaLabel, columns, titleCards, umamiContext }: Props = Astro.props
const { routeLocale } = Astro.locals
const gridColumnsClass = GRID_COLUMNS_CLASS[columns]

const htmlCards = titleCards
  ? await Promise.all(
      titleCards.map(async (card) => ({
        ...card,
        descriptionHtml: await parseMarkdown(card.description, {
          page: umamiContext,
          pathname: Astro.url.pathname,
          lang: routeLocale
        })
      }))
    )
  : null
---

<section
  data-component="TitleCardGrid"
  aria-label={ariaLabel}
  class="mx-auto w-full max-w-content"
>
  <div
    class:list={[
      'grid grid-cols-1 gap-lg tablet:grid-cols-2 tablet:gap-xl',
      gridColumnsClass
    ]}
  >
    {
      htmlCards ? (
        htmlCards.map((card) => (
          <TitleCard
            heading={card.heading}
            subheading={card.subHeading}
            buttonUrl={card.secondaryCta.link}
            buttonText={card.secondaryCta.text}
            buttonExternal={card.secondaryCta.external}
          >
            <Fragment set:html={card.descriptionHtml} />
          </TitleCard>
        ))
      ) : (
        <slot />
      )
    }
  </div>
</section>
