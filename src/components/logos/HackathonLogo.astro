---
/**
 * Official Open Payments Hackathon lockup (negative) used on the hero.
 * Brand chrome — not a heading (the hero title is the page h1).
 */
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import { useTranslations } from '@/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
---

<div
  class:list={['hackathon-logo', className]}
  data-component="HackathonLogo"
>
  <OptimizedImage
    src="/img/hackathon/lockup-negative.png"
    alt={t('hackathonHero.logo.alt')}
    width={202}
    height={61}
    sizes="202px"
    class="h-auto w-[202px]"
  />
</div>
