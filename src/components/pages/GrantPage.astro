---
import {
  type Locale,
  parseMarkdown,
  resolveCtaLink,
  useTranslations,
  localizeRoute,
  grantOverviewHubPath
} from '@/utils'
import { getCollection, render } from 'astro:content'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import PageHero from '@/components/shared/PageHero.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import InfoCards from '@/components/blocks/InfoCards.astro'
import ProfileGrid from '@/components/shared/ProfileGrid.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import GrantFaqSection from '@/components/grant/GrantFaqSection.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import BlockquoteBlock from '@/components/blocks/BlockquoteBlock.astro'
import CalloutTextBlock from '@/components/blocks/CalloutTextBlock.astro'
import VideoEmbedBlock from '@/components/blocks/VideoEmbedBlock.astro'
import ImageBlock from '@/components/blocks/ImageBlock.astro'
import CtaLink from '@/components/blocks/CtaLink.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import InfoCard from '@/components/shared/InfoCard.astro'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const pages = await getCollection('grant-pages')

const mdxPage = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!mdxPage) return Astro.redirect('/404')

const { Content: MdxContent } = await render(mdxPage)
const {
  title,
  description,
  heroTitle,
  heroDescription,
  heroImage,
  heroImageAlt,
  heroImageMobile,
  heroImageMobileAlt,
  heroCtas,
  metaImage,
  canonicalUrl,
  primaryCta,
  faqSection,
  ctaStrip,
  infoCards,
  programOverview
} = mdxPage.data

// Icon by link kind (INTORG-938). This CTA always showed `arrow-right`, so an
// external link and a document download both got the wrong glyph. The internal
// case keeps the arrow, because this one belongs to the grant page template
// rather than to a component an editor picks (Sarah, INTORG-907, 2026-08-09).
const resolvedPrimaryCta = primaryCta
  ? resolveCtaLink({
      url: primaryCta.link,
      external: primaryCta.external,
      document: primaryCta.document,
      internalIcon: 'arrow-right'
    })
  : null

const programOverviewHtml = programOverview
  ? await parseMarkdown(programOverview, {
      pathname: Astro.url.pathname,
      lang: contentLocale
    })
  : null
const t = useTranslations(routeLocale)

const resolvedHeroTitle = heroTitle?.trim() || title

const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  {
    name: t('nav.grants'),
    href: localizeRoute(grantOverviewHubPath(), routeLocale)
  },
  {
    name: resolvedHeroTitle,
    href: localizeRoute(`grant/${slug}`, routeLocale)
  }
]

// Grant markdown `##` is a section title (same role as InfoCards "At a Glance"),
// whether it is a direct child of programOverview or wrapped in <Paragraph>.
const grantSectionHeadingClass =
  '[&_h2]:text-h3 tablet:[&_h2]:text-h3-md desktop:[&_h2]:text-h3-lg [&_h2]:text-neutral-900 [&_h2_strong]:font-medium [&_p_strong]:font-semibold'

const heroLcpPreload =
  heroImage || heroImageMobile
    ? { image: heroImage, imageMobile: heroImageMobile }
    : undefined
---

<FoundationPageLayout
  title={title}
  description={description}
  ogImageUrl={metaImage}
  canonicalURL={canonicalUrl}
  heroLcpPreload={heroLcpPreload}
>
  <main class="page-stack pb-section">
    <PageHero
      title={resolvedHeroTitle}
      description={heroDescription ?? description}
      image={heroImage}
      imageMobile={heroImageMobile}
      imageAlt={heroImageAlt}
      imageMobileAlt={heroImageMobileAlt}
      cta={heroCtas?.[0]}
      breadcrumbs={breadcrumbs}
    >
      <TranslationDisclaimer slot="after-breadcrumbs" isVisible={isFallback} />
    </PageHero>
    {
      programOverviewHtml && (
        <section class="px-content">
          <div class="content-column">
            <div
              data-prose
              class:list={[grantSectionHeadingClass, '[&>h2:first-child]:mt-0']}
              set:html={programOverviewHtml}
            />
          </div>
        </section>
      )
    }

    {
      primaryCta && resolvedPrimaryCta && (
        <section class="px-content" data-stack="cta">
          <div class="content-column">
            <LinkButton
              href={resolvedPrimaryCta.href}
              variant="primary"
              external={resolvedPrimaryCta.external}
              document={resolvedPrimaryCta.document}
              linkText={primaryCta.text}
              umamiLabel="button_cta"
              umamiBaseComponent="primary_cta"
            >
              {primaryCta.text}
              <Icon name={resolvedPrimaryCta.icon} slot="icon-right" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      infoCards && (
        <section class="px-content">
          <div class="content-column">
            <InfoCards heading={infoCards.heading} cards={infoCards.cards} />
          </div>
        </section>
      )
    }

    <section class="px-content">
      <div class="content-column">
        <div data-prose class={grantSectionHeadingClass}>
          <MdxContent
            components={{
              Paragraph,
              SplitLayout,
              Blockquote: BlockquoteBlock,
              CalloutText: CalloutTextBlock,
              VideoEmbed: VideoEmbedBlock,
              ImageBlock,
              CtaStrip,
              ProfileGrid,
              LogoCarousel,
              CtaLink,
              // Grant pages only allow CardGrid variant="Info" (enforced in CMS).
              CardGrid,
              InfoCard
            }}
          />
        </div>
      </div>
    </section>

    {
      faqSection && (
        <section class="px-content">
          <div class="content-column">
            <GrantFaqSection {...faqSection} />
          </div>
        </section>
      )
    }

    <section class="px-content">
      <div class="content-column">
        <CtaStrip
          heading={ctaStrip.heading}
          description={ctaStrip.description}
          primaryButtonText={ctaStrip.buttonText}
          primaryButtonLink={ctaStrip.buttonLink}
          primaryButtonExternal={ctaStrip.buttonExternal}
          primaryButtonDocument={ctaStrip.buttonDocument}
          secondaryButtonText={ctaStrip.secondaryButtonText}
          secondaryButtonLink={ctaStrip.secondaryButtonLink}
          secondaryButtonExternal={ctaStrip.secondaryButtonExternal}
          secondaryButtonDocument={ctaStrip.secondaryButtonDocument}
        />
      </div>
    </section>
  </main>
</FoundationPageLayout>
