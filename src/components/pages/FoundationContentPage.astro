---
import {
  type Locale,
  isDemoPathSlug,
  useTranslations,
  localizeRoute
} from '@/utils'
import { getCollection, render } from 'astro:content'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import ProfileCard from '@/components/shared/ProfileCard.astro'
import ProfileGrid from '@/components/shared/ProfileGrid.astro'
import Blockquote from '@/components/shared/Blockquote.astro'
import Quote from '@/components/blocks/Quote.astro'
import CalloutText from '@/components/shared/CalloutText.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import PdfEmbed from '@/components/shared/PdfEmbed.astro'
import VideoEmbed from '@/components/shared/VideoEmbed.astro'
import InfoCard from '@/components/shared/InfoCard.astro'
import NumberTiles from '@/components/blocks/NumberTiles.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import PageHero from '@/components/shared/PageHero.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import TitleCard from '@/components/shared/TitleCard.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import ResourceCard from '@/components/shared/ResourceCard.astro'
import NavigationCard from '@/components/shared/NavigationCard.astro'
import Agenda from '@/components/blocks/Agenda.astro'
import Faq from '@/components/blocks/Faq.astro'
import CtaButtons from '@/components/blocks/CtaButtons.astro'
import FaqItem from '@/components/shared/FaqItem.astro'
import EventCard from '@/components/blocks/EventCard.astro'
import EventWhen from '@/components/shared/EventWhen.astro'
import EventWhere from '@/components/shared/EventWhere.astro'
import EventApply from '@/components/shared/EventApply.astro'
import ImageBlock from '@/components/blocks/ImageBlock.astro'
import DonationCards from '@/components/blocks/DonationCards.astro'
import FundraiseUpScript from '@/components/support/FundraiseUpScript.astro'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const pages = await getCollection('foundation-pages')

const mdxPage = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!mdxPage) return Astro.redirect('/404')

Astro.locals.profileEntries = await getCollection('profiles')
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const { Content: MdxContent } = await render(mdxPage)

const {
  title,
  description,
  heroTitle,
  heroDescription,
  heroImage,
  heroImageAlt,
  heroImageBlur,
  heroImageMobile,
  heroImageMobileAlt,
  heroImageMobileBlur,
  heroCtas
} = mdxPage.data

const isNotFound = !MdxContent
const noindex = isDemoPathSlug(mdxPage.data.pathSlug)

if (isNotFound) return Astro.redirect('/404')

const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  { name: heroTitle ?? title, href: localizeRoute(slug, routeLocale) }
]

/**
 * A page carrying Donation Cards is a fundraising page, and that is the whole
 * signal: the block's CTAs point at Fundraise Up Element IDs, and Fundraise Up
 * swaps its own donate button into any anchor with that href — but only once
 * its install script is on the page.
 *
 * The script loads per page rather than from BaseLayout so the other ~200
 * routes don't pay for a third-party bundle; see FundraiseUpScript.astro for
 * what moving it site-wide would buy.
 */
const needsFundraiseUp = mdxPage.body?.includes('<DonationCards') ?? false

const heroLcpPreload =
  heroTitle && (heroImage || heroImageMobile)
    ? { image: heroImage, imageMobile: heroImageMobile }
    : undefined
---

<FoundationPageLayout
  title={title}
  description={description}
  noindex={noindex}
  heroLcpPreload={heroLcpPreload}
>
  <Fragment slot="head">{needsFundraiseUp && <FundraiseUpScript />}</Fragment>

  <main class="page-stack pb-section" data-pillar="mission">
    {
      heroTitle ? (
        <PageHero
          title={heroTitle ?? title}
          description={heroDescription ?? description}
          image={heroImage}
          imageMobile={heroImageMobile}
          imageAlt={heroImageAlt}
          imageMobileAlt={heroImageMobileAlt}
          imageBlur={heroImageBlur}
          imageMobileBlur={heroImageMobileBlur}
          cta={heroCtas?.[0]}
          breadcrumbs={breadcrumbs}
          imageBand="default"
        >
          <TranslationDisclaimer
            slot="after-breadcrumbs"
            isVisible={isFallback}
          />
        </PageHero>
      ) : (
        <div class="px-content pt-page-offset">
          <div class="content-column">
            <Breadcrumbs breadcrumbs={breadcrumbs}>
              <TranslationDisclaimer isVisible={isFallback} />
            </Breadcrumbs>
            {/* Same treatment PageHero gives its own h1, so a hero-less page
            still gets a real page title instead of relying on MdxContent's
            first heading (which may not exist, or may be an h2 section
            heading rather than the page's own title). */}
            <h1 class="text-h2 tablet:text-h2-md desktop:text-h2-lg text-neutral-900 mb-2xl tablet:mb-3xl">
              {title}
            </h1>
          </div>
        </div>
      )
    }
    <section class="px-content">
      <div class="content-column">
        <div data-prose class="mx-auto max-w-content">
          <MdxContent
            components={{
              img: OptimizedImage,
              ProfileCard,
              ProfileGrid,
              Blockquote,
              Quote,
              CalloutText,
              Paragraph,
              SplitLayout,
              CtaStrip,
              PdfEmbed,
              VideoEmbed,
              InfoCard,
              TitleCard,
              CardGrid,
              ResourceCard,
              NavigationCard,
              NumberTiles,
              Agenda,
              Faq,
              CtaButtons,
              FaqItem,
              EventCard,
              EventWhen,
              EventWhere,
              EventApply,
              LogoCarousel,
              ImageBlock,
              DonationCards
            }}
          />
        </div>
      </div>
    </section>
  </main>
</FoundationPageLayout>
