---
import '@/styles/tailwind.css'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import GrantReportFacts from '@/components/grant/GrantReportFacts.astro'
import GrantReportList from '@/components/grant/GrantReportList.astro'
import type { GrantReport } from '@/types/airtable'
import {
  type GrantReportPageProps,
  type UiKey,
  useTranslations,
  buildHomeBreadcrumb,
  defaultLocale,
  formatReportMonth,
  grantReportLabel,
  localizeRoute,
  parseMarkdownBelowHeading,
  grantOverviewHubPath,
  grantGranteeDirectoryPath
} from '@/utils'

// Report content comes from Airtable in English only, like the grantee
// profiles. The ES route shows it with the translation disclaimer; only the
// UI strings can be translated, through src/data/ui.ts.
//
// The route passes reportPath, so this page does not decide the report URL.

type Props = GrantReportPageProps

const { report, reportPath, granteeName, grant, grantReports } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

// "Interim report 1".
const reportLabel = grantReportLabel(report, t)

// The last crumb names the grantee and the project, so the "Interim report 1"
// of two grants can be told apart. No grantee step: profiles do not exist yet.
const breadcrumbs = [
  buildHomeBreadcrumb(routeLocale, t),
  {
    name: t('nav.grants'),
    href: localizeRoute(grantOverviewHubPath(), routeLocale)
  },
  {
    name: t('grantee.title'),
    href: localizeRoute(grantGranteeDirectoryPath(), routeLocale)
  },
  {
    name: granteeName
      ? t('grantReport.breadcrumb', {
          grantee: granteeName,
          project: report.projectName,
          report: reportLabel
        })
      : `${report.projectName} - ${reportLabel}`,
    href: localizeRoute(reportPath, routeLocale)
  }
]

const markdownContext = {
  page: 'grant_report',
  pathname: Astro.url.pathname,
  lang: routeLocale
}

const SECTIONS = [
  ['summary', 'grantReport.summary'],
  ['progressOnObjectives', 'grantReport.progress'],
  ['whoBenefits', 'grantReport.who_benefits'],
  ['outputs', 'grantReport.outputs'],
  ['whatsNext', 'grantReport.whats_next']
] as const satisfies readonly (readonly [keyof GrantReport, UiKey])[]

// Each section has an h2, so a heading that a grantee typed in the text
// starts at h3.
const SECTION_TEXT_MIN_HEADING = 3

// Programs can leave any section empty. An empty one is left out, heading
// and all. Outputs also shows when only its output types are set.
const sections = SECTIONS.map(([field, headingKey]) => ({
  field,
  id: `grant-report-${field}`,
  heading: t(headingKey),
  html: parseMarkdownBelowHeading(
    report[field],
    SECTION_TEXT_MIN_HEADING,
    markdownContext
  )
})).filter(
  ({ field, html }) =>
    html !== '' || (field === 'outputs' && report.outputTypes.length > 0)
)

const { reportingPeriodStart: periodStart, reportingPeriodEnd: periodEnd } =
  report

// The first image is the cover. "From the project" shows the others with
// their descriptions, and is left out when there are none: the cover is
// never repeated (Sarah, INTORG-1303 497d6d9c).
const [cover, ...projectImages] = report.images

// The content column is 2/3 of max-w-content (1440px) on desktop, minus the
// 80px gap, and the full width below that.
const CONTENT_IMAGE_SIZES = '(min-width: 1200px) 907px, 100vw'

const pillClasses =
  'inline-block px-sm py-xs text-body-sm-standard text-neutral-100 border border-neutral-50 rounded-full'
---

<FoundationPageLayout
  title={`${report.projectName}: ${reportLabel}`}
  description={t('grantReport.meta_description', {
    report: reportLabel,
    project: report.projectName
  })}
>
  <main
    data-grant-report
    class="flex flex-col px-content pb-section pt-[calc(var(--spacing-5xl)-var(--site-header-height))] tablet:pt-[calc(var(--spacing-6xl)-var(--site-header-height))] desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))]"
  >
    {/* One column below desktop: header, facts, content, report list. On
      desktop the facts and the list move into a sticky sidebar, so the
      sidebar wrapper only becomes a box there. */}
    <article
      class="w-full max-w-content m-auto grid grid-cols-1 gap-y-3xl desktop:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] desktop:gap-x-5xl desktop:gap-y-0"
    >
      <header class="flex flex-col desktop:col-start-1">
        <Breadcrumbs breadcrumbs={breadcrumbs}>
          <TranslationDisclaimer isVisible={routeLocale !== defaultLocale} />
        </Breadcrumbs>

        <h1
          class="m-0 text-h2 tablet:text-h2-md desktop:text-h2-lg text-neutral-900"
        >
          {t('grantReport.title', {
            project: report.projectName,
            report: reportLabel.toLocaleLowerCase(routeLocale)
          })}
        </h1>

        {granteeName && <p
          class="m-0 pt-2xl text-h5 tablet:text-h5-md desktop:text-h5-lg font-semibold text-neutral-900"
        >
          {t('grantReport.grantee', { name: granteeName })}
        </p>}

        <p class="m-0 pt-2xl text-body-lg-standard text-neutral-900">
          {t('grantReport.published', {
            date: formatReportMonth(report.publishedDate, routeLocale)
          })}
          {periodStart && periodEnd && (
            <>
              {' '}
              {t('grantReport.covers', {
                start: formatReportMonth(periodStart, routeLocale),
                end: formatReportMonth(periodEnd, routeLocale)
              })}
            </>
          )}
        </p>

        {cover && (
          <OptimizedImage
            src={cover.path}
            alt={cover.alt}
            width={cover.width}
            height={cover.height}
            sizes={CONTENT_IMAGE_SIZES}
            class="mt-4xl w-full h-auto aspect-[3/2] rounded-3xl object-cover"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </header>

      <div
        class="contents desktop:block desktop:col-start-2 desktop:row-start-1 desktop:row-span-2"
      >
        <div
          class="contents desktop:sticky desktop:top-[calc(var(--site-header-height-desktop)+var(--spacing-xl))] desktop:flex desktop:flex-col desktop:gap-2xl"
        >
          <GrantReportFacts
            report={report}
            grant={grant}
            class="order-2 desktop:order-none"
          />
          <GrantReportList
            items={grantReports}
            class="order-4 desktop:order-none"
          />
        </div>
      </div>

      {/* A heading typed in a section is an h3 under the section's h2, but the
        design gives it the h4 size, one step below the section heading. */}
      <div
        data-prose
        class="order-3 desktop:order-none desktop:col-start-1 [&_section_h3]:text-h4 tablet:[&_section_h3]:text-h4-md desktop:[&_section_h3]:text-h4-lg"
      >
        {sections.map((section, index) => (
          <>
            <section aria-labelledby={section.id}>
              <Paragraph>
                <h2
                  id={section.id}
                  class="text-h3 tablet:text-h3-md desktop:text-h3-lg"
                >
                  {section.heading}
                </h2>
                {section.field === 'outputs' &&
                  report.outputTypes.length > 0 && <ul
                    class="list-none m-0 p-0 flex flex-wrap gap-sm [&>li]:before:content-none"
                    aria-label={t('grantReport.output_types')}
                  >
                    {report.outputTypes.map((type) => <li class="m-0 p-0">
                      <span class={pillClasses}>{type}</span>
                    </li>)}
                  </ul>}
                <Fragment set:html={section.html} />
              </Paragraph>
            </section>
            {index === 0 && sections.length > 1 && <hr />}
          </>
        ))}

        {projectImages.length > 0 && <section
          aria-labelledby="grant-report-from-project"
        >
          <Paragraph>
            <h2
              id="grant-report-from-project"
              class="text-h3 tablet:text-h3-md desktop:text-h3-lg"
            >
              {t('grantReport.from_project')}
            </h2>
          </Paragraph>
          <ul class="list-none m-0 p-0 flex flex-col gap-2xl">
            {projectImages.map((image) => <li class="m-0 p-0">
              <figure class="m-0 flex flex-col gap-lg">
                {/* The caption, when there is one, names the figure, so the
                  image itself would only repeat it. */}
                <OptimizedImage
                  src={image.path}
                  alt=""
                  width={image.width}
                  height={image.height}
                  sizes={CONTENT_IMAGE_SIZES}
                  class="w-full h-auto rounded-2xl"
                  loading="lazy"
                />
                {image.alt && <figcaption
                  class="text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-75"
                >
                  {image.alt}
                </figcaption>}
              </figure>
            </li>)}
          </ul>
        </section>}
      </div>
    </article>
  </main>
</FoundationPageLayout>
