---
import { getCollection, render } from 'astro:content'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import ReportIntro from '@/components/blocks/ReportIntro.astro'
import ReportSection from '@/components/blocks/ReportSection.astro'
import ReportSectionsNav from '@/components/blocks/ReportSectionsNav.astro'
import ReportText from '@/components/shared/ReportText.astro'
import AuthorByline from '@/components/shared/AuthorByline.astro'
import AuthorBio from '@/components/shared/AuthorBio.astro'
import {
  type Locale,
  useTranslations,
  buildSectionEntryBreadcrumbs,
  formatDate,
  getSectionPageLayout
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

// Section headings are authored as markdown `##` inside <ReportSection> (see
// report-section.serializer.ts), so Astro's own heading collector picks them
// up — this is the only depth that maps to a report section's own heading.
const REPORT_SECTION_HEADING_DEPTH = 2
// Auto-generated sr-only "Footnotes" landmark (depth 2, fixed id) — not an
// authored section, so it must be excluded from the nav.
const FOOTNOTES_HEADING_ID = 'footnote-label'

const { slug, contentLocale, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const allReports = await getCollection('reports')
const entry = allReports.find(
  (r) => r.data.pathSlug === slug && r.data.locale === contentLocale
)

if (!entry) throw new Error(`Report not found: ${slug} (${contentLocale})`)

const { Content: MdxContent, headings } = await render(entry)
const { title, heading, description, date, authorBios } = entry.data
const hasBody = Boolean(entry.body?.trim())
const bioTextEntries = authorBios?.filter((bio) => bio.text) ?? []
const hasAuthorBios = bioTextEntries.length > 0
// generateReportMdx/reportIntroHandler guarantee <ReportIntro> is always the
// leading element when present — see ReportIntro.astro's comment for why
// this offsets ReportSectionsNav's grid row below.
const hasIntro = Boolean(entry.body?.trim().startsWith('<ReportIntro'))
// A References ReportSection breaks out to full width (see
// data-report-references-section below), so it no longer occupies a row in
// the narrow nav column — the nav's row span below excludes it. Assumes at
// most one such section (not CMS-enforced); if that's ever violated the
// sticky nav is at worst one grid row off, not broken.
const hasReferencesSection = Boolean(entry.body?.includes('type="References"'))
const sections = headings
  .filter(
    (h) =>
      h.depth === REPORT_SECTION_HEADING_DEPTH &&
      h.slug !== FOOTNOTES_HEADING_ID
  )
  .map((h) => ({ id: h.slug, heading: h.text }))

const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  entry.data.section,
  heading,
  routeLocale,
  t('nav.home')
)

const Layout = getSectionPageLayout(entry.data.section)
---

<Layout title={title} description={description}>
  <main
    class="flex flex-col mx-auto px-lg pt-[calc(var(--spacing-6xl)-var(--site-header-height))] pb-6xl tablet:px-xl desktop:px-5xl desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))] desktop:pb-7xl"
  >
    <TranslationDisclaimer isVisible={isFallback} />
    <div class="max-w-content">
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <h1
        class="text-neutral-900 my-xl text-h2 tablet:my-3xl tablet:text-h2-md desktop:text-h2-lg"
      >
        {heading}
      </h1>
      {
        authorBios?.length > 0 && (
          <div class="mb-xl">
            <AuthorByline authors={authorBios} />
          </div>
        )
      }
      {
        date && (
          <div class="flex items-center gap-sm">
            <time
              datetime={date.publishDate.toISOString()}
              class="text-body-lg-standard text-neutral-900 tablet:text-body-lg-standard-md"
            >
              {t('report.published', {
                date: formatDate(date.publishDate, contentLocale)
              })}
            </time>
            {date.lastUpdated && (
              <>
                <span class="h-6.5 w-px bg-neutral-75" />
                <time
                  datetime={date.lastUpdated.toISOString()}
                  class="text-body-lg-standard text-neutral-75 tablet:text-body-lg-standard-md"
                >
                  {t('report.updated', {
                    date: formatDate(date.lastUpdated, contentLocale)
                  })}
                </time>
              </>
            )}
          </div>
        )
      }
      {
        (hasBody || hasAuthorBios) && (
          <section
            data-prose
            aria-label={t('report.body')}
            class="flex flex-col gap-3xl mt-4xl *:data-footnotes:order-last"
          >
            {sections.length > 0 ? (
              // CSS grid, not flex, so the auto-generated footnotes section
              // (a sibling of <ReportSection> we don't control), the
              // optional <ReportIntro>, a References <ReportSection>, and
              // AuthorBio can all span both columns instead of being
              // squeezed into the content column — MdxContent's children
              // must be direct grid items (no wrapping div) for that
              // breakout to work. When an intro is present it occupies row
              // 1, so the nav's row span starts one row later; a References
              // section doesn't occupy a row in the nav's column at all, so
              // it's excluded from the span. AuthorBio is a grid item here
              // (not rendered after this whole div, like it used to be) so
              // that footnotes' order-last below can push footnotes after
              // it — order only reorders siblings within the same flex/grid
              // container, and footnotes is nested inside this grid, not
              // the outer <section> above.
              <div class="flex flex-col gap-3xl tablet:grid tablet:grid-cols-[4fr_6fr] tablet:gap-x-2xl desktop:grid-cols-[3fr_7fr] desktop:gap-x-4xl tablet:*:data-footnotes:col-span-full *:data-footnotes:order-last *:data-footnotes:mt-2xl *:data-footnotes:desktop:mt-5xl tablet:*:data-report-intro:col-span-full tablet:*:data-report-references-section:col-span-full *:data-report-references-section:mt-2xl *:data-report-references-section:desktop:mt-5xl">
                <div
                  class="hidden tablet:block tablet:col-start-1 tablet:border-r tablet:border-neutral-25 tablet:pr-2xl"
                  style={{
                    gridRow: `${hasIntro ? 2 : 1} / span ${Math.max(1, sections.length - (hasReferencesSection ? 1 : 0))}`
                  }}
                >
                  <ReportSectionsNav
                    sections={sections}
                    uiLocale={routeLocale}
                  />
                </div>
                <MdxContent
                  components={{ ReportIntro, ReportSection, ReportText }}
                />
                {hasAuthorBios && (
                  <div class="tablet:col-span-full">
                    <AuthorBio bios={bioTextEntries} />
                  </div>
                )}
              </div>
            ) : (
              <>
                <MdxContent
                  components={{ ReportIntro, ReportSection, ReportText }}
                />
                {hasAuthorBios && <AuthorBio bios={bioTextEntries} />}
              </>
            )}
          </section>
        )
      }
    </div>
  </main>
</Layout>
