---
import {
  joinPagePath,
  useTranslations,
  summitBaseHref,
  summitYearHref,
  buildHomeBreadcrumb,
  generateSlug,
  getSpeakers,
  getTranslation,
  parseSessionLanguages
} from '@/utils'
import type { Talk } from '@/types/summit'
import SummitPageLayout from '@/layouts/SummitPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import LanguageChip from '@/components/shared/LanguageChip.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import SpeakersList from '@/components/summit/SpeakersList.astro'
import SessionMeta from '@/components/summit/SessionMeta.astro'
import TextParagraphs from '@/components/shared/TextParagraphs.astro'
import VideoEmbed from '@/components/shared/VideoEmbed.astro'

interface Props {
  entry: Talk
  year: string
  isFallback?: boolean
}

const { routeLocale: lang } = Astro.locals
const t = useTranslations(lang)
const { entry, year, isFallback = false } = Astro.props
const speakers = await getSpeakers(year, entry.id)

const baseHref = summitBaseHref(lang)
const sessionsHref = joinPagePath(baseHref, year, 'talks')
const speakersBasePath = joinPagePath(baseHref, year, 'speakers')

const translation = getTranslation(entry, lang)
const title = translation?.title ?? entry.title
const description = translation?.description ?? entry.description
const languages = parseSessionLanguages(entry.translations)
const listFormat = new Intl.ListFormat(lang, { type: 'conjunction' })
// TranslationDisclaimer only renders on the ES route, so match it here to
// keep an empty notice row out of the EN page.
const showFallbackNotice = isFallback && lang === 'es'
const hasNotices = showFallbackNotice || languages.translatedTo.length > 0
// The notices sit under the breadcrumbs up to tablet and beside them on
// desktop, where Breadcrumbs' own row layout would start at tablet.
const breadcrumbRowClass =
  'gap-lg tablet:flex-col tablet:items-start tablet:gap-lg desktop:flex-row desktop:items-center'

const breadcrumbs = [
  buildHomeBreadcrumb(lang, t),
  { name: t('summit.summit_name', { year }), href: summitYearHref(year, lang) },
  { name: t('summit.sessions'), href: sessionsHref },
  { name: title, href: joinPagePath(sessionsHref, generateSlug(entry.title)) }
]
---

<SummitPageLayout title={entry.title}>
  <main class="px-content pt-page-offset pb-5xl desktop:pb-6xl">
    <div class="content-column">
      <!-- Tablet keeps a narrow reading column; desktop uses the full width. -->
      <div class="mx-auto max-w-180 desktop:max-w-none">
        <Breadcrumbs breadcrumbs={breadcrumbs} class={breadcrumbRowClass}>
          {hasNotices && <div class="flex flex-wrap gap-sm">
            <TranslationDisclaimer
              isVisible={showFallbackNotice}
              style="summit"
            />
            {languages.translatedTo.length > 0 && <LanguageChip>
              {t('summit.translation_available', {
                language: listFormat.format(languages.translatedTo)
              })}
            </LanguageChip>}
          </div>}
        </Breadcrumbs>
        <article>
          <header class="mb-2xl tablet:mb-3xl">
            <h1
              class="mb-xl text-h2 text-neutral-900 tablet:text-h2-md desktop:text-h2-lg dark:text-neutral-0"
            >
              {title}
            </h1>
            <SessionMeta talk={entry} languages={languages} lang={lang} />
          </header>
          <div class="flex flex-col gap-lg">
            {entry.recordingUrl && <section
              aria-label={t('summit.session_recording')}
            >
              <VideoEmbed url={entry.recordingUrl} title={entry.title} />
            </section>}
            {description && <section
              class="rounded-3xl bg-pistachio-100 p-xl [&_p]:text-h5 [&_p]:text-neutral-900 tablet:[&_p]:text-h5-md desktop:[&_p]:text-h5-lg [&_p:last-child]:mb-0"
              aria-label={t('summit.session_description')}
            >
              <TextParagraphs text={description} />
            </section>}
          </div>
          {speakers.length > 0 && <section
            class="mt-3xl border-t border-neutral-50 pt-3xl desktop:mt-4xl desktop:pt-4xl"
            aria-labelledby="session-speakers"
          >
            <h2
              id="session-speakers"
              class="mb-2xl text-h3 text-neutral-900 tablet:text-h3-md desktop:text-h3-lg dark:text-neutral-0"
            >
              {t('summit.speakers')}
            </h2>
            <SpeakersList
              speakers={speakers}
              basePath={speakersBasePath}
              layout="stack"
              headingLevel={3}
            />
          </section>}
        </article>
      </div>
    </div>
  </main>
</SummitPageLayout>
