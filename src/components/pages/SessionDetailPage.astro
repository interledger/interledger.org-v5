---
import {
  localizeRoute,
  joinPagePath,
  useTranslations,
  currentSummitYear,
  getSpeakers,
  getTranslation
} from '@/utils'
import type { Talk } from '@/types/summit'
import SummitPageLayout from '@/layouts/SummitPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import SpeakersList from '@/components/summit/SpeakersList.astro'
import SessionSubheader from '@/components/summit/SessionSubheader.astro'
import TextParagraphs from '@/components/shared/TextParagraphs.astro'
import VideoEmbed from '@/components/shared/VideoEmbed.astro'

interface Props {
  entry: Talk
  year: string
  isFallback?: boolean
}

const { routeLocale: lang, currentBasePath } = Astro.locals
const t = useTranslations(lang)
const { entry, year, isFallback = false } = Astro.props
const speakers = await getSpeakers(year, entry.id)

// the path for current summit is /summit/, instead of /summit/{year}/
const baseHref = localizeRoute(currentBasePath, lang)
const isCurrentYear = currentSummitYear === year
const summitHref = joinPagePath(baseHref, isCurrentYear ? '' : year)
const sessionsHref = joinPagePath(baseHref, year, 'talks')
const speakersBasePath = joinPagePath(baseHref, year, 'speakers')

const translation = getTranslation(entry, lang)
const title = translation?.title ?? entry.title
const description = translation?.description ?? entry.description

const breadcrumbs = [
  {
    name: t('summit.summit_name', { year }),
    href: summitHref
  },
  {
    name: t('summit.sessions'),
    href: sessionsHref
  }
]
---

<SummitPageLayout title={entry.title}>
  <main class="px-content pt-page-offset pb-4xl">
    <div class="content-column">
      <Breadcrumbs breadcrumbs={breadcrumbs}>
        <TranslationDisclaimer isVisible={isFallback} style="summit" />
      </Breadcrumbs>
      <article>
        <header class="mb-2xl">
          <h1 class="text-neutral-900">{title}</h1>
          <SessionSubheader talk={entry} lang={lang} />
        </header>
        {entry.recordingUrl && <section
          class="mb-2xl"
          aria-label={t('summit.session_recording')}
        >
          <VideoEmbed url={entry.recordingUrl} title={entry.title} />
        </section>}
        <div class="flex flex-col gap-2xl desktop:flex-row desktop:items-start">
          <section
            class="min-w-0 flex-1"
            aria-label={t('summit.session_description')}
          >
            <TextParagraphs text={description} />
          </section>
          <aside
            class="desktop:w-72 desktop:shrink-0"
            aria-label={t('summit.speakers')}
          >
            <SpeakersList
              speakers={speakers}
              basePath={speakersBasePath}
              extraClass="flex-col"
              year={year}
            />
          </aside>
        </div>
      </article>
    </div>
  </main>
</SummitPageLayout>
