---
import FaqPage from './FaqPage.astro'
import GrantOverviewPage from './GrantOverviewPage.astro'
import GrantPage from './GrantPage.astro'
import ProfileDetailPage from './ProfileDetailPage.astro'
import ReportPage from './ReportPage.astro'
import type { Locale, SiteSection } from '@/utils'

interface Props {
  kind: string
  slug: string
  contentLocale: Locale
  // Only 'profile'/'faq'/'report' entries carry a section (getCrossSectionPaths
  // attaches it; getLocalizedPaths's plain 'page' entries don't), so callers
  // may not have one to pass — the non-null assertions below encode that the
  // three branches that need it only ever match when it's present.
  section?: SiteSection
  isFallback?: boolean
}

const { kind, slug, contentLocale, section, isFallback } = Astro.props
const commonProps = { slug, contentLocale, isFallback }
---

{
  kind === 'profile' ? (
    <ProfileDetailPage section={section!} {...commonProps} />
  ) : kind === 'faq' ? (
    <FaqPage section={section!} {...commonProps} />
  ) : kind === 'report' ? (
    <ReportPage section={section!} {...commonProps} />
  ) : kind === 'grant-page' ? (
    <GrantPage {...commonProps} />
  ) : kind === 'grant-overview-page' ? (
    <GrantOverviewPage {...commonProps} />
  ) : (
    <slot />
  )
}
