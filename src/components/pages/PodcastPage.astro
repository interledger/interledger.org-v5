---
import type { Page } from 'astro'
import {
  useTranslations,
  localizeRoute,
  stripPagination,
  translateTerm,
  PODCAST_PAGE_SLUG
} from '@/utils'
import type { PodcastPageData } from '@/utils'
import type { Podcast } from '@/types/podcast'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import PageHero from '@/components/shared/PageHero.astro'
import PodcastList from '@/components/shared/PodcastList.astro'
import Pagination from '@/components/shared/Pagination.astro'
import TaxonomyFilter from '@/components/shared/TaxonomyFilter.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'

interface Props {
  page: Page<Podcast>
  podcastPage: PodcastPageData
  isFallback?: boolean
  allTerms?: string[]
  selectedTerm?: string
}

const {
  page,
  podcastPage,
  isFallback = false,
  allTerms = [],
  selectedTerm
} = Astro.props
// Nav chrome always follows the URL locale — ES routes can fall back to EN
// content while staying under /es/.
const { routeLocale } = Astro.locals

const {
  title,
  description,
  heroTitle,
  heroDescription,
  heroImage,
  heroImageAlt,
  heroImageMobile,
  heroImageMobileAlt,
  heroCtas,
  titleCards,
  ctaStrip
} = podcastPage

const t = useTranslations(routeLocale)
const basePath = stripPagination(Astro.url.pathname)
const podcastPath = localizeRoute(PODCAST_PAGE_SLUG, routeLocale)

const translatedTerm = selectedTerm
  ? translateTerm('podcast.categories', selectedTerm, t)
  : undefined
const pageTitle = translatedTerm
  ? t('podcast.tag_title', { tag: translatedTerm })
  : title
const pageDescription = translatedTerm
  ? t('podcast.tag_description', { tag: translatedTerm })
  : description

const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  { name: heroTitle ?? title, href: podcastPath }
]
---

<FoundationPageLayout title={pageTitle} description={pageDescription}>
  <main class="pb-3xl">
    <TranslationDisclaimer isVisible={isFallback} />

    <PageHero
      title={heroTitle ?? title}
      description={heroDescription ?? description}
      image={heroImage}
      imageAlt={heroImageAlt}
      imageMobile={heroImageMobile}
      imageMobileAlt={heroImageMobileAlt}
      cta={heroCtas?.[0]}
      breadcrumbs={breadcrumbs}
    />

    {
      page.currentPage === 1 && !selectedTerm && (
        <section class="py-4xl">
          <div class="mx-auto max-w-content px-lg min-w-90 tablet:px-xl desktop:max-w-content">
            <CardGrid
              ariaLabel={titleCards.ariaLabel}
              columns={titleCards.columns}
              variant="Title"
              titleCards={titleCards.cards}
            />
          </div>
        </section>
      )
    }

    <section
      aria-label={t('aria.podcast.filters_label')}
      class="px-lg min-w-90 mb-3xl tablet:px-xl tablet:mb-4xl"
    >
      <div class="mx-auto max-w-content desktop:max-w-content">
        <TaxonomyFilter
          collection="podcast-pages"
          terms={allTerms}
          selectedTerm={selectedTerm}
          href={podcastPath}
        />
      </div>
    </section>

    <section class="py-4xl">
      <div
        class="mx-auto max-w-content px-lg min-w-90 tablet:px-xl desktop:max-w-content"
      >
        <PodcastList podcasts={page.data} />
        <Pagination
          baseUrl={basePath}
          length={page.lastPage}
          currentPage={page.currentPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          label={heroTitle ?? title}
          class="mt-3xl tablet:mt-4xl desktop:mt-5xl"
        />
      </div>
    </section>

    <section class="tablet:py-4xl">
      <div
        class="mx-auto max-w-content px-lg min-w-90 tablet:px-xl desktop:max-w-content"
      >
        <CtaStrip
          heading={ctaStrip.heading}
          description={ctaStrip.description}
          primaryButtonText={ctaStrip.buttonText}
          primaryButtonLink={ctaStrip.buttonLink}
          secondaryButtonText={ctaStrip.secondaryButtonText}
          secondaryButtonLink={ctaStrip.secondaryButtonLink}
        />
      </div>
    </section>
  </main>
</FoundationPageLayout>
