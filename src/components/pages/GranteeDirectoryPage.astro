---
import type { Page } from 'astro'
import '@/styles/tailwind.css'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import GranteeIndex from '@/components/grant/GranteeIndex.astro'
import Pagination from '@/components/shared/Pagination.astro'
import {
  type Grantee,
  type GranteeFilterOption,
  useTranslations,
  localizeRoute,
  grantOverviewHubPath,
  grantGranteeDirectoryPath,
  stripPagination
} from '@/utils'

interface Props {
  page: Page<Grantee>
  years: GranteeFilterOption[]
  tags: GranteeFilterOption[]
  selectedYear?: string
  selectedTag?: string
}

const { page, years, tags, selectedYear, selectedTag } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const pageHref = localizeRoute(grantGranteeDirectoryPath(), routeLocale)
const basePath = stripPagination(Astro.url.pathname)
const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  {
    name: t('nav.grants'),
    href: localizeRoute(grantOverviewHubPath(), routeLocale)
  },
  { name: t('grantee.title'), href: pageHref }
]
---

<FoundationPageLayout
  title={t('grantee.title')}
  description={t('grantee.meta_description')}
>
  <main
    class="flex flex-col px-content pb-section pt-[calc(var(--spacing-5xl)-var(--site-header-height))] tablet:pt-[calc(var(--spacing-6xl)-var(--site-header-height))] desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))]"
  >
    <div class="w-full max-w-content m-auto">
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <GranteeIndex
        grantees={page.data}
        years={years}
        tags={tags}
        totalCount={page.total}
        directoryPath={pageHref}
        selectedYear={selectedYear}
        selectedTag={selectedTag}
      />
      {
        page.lastPage > 1 && (
          <Pagination
            baseUrl={basePath}
            length={page.lastPage}
            currentPage={page.currentPage}
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
            label={t('grantee.title')}
            class="mt-section"
          />
        )
      }
      <footer
        role="note"
        aria-label={t('grantee.caveat.label')}
        class="mt-5xl border-t border-neutral-25 pt-xl text-caption leading-normal text-neutral-75 tablet:mt-6xl tablet:pt-2xl [&_p]:text-caption [&_p]:leading-normal"
      >
        <p class="m-0 mb-md">{t('grantee.caveat.amounts')}</p>
        <p class="m-0">{t('grantee.caveat.exclusions')}</p>
      </footer>
    </div>
  </main>
</FoundationPageLayout>
