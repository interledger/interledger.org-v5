---
import { getCollection, render } from 'astro:content'
import HackathonPageLayout from '@/layouts/HackathonPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import InfoCard from '@/components/shared/InfoCard.astro'
import NumberTiles from '@/components/blocks/NumberTiles.astro'
import Agenda from '@/components/blocks/Agenda.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import TitleCard from '@/components/shared/TitleCard.astro'
import Faq from '@/components/blocks/Faq.astro'
import CtaButtons from '@/components/blocks/CtaButtons.astro'
import FaqItem from '@/components/shared/FaqItem.astro'
import EventCard from '@/components/blocks/EventCard.astro'
import EventWhen from '@/components/shared/EventWhen.astro'
import EventWhere from '@/components/shared/EventWhere.astro'
import EventApply from '@/components/shared/EventApply.astro'
import Quote from '@/components/blocks/Quote.astro'
import ProfileGrid from '@/components/shared/ProfileGrid.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import ResourceCard from '@/components/shared/ResourceCard.astro'
import NavigationCard from '@/components/shared/NavigationCard.astro'
import HackathonHero from '@/components/pages/HackathonHero.astro'
import {
  type Locale,
  useTranslations,
  buildSectionEntryBreadcrumbs,
  isDemoPathSlug
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const pages = await getCollection('hackathon-pages')
const entry = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!entry) return Astro.redirect('/404')

Astro.locals.profileEntries = await getCollection('profiles')

const { Content: MdxContent } = await render(entry)
const {
  title,
  description,
  heroTitle,
  heroDescription,
  heroImage,
  heroImageAlt,
  heroImageMobile,
  heroImageMobileAlt,
  heroCtas
} = entry.data
const hasHero = Boolean(heroTitle?.trim())

// hackathon-pages is a fixed-section collection (no `section` frontmatter
// field, unlike the cross-section faq/report/profile collections) — every
// entry belongs to the hackathon microsite, so the section is hardcoded here.
const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  'hackathon',
  title,
  routeLocale,
  t('nav.home')
)
const showBreadcrumbs = entry.data.pathSlug !== 'overview'
const noindex = isDemoPathSlug(entry.data.pathSlug)
---

<HackathonPageLayout title={title} description={description} noindex={noindex}>
  <main
    class="hackathon-content flex flex-col pb-5xl text-neutral-50 tablet:pb-6xl desktop:pb-7xl"
  >
    {
      hasHero && (
        <HackathonHero
          title={heroTitle!}
          description={heroDescription}
          image={heroImage}
          imageAlt={heroImageAlt}
          imageMobile={heroImageMobile}
          imageMobileAlt={heroImageMobileAlt}
          cta={heroCtas?.[0]}
          pageLang={contentLocale}
        />
      )
    }
    <section class="py-4xl">
      <div class="mx-auto max-w-content min-w-[360px] max-[1324px]:px-[5%]">
        <TranslationDisclaimer isVisible={isFallback} />
        {showBreadcrumbs && <Breadcrumbs breadcrumbs={breadcrumbs} />}
        {
          !hasHero && (
            <h1 class="mt-2xl text-h2 text-neutral-0 tablet:text-h2-md desktop:text-h2-lg">
              {title}
            </h1>
          )
        }
        <div
          data-prose
          class="[&_h1]:text-neutral-0 [&_h2]:mb-xl [&_h2]:text-h2 [&_h2]:font-semibold [&_h2]:text-neutral-0 tablet:[&_h2]:text-h2-md desktop:[&_h2]:text-h2-lg [&_h3]:mt-2xl [&_h3]:mb-lg [&_h3]:text-[1.25rem] [&_h3]:font-semibold [&_h3]:text-neutral-0 [&_h4]:text-neutral-0 [&_h5]:text-neutral-0 [&_h6]:text-neutral-0 [&_p]:mb-xl [&_p]:leading-[1.6] [&_p]:text-neutral-50 [&_ul]:mb-xl [&_ul]:ps-2xl [&_ul_li]:mb-lg [&_a:not([data-component='LinkButton'])]:underline [&_a:not([data-component='LinkButton']):hover]:no-underline"
        >
          <MdxContent
            components={{
              Paragraph,
              InfoCard,
              NumberTiles,
              Agenda,
              SplitLayout,
              CtaStrip,
              TitleCard,
              CardGrid,
              ResourceCard,
              NavigationCard,
              Faq,
              CtaButtons,
              FaqItem,
              EventCard,
              EventWhen,
              EventWhere,
              EventApply,
              Quote,
              ProfileGrid,
              LogoCarousel
            }}
          />
        </div>
      </div>
    </section>
  </main>
</HackathonPageLayout>

<style>
  .hackathon-content {
    color: var(--color-neutral-50);
  }

  /* MDX paragraphs are not scoped to this file, so :global is required.
     Scoped to [data-prose] so the hero description stays apricot. */
  .hackathon-content :global([data-prose] p) {
    color: var(--color-neutral-50);
  }
</style>
