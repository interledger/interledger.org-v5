---
import { getCollection, render } from 'astro:content'
import HackathonPageLayout from '@/layouts/HackathonPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import InfoCard from '@/components/shared/InfoCard.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import TitleCard from '@/components/shared/TitleCard.astro'
import ProfileGrid from '@/components/shared/ProfileGrid.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import ResourceCard from '@/components/shared/ResourceCard.astro'
import NavigationCard from '@/components/shared/NavigationCard.astro'
import {
  type Locale,
  useTranslations,
  buildSectionEntryBreadcrumbs
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const pages = await getCollection('hackathon-pages')
const entry = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!entry) return Astro.redirect('/404')

Astro.locals.profileEntries = await getCollection('profiles')

const { Content: MdxContent } = await render(entry)
const { title, description } = entry.data

// hackathon-pages is a fixed-section collection (no `section` frontmatter
// field, unlike the cross-section faq/report/profile collections) — every
// entry belongs to the hackathon microsite, so the section is hardcoded here.
const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  'hackathon',
  title,
  routeLocale,
  t('nav.home')
)
---

<HackathonPageLayout title={title} description={description}>
  <main
    class="hackathon-content flex flex-col px-lg pt-[calc(var(--spacing-5xl)-var(--site-header-height))] pb-5xl text-neutral-0 tablet:px-xl tablet:pt-[calc(var(--spacing-6xl)-var(--site-header-height))] tablet:pb-6xl desktop:px-5xl desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))] desktop:pb-7xl"
  >
    <TranslationDisclaimer isVisible={isFallback} />
    <div class="mx-auto max-w-content">
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <h1
        class="mt-2xl text-h2 text-neutral-0 tablet:text-h2-md desktop:text-h2-lg"
      >
        {title}
      </h1>
      <section
        data-prose
        class="mt-2xl [&_h2]:mt-3xl [&_h2]:mb-xl [&_h2]:text-[1.75rem] [&_h2]:font-semibold [&_h3]:mt-2xl [&_h3]:mb-lg [&_h3]:text-[1.25rem] [&_h3]:font-semibold [&_p]:mb-xl [&_p]:leading-[1.6] [&_ul]:mb-xl [&_ul]:ps-2xl [&_li]:mb-lg [&_a]:underline [&_a:hover]:no-underline"
      >
        <MdxContent
          components={{
            Paragraph,
            InfoCard,
            SplitLayout,
            TitleCard,
            CardGrid,
            ResourceCard,
            NavigationCard,
            ProfileGrid,
            LogoCarousel
          }}
        />
      </section>
    </div>
  </main>
</HackathonPageLayout>

<style>
  .hackathon-content {
    color: var(--color-neutral-0);
  }

  .hackathon-content
    :where(p, ul, ol, blockquote, h1, h2, h3, h4, h5, h6):not(
      [data-component='CardGrid'] *
    ):not(section[aria-labelledby='logo-carousel-heading'] *) {
    color: var(--color-neutral-0);
  }
</style>
