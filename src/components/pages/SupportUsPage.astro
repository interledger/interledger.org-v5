---
/**
 * /support-us — the Fundraise Up donation page (INTORG-1247).
 *
 * Astro-only by design: the copy is campaign material owned by Fundraising,
 * not editor-managed content, and the page has no Strapi model behind it.
 *
 * The Fundraise Up install script is scoped to this page via the layout's
 * `head` slot rather than living in `BaseLayout`, so no other route pays for
 * a third-party bundle. See `FundraiseUpScript.astro` for what moving it
 * site-wide would buy and cost.
 */
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import PageHero from '@/components/shared/PageHero.astro'
import Section from '@/components/shared/Section.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import Faq from '@/components/blocks/Faq.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import FaqItem from '@/components/shared/FaqItem.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import { faqAccordionGroupName } from '@/scripts/faq-accordion'
import FundraiseUpScript from '@/components/support/FundraiseUpScript.astro'
import FundraiseUpElement from '@/components/support/FundraiseUpElement.astro'
import FoundingCircleCard from '@/components/support/FoundingCircleCard.astro'
import {
  useTranslations,
  localizeRoute,
  translatePath,
  type BreadcrumbItem
} from '@/utils'

interface Props {
  /**
   * Runs checkout in Fundraise Up test mode. Set from a route so a QA-only
   * copy of this page can exist without touching the live one.
   */
  testMode?: boolean
}

const { testMode = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const SUPPORT_ROUTE = 'support-us'

/**
 * Fundraise Up Element IDs (Dashboard -> Elements, account APUEUABQ).
 * Named rather than inlined so a dashboard change is a one-line edit here
 * instead of a hunt through the markup.
 */
const FUNDRAISE_UP_ELEMENTS = {
  sustaining: 'XVSHSPQU',
  champions: 'XMWLAVRZ'
} as const

/** Booking link for the Visionaries tier — a conversation, not a checkout. */
const VISIONARY_MEETING_URL = 'https://meetings-eu1.hubspot.com/jesse-ward'
const GIVING_EMAIL = 'giving@interledger.org'

/**
 * The draft copy calls for a "Read our Case for Support" CTA twice, but the
 * document it points at does not exist yet — there is no `case-for-support`
 * entry in `foundation-pages` and no PDF in `public/documents`. Shipping the
 * button anyway would put a 404 on the page whose entire job is looking
 * trustworthy, so the CTA renders only once this is a real URL. Set it to the
 * page path or the document path when Jesse provides one.
 */
const CASE_FOR_SUPPORT_URL: string | null = null

/**
 * Stand-ins until Radu supplies artwork (INTORG-1252). SVG on purpose: the
 * encoder skips SVGs by design, so a placeholder needs no optimized variants
 * and no entry in the deployed-sources catalog to render correctly in either
 * image mode.
 *
 * Both are `alt=""` because a placeholder carries no information a screen
 * reader should hear. Swapping in the real images means writing real alt text
 * at the same time.
 */
const PLACEHOLDER_IMAGES = {
  why: '/img/support/placeholder-why.svg',
  waysToDonate: '/img/support/placeholder-ways-to-donate.svg'
} as const

/**
 * Seat counts are static copy: Fundraise Up exposes no seats-remaining value
 * we could bind to, so these need a manual edit as circles fill. Flagged for
 * Jesse in the PR — a stale "50 of 50" reads worse than no counter at all.
 */
const circles = [
  {
    heading: t('support.circle.sustaining.heading'),
    seats: t('support.circle.seats', { available: 50, total: 50 }),
    amount: t('support.circle.sustaining.amount'),
    summary: t('support.circle.sustaining.summary'),
    benefits: t('support.circle.sustaining.benefits'),
    elementId: FUNDRAISE_UP_ELEMENTS.sustaining
  },
  {
    heading: t('support.circle.champions.heading'),
    seats: t('support.circle.seats', { available: 10, total: 10 }),
    amount: t('support.circle.champions.amount'),
    summary: t('support.circle.champions.summary'),
    benefits: t('support.circle.champions.benefits'),
    elementId: FUNDRAISE_UP_ELEMENTS.champions
  },
  {
    heading: t('support.circle.visionaries.heading'),
    seats: t('support.circle.seats', { available: 3, total: 3 }),
    amount: t('support.circle.visionaries.amount'),
    summary: t('support.circle.visionaries.summary'),
    benefits: t('support.circle.visionaries.benefits'),
    elementId: null
  }
] as const

const priorities = [
  {
    term: t('support.priorities.cdfi.term'),
    description: t('support.priorities.cdfi.description')
  },
  {
    term: t('support.priorities.colombia.term'),
    description: t('support.priorities.colombia.description')
  },
  {
    term: t('support.priorities.cofunding.term'),
    description: t('support.priorities.cofunding.description')
  },
  {
    term: t('support.priorities.community.term'),
    description: t('support.priorities.community.description')
  },
  {
    term: t('support.priorities.policy.term'),
    description: t('support.priorities.policy.description')
  }
]

const faqs = [
  {
    question: t('support.faq.tax.question'),
    answer: t('support.faq.tax.answer')
  },
  {
    question: t('support.faq.funding.question'),
    answer: t('support.faq.funding.answer')
  },
  {
    question: t('support.faq.circles.question'),
    answer: t('support.faq.circles.answer')
  },
  {
    question: t('support.faq.crypto.question'),
    answer: t('support.faq.crypto.answer')
  },
  {
    question: t('support.faq.finances.question'),
    answer: t('support.faq.finances.answer')
  },
  {
    question: t('support.faq.involved.question'),
    answer: t('support.faq.involved.answer')
  }
]

/**
 * `Faq` publishes its group name through `Astro.locals` for MDX-slotted
 * children, but children slotted from an `.astro` parent are evaluated before
 * that assignment runs — each `FaqItem` then mints its own group and the
 * native exclusive-close behaviour is lost with JS off. Minting the name here
 * and passing it down is the supported way out (see `FaqItem`'s `group` prop).
 */
const faqGroup = faqAccordionGroupName()

const breadcrumbs: BreadcrumbItem[] = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  { name: t('support.title'), href: localizeRoute(SUPPORT_ROUTE, routeLocale) }
]

const communityHref = translatePath(
  'foundation-pages',
  routeLocale,
  'community'
)

/**
 * Every `support.*` key is English-only for now (INTORG-1247 ships with EN
 * fallback copy), so an `/es/` visitor is reading English. ADR-002 says to
 * surface the disclaimer whenever the page itself renders fallback content —
 * and on a page asking people for money, saying so plainly matters more than
 * it does elsewhere. Delete this once the Spanish copy lands.
 */
const isSpanishFallback = routeLocale === 'es'

const headingClass =
  'm-0 mb-block-heading text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-900'
const bodyClass =
  'text-body-lg-standard tablet:text-body-lg-standard-md text-neutral-100'
---

<FoundationPageLayout
  title={t('support.title')}
  description={t('support.description')}
>
  <FundraiseUpScript slot="head" testMode={testMode} />

  <main class="page-stack pb-section" data-umami-component="support-us-page">
    <PageHero
      title={t('support.hero.heading')}
      description={t('support.hero.intro')}
      breadcrumbs={breadcrumbs}
    >
      <TranslationDisclaimer
        slot="after-breadcrumbs"
        isVisible={isSpanishFallback}
      />
    </PageHero>

    <Section aria-labelledby="why-heading">
      <SplitLayout
        imageSrc={PLACEHOLDER_IMAGES.why}
        imageAlt=""
        imagePosition="right"
        displayRatio="1:1"
        ctaText={CASE_FOR_SUPPORT_URL ? t('support.why.cta') : undefined}
        ctaLink={CASE_FOR_SUPPORT_URL ?? undefined}
        ctaStyle="secondary"
      >
        <h2 id="why-heading" class={headingClass}>
          {t('support.why.heading')}
        </h2>
        <p class={`mb-2xl ${bodyClass}`}>{t('support.why.body_1')}</p>
        <p class={`mb-2xl ${bodyClass}`}>{t('support.why.body_2')}</p>
        <p class={`mb-0 ${bodyClass}`}>{t('support.why.body_3')}</p>
      </SplitLayout>
    </Section>

    <Section aria-labelledby="circles-heading">
      <h2 id="circles-heading" class={headingClass}>
        {t('support.circles.heading')}
      </h2>
      <p class={`mb-2xl ${bodyClass}`}>{t('support.circles.body_1')}</p>
      <p class={`mb-2xl ${bodyClass}`}>{t('support.circles.body_2')}</p>
      <p
        class="mb-block-heading text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-900"
      >
        {t('support.circles.body_3')}
      </p>

      <ul
        class="m-0 grid list-none grid-cols-1 gap-xl p-0 tablet:grid-cols-3"
        role="list"
      >
        {
          circles.map((circle) => (
            <li class="m-0 flex">
              <FoundingCircleCard
                heading={circle.heading}
                seats={circle.seats}
                amount={circle.amount}
                summary={circle.summary}
                benefits={circle.benefits}
                benefitsLabel={t('support.circle.benefits_label')}
              >
                <Fragment slot="cta">
                  {circle.elementId ? (
                    <FundraiseUpElement elementId={circle.elementId} />
                  ) : (
                    <LinkButton
                      href={VISIONARY_MEETING_URL}
                      external
                      variant="primary"
                      class="w-full"
                      linkText={t('support.circle.visionaries.cta')}
                      umamiLabel="button_card"
                      umamiBaseComponent="founding_circle_visionaries"
                    >
                      {t('support.circle.visionaries.cta')}
                      <Icon name="external-link" slot="icon-right" />
                    </LinkButton>
                  )}
                </Fragment>
              </FoundingCircleCard>
            </li>
          ))
        }
      </ul>
    </Section>

    <!--
      Sits between the two gaps the stack offers: `data-stack="cta"` alone
      (32px) crowded the cards, the full section gap (64/80/120px) pushed this
      too far from them. Padding tops the 32px up to 48px without fighting
      `page-stack` on specificity, which a margin utility here would.
    -->
    <Section data-stack="cta" class="text-center pt-lg">
      <p class={`mb-xl ${bodyClass}`}>{t('support.community.body')}</p>
      <!--
        `text-center` on the section centres the copy and, because the button
        is an inline-flex anchor, centres it too — no extra flex wrapper. It
        stays full-width on mobile, where a centred pill would look stranded.
      -->
      <LinkButton
        href={communityHref}
        variant="secondary"
        class="w-full tablet:w-auto"
        linkText={t('support.community.cta')}
        umamiLabel="button_cta"
        umamiBaseComponent="community_membership"
      >
        {t('support.community.cta')}
        <Icon name="arrow-right" slot="icon-right" />
      </LinkButton>
    </Section>

    <Section aria-labelledby="priorities-heading">
      <h2 id="priorities-heading" class={headingClass}>
        {t('support.priorities.heading')}
      </h2>
      <p class={`mb-2xl ${bodyClass}`}>{t('support.priorities.body')}</p>

      <div>
        <h3
          class="mb-xl text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-900"
        >
          {t('support.priorities.subheading')}
        </h3>
        <!--
          A definition list, not a bulleted list: each row is a named priority
          paired with its explanation, which is exactly what <dl> encodes.

          The term carries h5 type so it reads as the heading of its row rather
          than as bold body copy, and the description sits at the page's body
          size — the pair has to stay legible as one unit, so sizing the term
          up without the description would leave the two visibly mismatched.
        -->
        <dl class="mb-0 flex flex-col gap-xl">
          {
            priorities.map((priority) => (
              <div>
                <dt class="mb-xs text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-900">
                  {priority.term}
                </dt>
                <dd class="m-0 text-body-lg-standard tablet:text-body-lg-standard-md text-neutral-75">
                  {priority.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Section>

    <Section id="ways-to-donate" aria-labelledby="ways-heading">
      <!--
        Image on the left here and on the right in "Why We're Raising Funds",
        so the two split sections alternate rather than stacking two identical
        layouts down the page.
      -->
      <SplitLayout
        imageSrc={PLACEHOLDER_IMAGES.waysToDonate}
        imageAlt=""
        imagePosition="left"
        displayRatio="1:1"
      >
        <h2 id="ways-heading" class={headingClass}>
          {t('support.ways.heading')}
        </h2>
        <p class={`mb-2xl ${bodyClass}`}>{t('support.ways.body')}</p>
        <p class={`mb-lg ${bodyClass}`}>{t('support.ways.check_intro')}</p>
        <!--
          `<address>` is the correct element for contact details of the nearest
          article or the document as a whole, which is what this is.
          `not-italic` undoes the UA default so it matches the surrounding copy.
        -->
        <address
          class="mb-0 not-italic text-body-lg-emphasis tablet:text-body-lg-emphasis-md text-neutral-900"
          aria-label={t('support.ways.address_label')}
        >
          Interledger Foundation<br />
          PO Box 860991<br />
          Minneapolis, MN 55486-0991
        </address>
      </SplitLayout>
    </Section>

    <Section>
      {/* `Faq` renders its own <h2> and labels the region from it. */}
      <Faq heading={t('support.faq.heading')}>
        {
          faqs.map((faq) => (
            <FaqItem question={faq.question} group={faqGroup}>
              <p>{faq.answer}</p>
            </FaqItem>
          ))
        }
        <FaqItem question={t('support.faq.contact.question')} group={faqGroup}>
          <p>{t('support.faq.contact.answer')}</p>
          <p>
            <a href={`mailto:${GIVING_EMAIL}`}>
              {t('support.faq.contact.email_cta')}
            </a>
          </p>
          <p>
            <a
              href={VISIONARY_MEETING_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('support.faq.contact.meeting_cta')}
            </a>
          </p>
        </FaqItem>
      </Faq>
    </Section>
  </main>
</FoundationPageLayout>

<script>
  import { initFundraiseUpAnalytics } from '@/scripts/fundraiseup-analytics'

  initFundraiseUpAnalytics()
</script>
