---
import { getCollection } from 'astro:content'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import FaqSections from '@/components/faq/FaqSections.astro'
import {
  type Locale,
  type SiteSection,
  useTranslations,
  buildSectionEntryBreadcrumbs,
  parseMarkdown,
  getSectionPageLayout
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  section: SiteSection
  isFallback?: boolean
}

const { slug, contentLocale, section, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const allFaqs = await getCollection('faqs')
const entry = allFaqs.find(
  (f) =>
    f.data.pathSlug === slug &&
    f.data.locale === contentLocale &&
    f.data.section === section
)

if (!entry) throw new Error(`Faq not found: ${slug} (${contentLocale})`)

const { title, heading, description, introParagraph, faqSections } = entry.data
const introParagraphHtml = introParagraph
  ? await parseMarkdown(introParagraph, {
      pathname: Astro.url.pathname,
      lang: contentLocale
    })
  : null

const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  section,
  heading,
  routeLocale,
  t('nav.home')
)

const Layout = getSectionPageLayout(section)
---

<Layout title={title} description={description}>
  <main
    class="px-content pb-section flex flex-col pt-[calc(var(--spacing-5xl)-var(--site-header-height))] desktop:pt-[calc(var(--spacing-6xl)-var(--site-header-height-desktop))]"
  >
    <div class="content-column">
      <Breadcrumbs breadcrumbs={breadcrumbs}>
        <TranslationDisclaimer isVisible={isFallback} />
      </Breadcrumbs>
      <h1
        class="text-neutral-900 text-h2 mt-xl tablet:mt-3xl tablet:text-h2-md desktop:text-h2-lg dark:text-neutral-0"
      >
        {heading}
      </h1>
      {
        introParagraphHtml && (
          <section
            aria-label={t('faq.introduction')}
            class="mt-xl tablet:mt-3xl"
          >
            <div
              class="text-neutral-100 dark:text-neutral-50 [&_p]:text-h4 [&_p]:tablet:text-h4-md [&_p]:desktop:text-h5-lg"
              set:html={introParagraphHtml}
            />
          </section>
        )
      }
      <section class="mt-section">
        <FaqSections sections={faqSections} uiLocale={routeLocale} />
      </section>
    </div>
  </main>
</Layout>
