---
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import RoadmapBoard from '@/components/roadmap/RoadmapBoard.astro'
import {
  useTranslations,
  roadmapWindow,
  projectOverlapsWindow,
  buildUmamiAttrs,
  localizeRoute,
  PAGE_TOP_OFFSET_CLASS,
  type BreadcrumbItem
} from '@/utils'
import type { Snapshot } from '@/types/roadmap'

interface Props {
  snapshot: Snapshot | null
  isFallback?: boolean
}

const { snapshot, isFallback = false } = Astro.props
const projects = snapshot?.projects ?? []
const teams = snapshot?.teams ?? []
const generatedAt = snapshot?.generatedAt ?? null
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const breadcrumbs: BreadcrumbItem[] = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  { name: t('roadmap.title'), href: localizeRoute('tech/roadmap', routeLocale) }
]

// Mirror RoadmapBoard's windowing so the empty state shows when no project falls
// in the visible window (otherwise the board would render with zero rows).
const { start, end } = roadmapWindow(new Date())
const hasData = projects.some((p) => projectOverlapsWindow(p, start, end))

const GITHUB_FALLBACK_HREF = 'https://github.com/interledger'
const githubFallbackAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'link',
  baseComponent: 'roadmap_empty_state',
  href: GITHUB_FALLBACK_HREF,
  linkText: t('roadmap.empty_state_link_text')
})
---

<FoundationPageLayout
  title={t('roadmap.title')}
  description={t('roadmap.description')}
>
  <main class={`px-content pb-4xl ${PAGE_TOP_OFFSET_CLASS}`}>
    <div class="content-column">
      <Breadcrumbs breadcrumbs={breadcrumbs}>
        <TranslationDisclaimer isVisible={isFallback} />
      </Breadcrumbs>

      <h1 class="text-h1 text-neutral-900 mb-2xl">{t('roadmap.title')}</h1>
      <p class="mb-xl max-w-[56ch] text-body-md-standard text-neutral-600">
        {t('roadmap.intro')}
      </p>

      {
        hasData ? (
          <RoadmapBoard projects={projects} teams={teams} />
        ) : (
          <div class="py-xl text-gray-600">
            <p>
              {t('roadmap.empty_state_pre')}{' '}
              <a
                class="text-link underline"
                href={GITHUB_FALLBACK_HREF}
                target="_blank"
                rel="noopener noreferrer"
                {...githubFallbackAttrs}
              >
                {t('roadmap.empty_state_link_text')}
              </a>{' '}
              {t('roadmap.empty_state_post')}
            </p>
          </div>
        )
      }

      {
        generatedAt && (
          <div class="pt-xs text-left text-caption tablet:text-body-sm-standard desktop:text-body-lg-standard text-gray-700">
            {t('roadmap.refreshed_at')}{' '}
            <time class="roadmap-refreshed" datetime={generatedAt}>
              {new Date(generatedAt).toUTCString()}
            </time>
          </div>
        )
      }
    </div>
  </main>
</FoundationPageLayout>

<script>
  // The page is SSR + CDN-cached, so the server can't know the viewer's locale
  // or timezone — it renders a UTC fallback (readable without JS). Localize it
  // here to the visitor's own locale and timezone.
  document
    .querySelectorAll<HTMLTimeElement>('time.roadmap-refreshed')
    .forEach((el) => {
      const iso = el.getAttribute('datetime')
      if (!iso) return
      const date = new Date(iso)
      if (Number.isNaN(date.getTime())) return
      el.textContent = date.toLocaleString(undefined, {
        dateStyle: 'medium',
        timeStyle: 'short'
      })
    })
</script>
