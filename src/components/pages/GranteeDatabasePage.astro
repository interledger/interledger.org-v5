---
import type { Page } from 'astro'
import '@/styles/tailwind.css'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import GranteeIndex from '@/components/grant/GranteeIndex.astro'
import Pagination from '@/components/shared/Pagination.astro'
import Icon from '@/components/shared/Icon.astro'
import { buttonVariants } from '@/components/shared/buttonVariants'
import {
  type Grantee,
  type GranteeFilterOption,
  useTranslations,
  localizeRoute,
  grantOverviewHubPath,
  grantGranteeDatabasePath,
  stripPagination
} from '@/utils'

interface Props {
  page: Page<Grantee>
  years: GranteeFilterOption[]
  programs: GranteeFilterOption[]
  countries: GranteeFilterOption[]
}

const { page, years, programs, countries } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const pageHref = localizeRoute(grantGranteeDatabasePath(), routeLocale)
const basePath = stripPagination(Astro.url.pathname)
const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  {
    name: t('nav.grants'),
    href: localizeRoute(grantOverviewHubPath(), routeLocale)
  },
  { name: t('grantee.title'), href: pageHref }
]

const buttonClass = buttonVariants({
  variant: 'primary',
  size: 'sm',
  iconSide: 'right'
})

const paginationLinkClasses = `
inline-block p-sm no-underline bg-transparent rounded-lg
text-body-sm-standard text-neutral-75 transition-all duration-200 ease-in-out
hover:bg-neutral-25 hover:text-link
focus-visible:bg-neutral-25 focus-visible:text-link focus-visible:outline-none
[&[aria-current='page']]:border [&[aria-current='page']]:border-link
[&[aria-current='page']]:pointer-events-none [&[aria-current='page']]:text-link
[&_span]:inline-block [&_span]:w-[24px] [&_span]:h-[24px] [&_span]:text-center
`
const paginationIconLinkClasses = `
text-link bg-transparent rounded-lg transition-all duration-200 ease-in-out
hover:bg-link hover:text-neutral-0
focus-visible:bg-link focus-visible:text-neutral-0 focus-visible:outline-none
[&[aria-disabled='true']]:cursor-not-allowed [&[aria-disabled='true']]:text-orchid-50
[&[aria-disabled='true']]:hover:bg-transparent
`
---

<FoundationPageLayout
  title={t('grantee.title')}
  description={t('grantee.meta_description')}
>
  <main
    data-grantee-directory
    data-results-template={t('grantee.results')}
    data-pagination-label={t('pagination.pages', { label: t('grantee.title') })}
    data-button-class={buttonClass}
    data-label-currency={t('grantee.currency')}
    data-label-amount={t('grantee.amount_label')}
    data-label-details={t('grantee.view_details')}
    data-label-lead={t('grantee.project_lead')}
    data-label-location={t('aria.grantee.location')}
    data-label-date={t('aria.grantee.date')}
    data-label-tags={t('aria.grantee.tags')}
    data-label-new-tab={t('aria.opens_new_tab')}
    data-static-page={page.currentPage}
    class="flex flex-col px-lg pt-[calc(var(--spacing-5xl)-var(--site-header-height))] pb-5xl tablet:px-xl tablet:pt-[calc(var(--spacing-6xl)-var(--site-header-height))] tablet:pb-6xl desktop:px-5xl desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))] desktop:pb-7xl"
  >
    <div class="w-full max-w-content m-auto">
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <GranteeIndex
        grantees={page.data}
        years={years}
        programs={programs}
        countries={countries}
        totalCount={page.total}
      />
      <div data-static-pagination>
        <Pagination
          baseUrl={basePath}
          length={page.lastPage}
          currentPage={page.currentPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          label={t('grantee.title')}
          class="mt-3xl tablet:mt-4xl desktop:mt-5xl"
        />
      </div>
      <nav
        data-grantee-pagination
        aria-label={t('pagination.pages', { label: t('grantee.title') })}
        class="hidden mt-3xl tablet:mt-4xl desktop:mt-5xl"
      >
        <ul
          class="flex flex-row flex-wrap justify-center gap-sm items-center m-0 p-0 list-none [&_li]:mb-0 [&_li]:flex"
        >
          <li>
            <a
              data-grantee-page="prev"
              href={page.url.prev ?? basePath}
              aria-label={t('pagination.previous')}
              class:list={[paginationLinkClasses, paginationIconLinkClasses]}
            >
              <Icon name="arrow-right-keyboard" class="rotate-180 size-6" />
            </a>
          </li>
          <li data-grantee-page-numbers class="hidden"></li>
          <li>
            <a
              data-grantee-page="next"
              href={page.url.next ?? basePath}
              aria-label={t('pagination.next')}
              class:list={[paginationLinkClasses, paginationIconLinkClasses]}
            >
              <Icon name="arrow-right-keyboard" class="size-6" />
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </main>
</FoundationPageLayout>

<script>
  import '@/scripts/grantee-directory'
</script>
