---
import '@/styles/tailwind.css'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import GranteeIndex from '@/components/grant/GranteeIndex.astro'
import {
  type Grantee,
  useTranslations,
  localizeRoute,
  grantOverviewHubPath,
  grantGranteeDatabasePath
} from '@/utils'

interface Props {
  grantees: Grantee[]
}

const { grantees } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const pageHref = localizeRoute(grantGranteeDatabasePath(), routeLocale)
const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  {
    name: t('nav.grants'),
    href: localizeRoute(grantOverviewHubPath(), routeLocale)
  },
  { name: t('grantee.title'), href: pageHref }
]
---

<FoundationPageLayout
  title={t('grantee.title')}
  description={t('grantee.meta_description')}
>
  <main
    class="flex flex-col px-lg pt-[calc(var(--spacing-5xl)-var(--site-header-height))] pb-5xl tablet:px-xl tablet:pt-[calc(var(--spacing-6xl)-var(--site-header-height))] tablet:pb-6xl desktop:px-5xl desktop:pt-[calc(var(--spacing-7xl)-var(--site-header-height-desktop))] desktop:pb-7xl"
  >
    <div class="w-full max-w-content m-auto">
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <GranteeIndex grantees={grantees} />
    </div>
  </main>
</FoundationPageLayout>
