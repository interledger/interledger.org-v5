---
import {
  type Locale,
  parseMarkdown,
  useTranslations,
  localizeRoute,
  grantOverviewHubPath,
  grantOverviewRouteParam,
  GRANT_OVERVIEW_PRIMARY_SLUG
} from '@/utils'
import { getCollection, render } from 'astro:content'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import PageHero from '@/components/shared/PageHero.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import BlockquoteBlock from '@/components/blocks/BlockquoteBlock.astro'
import CalloutTextBlock from '@/components/blocks/CalloutTextBlock.astro'
import VideoEmbedBlock from '@/components/blocks/VideoEmbedBlock.astro'
import ImageBlock from '@/components/blocks/ImageBlock.astro'
import NumberTiles from '@/components/blocks/NumberTiles.astro'
import TitleCard from '@/components/shared/TitleCard.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const pages = await getCollection('grant-overview-pages')

const mdxPage = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!mdxPage) return Astro.redirect('/404')

const { Content: MdxContent } = await render(mdxPage)
const hasBody = Boolean(mdxPage.body?.trim())

const {
  title,
  description,
  heroTitle,
  heroDescription,
  heroImage,
  heroImageAlt,
  heroImageMobile,
  heroImageMobileAlt,
  heroCtas,
  metaImage,
  canonicalUrl,
  ctaStrip,
  followUpContent
} = mdxPage.data

const followUpHtml = followUpContent
  ? await parseMarkdown(followUpContent, {
      pathname: Astro.url.pathname,
      lang: contentLocale
    })
  : null

const t = useTranslations(contentLocale)

const grantsHref = localizeRoute(grantOverviewHubPath(), contentLocale)
const pageHref = localizeRoute(grantOverviewRouteParam(slug), contentLocale)
// This template also renders the grants hub itself (slug === GRANT_OVERVIEW_PRIMARY_SLUG),
// where grantsHref and pageHref are identical — a third crumb would just repeat "Grants".
const isGrantOverviewHub = slug === GRANT_OVERVIEW_PRIMARY_SLUG
const breadcrumbs = [
  { name: t('nav.home'), href: localizeRoute('', contentLocale) },
  { name: t('nav.grants'), href: grantsHref },
  ...(isGrantOverviewHub ? [] : [{ name: heroTitle ?? title, href: pageHref }])
]
---

<FoundationPageLayout
  title={title}
  description={description}
  ogImageUrl={metaImage}
  canonicalURL={canonicalUrl}
>
  <main class="page-stack pb-section">
    <PageHero
      title={heroTitle ?? title}
      description={heroDescription ?? description}
      image={heroImage}
      imageMobile={heroImageMobile}
      imageAlt={heroImageAlt}
      imageMobileAlt={heroImageMobileAlt}
      cta={heroCtas?.[0]}
      breadcrumbs={breadcrumbs}
      imageBand="default"
    >
      <TranslationDisclaimer slot="after-breadcrumbs" isVisible={isFallback} />
    </PageHero>

    {
      hasBody && (
        <section class="px-content">
          <div class="content-column">
            <div data-prose>
              <MdxContent
                components={{
                  Paragraph,
                  SplitLayout,
                  Blockquote: BlockquoteBlock,
                  CalloutText: CalloutTextBlock,
                  VideoEmbed: VideoEmbedBlock,
                  ImageBlock,
                  CtaStrip,
                  LogoCarousel,
                  NumberTiles,
                  // Grant overview only allows CardGrid variant="Title" (enforced in CMS).
                  CardGrid,
                  TitleCard
                }}
              />
            </div>
          </div>
        </section>
      )
    }

    <section class="px-content">
      <div class="content-column">
        <CtaStrip
          heading={ctaStrip.heading}
          description={ctaStrip.description}
          primaryButtonText={ctaStrip.buttonText}
          primaryButtonLink={ctaStrip.buttonLink}
          primaryButtonExternal={ctaStrip.buttonExternal}
          primaryButtonDocument={ctaStrip.buttonDocument}
          secondaryButtonText={ctaStrip.secondaryButtonText}
          secondaryButtonLink={ctaStrip.secondaryButtonLink}
          secondaryButtonExternal={ctaStrip.secondaryButtonExternal}
          secondaryButtonDocument={ctaStrip.secondaryButtonDocument}
        />
      </div>
    </section>

    {
      followUpHtml && (
        <section class="px-content">
          <div class="content-column">
            <div data-prose set:html={followUpHtml} />
          </div>
        </section>
      )
    }
  </main>
</FoundationPageLayout>
