---
import SummitPageLayout from '@/layouts/SummitPageLayout.astro'
import SpeakersList from '@/components/summit/SpeakersList.astro'
import Pagination from '@/components/shared/Pagination.astro'
import type { Page } from 'astro'
import type { Speaker } from '@/types/summit'
import { useTranslations } from '@/utils'

interface Props {
  speakers: Speaker[]
  basePath: string
  title: string
  page: Page
  year: string
}

const { speakers, basePath, title, page, year } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const label = t('summit.speakers_pagination', { year })
---

<SummitPageLayout title={title}>
  <main class="px-content pt-page-offset pb-4xl">
    <div class="content-column">
      <!-- Speaker list pages intentionally do not show the translation disclaimer.
           Names/affiliations are still usable in Spanish, while untranslated bios are only shown on speaker detail pages. -->
      <h1 class="mb-2xl text-neutral-900">{title}</h1>
      <section aria-label={t('summit.speakers')}>
        <SpeakersList speakers={speakers} basePath={basePath} year={year} />
      </section>

      {page.lastPage && page.lastPage > 1 && (
        <Pagination
          baseUrl={basePath}
          length={page.lastPage}
          currentPage={page.currentPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          label={label}
        />
      )}
    </div>
  </main>
</SummitPageLayout>
