---
import { type Locale, getHeroSectionStyle, isDemoPathSlug } from '@/utils'
import { getCollection, render } from 'astro:content'
import SummitPageLayout from '@/layouts/SummitPageLayout.astro'
import ProfileGrid from '@/components/shared/ProfileGrid.astro'
import Blockquote from '@/components/shared/Blockquote.astro'
import Quote from '@/components/blocks/Quote.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import SplitLayout from '@/components/blocks/SplitLayout.astro'
import CtaStrip from '@/components/blocks/CtaStrip.astro'
import VideoEmbed from '@/components/shared/VideoEmbed.astro'
import ProfileCard from '@/components/shared/ProfileCard.astro'
import CalloutText from '@/components/shared/CalloutText.astro'
import PdfEmbed from '@/components/shared/PdfEmbed.astro'
import InfoCard from '@/components/shared/InfoCard.astro'
import NumberTiles from '@/components/blocks/NumberTiles.astro'
import LogoCarousel from '@/components/blocks/LogoCarousel.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import HeroSection from '@/components/shared/HeroSection.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import TitleCard from '@/components/shared/TitleCard.astro'
import CardGrid from '@/components/blocks/CardGrid.astro'
import ResourceCard from '@/components/shared/ResourceCard.astro'
import NavigationCard from '@/components/shared/NavigationCard.astro'
import Agenda from '@/components/blocks/Agenda.astro'
import Faq from '@/components/blocks/Faq.astro'
import CtaButtons from '@/components/blocks/CtaButtons.astro'
import FaqItem from '@/components/shared/FaqItem.astro'
import EventCard from '@/components/blocks/EventCard.astro'
import EventWhen from '@/components/shared/EventWhen.astro'
import EventWhere from '@/components/shared/EventWhere.astro'
import EventApply from '@/components/shared/EventApply.astro'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const pages = await getCollection('summit-pages')

const mdxPage = pages.find(
  (page) => page.data.pathSlug === slug && page.data.locale === contentLocale
)

if (!mdxPage) return Astro.redirect('/404')

Astro.locals.profileEntries = await getCollection('profiles')

const { Content: MdxContent } = await render(mdxPage)
const mdxData = mdxPage.data

const title = mdxData?.title
const description = mdxData?.description || undefined
const mdxHeroTitle = mdxData?.heroTitle || mdxData?.title || ''
const mdxHeroDescription = mdxData?.heroDescription || ''
const heroSectionStyle = getHeroSectionStyle(mdxData?.heroImage)
const heroCtas = mdxData?.heroCtas ?? []
const gradient =
  (mdxData as { gradient?: string } | undefined)?.gradient || 'option1'
const noindex = isDemoPathSlug(mdxData?.pathSlug)
---

<SummitPageLayout
  title={title}
  description={description}
  gradient={gradient}
  noindex={noindex}
>
  <main
    class="summit-content relative z-0 pb-3xl text-neutral-0 before:content-[''] before:fixed before:inset-0 before:-z-10 before:bg-[url('/img/bg-swirl.svg')] before:bg-repeat before:bg-[length:100%] before:opacity-25 before:blur-[150px] before:transform before:translate-x-0 before:translate-y-0"
  >
    <TranslationDisclaimer isVisible={isFallback} style="summit" />
    {
      mdxHeroTitle && (
        <HeroSection
          title={mdxHeroTitle}
          description={mdxHeroDescription}
          ctas={heroCtas}
          sectionStyle={heroSectionStyle}
        />
      )
    }
    <section class="py-4xl">
      <!--
        Content-width shell (@container) with narrow prose inside. Full-width
        blocks (EventCard, CardGrid) break out to 100cqw so multi-column layouts
        aren't squeezed into max-w-narrow (720px).
      -->
      <div
        class="@container mx-auto max-w-content min-w-[360px] max-[1324px]:px-[5%]"
      >
        <div
          data-prose-summit
          class="mx-auto max-w-narrow [&_h2]:mt-3xl [&_h2]:mb-xl [&_h2]:text-[1.75rem] [&_h2]:font-semibold [&_h3]:mt-2xl [&_h3]:mb-lg [&_h3]:text-[1.25rem] [&_h3]:font-semibold [&_p]:mb-xl [&_p]:leading-[1.6] [&_ul]:mb-xl [&_ul]:ps-2xl [&_li]:mb-lg [&_a]:underline [&_a:hover]:no-underline"
        >
          <MdxContent
            components={{
              img: OptimizedImage,
              ProfileCard,
              ProfileGrid,
              Blockquote,
              Quote,
              CalloutText,
              Paragraph,
              SplitLayout,
              CtaStrip,
              PdfEmbed,
              VideoEmbed,
              InfoCard,
              TitleCard,
              CardGrid,
              ResourceCard,
              NavigationCard,
              NumberTiles,
              Agenda,
              Faq,
              CtaButtons,
              FaqItem,
              EventCard,
              EventWhen,
              EventWhere,
              EventApply,
              LogoCarousel
            }}
          />
        </div>
      </div>
    </section>
  </main>
</SummitPageLayout>

<style>
  .summit-content {
    color: var(--color-neutral-0);
  }

  /* Light body text for summit chrome; dark-on-white blocks opt out. */
  .summit-content
    :where(p, ul, ol, blockquote, h1, h2, h3, h4, h5, h6):not(
      [data-component='EventCard'] *
    ):not([data-component='CardGrid'] *):not([data-component='CtaStrip'] *):not(
      section[aria-labelledby='logo-carousel-heading'] *
    ) {
    color: var(--color-neutral-0);
  }

  /*
   * Expand full-width blocks to the content shell; prose stays max-w-narrow.
   * :global — child components' roots are not stamped with this page's Astro
   * scope attribute, so unscoped selectors never match.
   */
  [data-prose-summit] :global([data-component='EventCard']),
  [data-prose-summit] :global([data-component='CardGrid']) {
    width: 100cqw;
    max-width: 100cqw;
    position: relative;
    left: 50%;
    translate: -50% 0;
  }
</style>
