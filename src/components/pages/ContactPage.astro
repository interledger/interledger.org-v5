---
import { useTranslations, localizeRoute, type BreadcrumbItem } from '@/utils'
import { buttonVariants } from '@/components/shared/buttonVariants'
import FoundationPageLayout from '@/layouts/FoundationPageLayout.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import Icon from '@/components/shared/Icon.astro'

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const breadcrumbs: BreadcrumbItem[] = [
  { name: t('nav.home'), href: localizeRoute('', routeLocale) },
  { name: t('contact.title'), href: localizeRoute('contact', routeLocale) }
]

const currentPath = Astro.url.pathname

const topics = [
  { value: 'Grants', label: t('contact.topic.grants') },
  { value: 'Media', label: t('contact.topic.media') },
  { value: 'Technology', label: t('contact.topic.technology') },
  { value: 'Other', label: t('contact.topic.other') }
] as const

const inputClasses =
  'w-full rounded-lg border border-neutral-50 bg-white px-lg py-md text-base outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors'

const labelClasses = 'font-thin text-body-sm-standard text-neutral-900'

const helperClasses = 'mb-0 text-caption text-neutral-75'

const errorClasses = 'hidden mb-0 text-body-sm-standard text-red-600'

const summaryClasses = [
  'list-none flex gap-xs items-center cursor-pointer font-thin',
  'p-xs rounded-lg border border-transparent',
  'group-open:text-neutral-100 group-open:[&_svg]:-rotate-90',
  '[&_svg]:transition-all motion-safe:[&_svg]:duration-500 [&_svg]:ease-in-out',
  'focus-visible:outline-none focus-visible:border focus-visible:border-primary'
].join(' ')

const dropdownClasses = [
  'list-none m-0 p-sm [&_li]:m-0',
  'absolute top-[calc(var(--spacing-xl)+var(--spacing-xs))] z-1',
  'bg-neutral-0 rounded-xl border border-neutral-25',
  'min-w-[12rem]'
].join(' ')

const optionClasses = [
  'flex gap-md items-center w-full px-sm py-xs',
  'rounded-lg border border-transparent bg-transparent text-left cursor-pointer',
  'text-body-sm-standard text-neutral-75',
  'hover:bg-neutral-25 hover:text-neutral-100',
  'focus-visible:outline-none focus-visible:border focus-visible:border-primary',
  'aria-selected:bg-neutral-25 aria-selected:text-neutral-100'
].join(' ')
---

<FoundationPageLayout
  title={t('contact.title')}
  description={t('contact.description')}
>
  <main class="pt-2xl pb-4xl">
    <div class="mx-auto max-w-content min-w-[360px] px-[5%] min-[1600px]:px-0">
      <div class="mb-xl">
        <Breadcrumbs breadcrumbs={breadcrumbs} />
      </div>

      <h1 class="text-h1 text-neutral-900 mb-2xl">
        {t('contact.title')}
      </h1>

      <div class="grid gap-0 desktop:grid-cols-[2fr_3fr] desktop:gap-5xl">
        <div>
          <h3 class="text-h3-lg text-neutral-900 mb-lg">
            {t('contact.support_heading')}
          </h3>
          <p class="mb-xl desktop:mb-0 text-body-md-standard text-neutral-600">
            {t('contact.support_description')}
          </p>
        </div>

        <div class="rounded-xl border border-neutral-50 bg-white p-xl">
          <div
            id="success-message"
            class="hidden outline-none"
            role="status"
            aria-live="polite"
            tabindex="-1"
          >
            <p class="font-semibold mb-s">{t('contact.success_message')}</p>
            <p class="text-neutral-600">{t('contact.success_thanks')}</p>
          </div>

          <div id="form-wrapper">
            <h2
              class="text-h4-lg text-neutral-900 mb-2xl"
              id="contact-form-heading"
            >
              {t('contact.form_heading')}
            </h2>

            <form
              id="contact-form"
              name="contact"
              method="POST"
              action={`${currentPath}?success=true`}
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              data-netlify-recaptcha="true"
              aria-labelledby="contact-form-heading"
              class="flex flex-col gap-xl"
            >
              <input type="hidden" name="form-name" value="contact" />

              <p class="hidden">
                <label>Don't fill this out: <input name="bot-field" /></label>
              </p>

              <!-- Name (optional) -->
              <div class="flex flex-col gap-xs">
                <label for="name" class={labelClasses}>
                  {t('contact.name')}
                </label>
                <input
                  id="name"
                  type="text"
                  name="name"
                  autocomplete="name"
                  class={inputClasses}
                  aria-describedby="name-help"
                />
                <p id="name-help" class={helperClasses}>
                  {t('contact.name.placeholder')}
                </p>
              </div>

              <div class="flex flex-col gap-xs">
                <label for="email" class={labelClasses}>
                  {t('contact.email')}
                  <span aria-hidden="true" class="ml-0.5 text-primary">*</span>
                </label>
                <input
                  id="email"
                  type="email"
                  name="email"
                  required
                  aria-required="true"
                  autocomplete="email"
                  class={inputClasses}
                  aria-describedby="email-help"
                />
                <p id="email-help" class={helperClasses}>
                  {t('contact.email.placeholder')}
                </p>
              </div>

              <!-- Topic: optional custom listbox -->
              <div class="flex flex-col gap-xs">
                <input type="hidden" id="topic-value" name="topic" value="" />
                <div
                  class="flex flex-wrap items-center gap-md text-body-sm-emphasis text-neutral-75"
                >
                  <details id="topic-details" class="group relative">
                    <summary
                      id="topic-summary"
                      class={summaryClasses}
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="topic-listbox"
                      aria-describedby="topic-selected"
                    >
                      {t('contact.topic')}
                      <Icon
                        name="arrow-right-keyboard"
                        class="size-5 rotate-90"
                        aria-hidden="true"
                      />
                    </summary>
                    <ul
                      id="topic-listbox"
                      class={dropdownClasses}
                      role="listbox"
                      tabindex="-1"
                      aria-labelledby="topic-summary"
                    >
                      {
                        topics.map((topic) => (
                          <li role="presentation">
                            <button
                              type="button"
                              id={`topic-option-${topic.value}`}
                              class={optionClasses}
                              role="option"
                              data-value={topic.value}
                              aria-selected="false"
                            >
                              {topic.label}
                            </button>
                          </li>
                        ))
                      }
                    </ul>
                  </details>
                  <!-- Current selection (also announced via summary aria-describedby) -->
                  <span
                    id="topic-selected"
                    class="text-primary"
                    aria-live="polite"
                  >
                    {t('contact.topic.placeholder')}
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-xs">
                <label for="message" class={labelClasses}>
                  {t('contact.message')}
                  <span aria-hidden="true" class="ml-0.5 text-primary">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  aria-required="true"
                  rows="6"
                  maxlength="3000"
                  class={`${inputClasses} resize-y`}
                  aria-describedby="message-help"></textarea>
              </div>

              <div class="flex flex-col gap-s">
                <div data-netlify-recaptcha="true"></div>
                <p
                  id="recaptcha-error"
                  class={errorClasses}
                  role="alert"
                  tabindex="-1"
                >
                  {t('contact.error.captcha')}
                </p>
              </div>

              <div class="flex flex-col gap-s">
                <p
                  id="submit-error"
                  class={errorClasses}
                  role="alert"
                  tabindex="-1"
                >
                  {t('contact.error.submit')}
                </p>
                <div>
                  <button
                    type="submit"
                    id="contact-submit"
                    class={buttonVariants({
                      variant: 'primary',
                      iconSide: 'right',
                      size: 'lg'
                    })}
                    data-label-default={t('contact.submit')}
                    data-label-busy={t('contact.submitting')}
                    data-umami-event="button_form"
                    data-umami-event-base-component="form"
                    data-umami-event-link-text={t('contact.submit')}
                    data-umami-event-lang={routeLocale}
                    data-umami-event-current-path={currentPath}
                    data-umami-event-current-section="contact"
                  >
                    <span id="contact-submit-label">{t('contact.submit')}</span>
                    <Icon
                      name="arrow-right"
                      class="size-5 shrink-0"
                      aria-hidden="true"
                    />
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</FoundationPageLayout>

<script>
  const successEl = document.getElementById('success-message')
  const formWrapper = document.getElementById('form-wrapper')
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const submitBtn = document.getElementById(
    'contact-submit'
  ) as HTMLButtonElement | null
  const submitLabel = document.getElementById('contact-submit-label')

  // Success state
  const params = new URLSearchParams(window.location.search)
  if (params.get('success') === 'true') {
    formWrapper?.classList.add('hidden')
    successEl?.classList.remove('hidden')
    successEl?.focus()
    // Drop ?success=true so refresh doesn't re-announce the status
    const clean = new URL(window.location.href)
    clean.searchParams.delete('success')
    window.history.replaceState(
      {},
      '',
      clean.pathname + clean.search + clean.hash
    )
  }

  // Topic listbox (optional)
  const topicDetails = document.getElementById(
    'topic-details'
  ) as HTMLDetailsElement | null
  const topicInput = document.getElementById(
    'topic-value'
  ) as HTMLInputElement | null
  const topicSummary = document.getElementById('topic-summary')
  const topicSelected = document.getElementById('topic-selected')
  const topicOptions = [
    ...(topicDetails?.querySelectorAll<HTMLButtonElement>(
      'button[role="option"]'
    ) ?? [])
  ]

  function setTopicOpen(open: boolean) {
    if (topicDetails) topicDetails.open = open
    topicSummary?.setAttribute('aria-expanded', open ? 'true' : 'false')
  }

  function selectTopic(option: HTMLButtonElement) {
    const value = option.dataset.value ?? ''
    const text = option.textContent?.trim() ?? ''
    if (topicInput) topicInput.value = value
    if (topicSelected) topicSelected.textContent = text
    topicOptions.forEach((opt) => {
      opt.setAttribute('aria-selected', opt === option ? 'true' : 'false')
    })
    setTopicOpen(false)
    topicSummary?.focus()
  }

  function focusOption(index: number) {
    if (topicOptions.length === 0) return
    const i = Math.max(0, Math.min(index, topicOptions.length - 1))
    topicOptions[i]?.focus()
  }

  topicDetails?.addEventListener('toggle', () => {
    topicSummary?.setAttribute(
      'aria-expanded',
      topicDetails.open ? 'true' : 'false'
    )
    if (topicDetails.open) {
      const selectedIdx = topicOptions.findIndex(
        (o) => o.getAttribute('aria-selected') === 'true'
      )
      focusOption(selectedIdx >= 0 ? selectedIdx : 0)
    }
  })

  topicOptions.forEach((btn, index) => {
    btn.addEventListener('click', () => selectTopic(btn))
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault()
          focusOption(index + 1)
          break
        case 'ArrowUp':
          e.preventDefault()
          focusOption(index - 1)
          break
        case 'Home':
          e.preventDefault()
          focusOption(0)
          break
        case 'End':
          e.preventDefault()
          focusOption(topicOptions.length - 1)
          break
        case 'Escape':
          e.preventDefault()
          setTopicOpen(false)
          topicSummary?.focus()
          break
        case 'Enter':
        case ' ':
          e.preventDefault()
          selectTopic(btn)
          break
      }
    })
  })

  topicDetails?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && topicDetails.open) {
      setTopicOpen(false)
      topicSummary?.focus()
    }
  })

  topicDetails?.addEventListener('focusout', (e: FocusEvent) => {
    if (!topicDetails.contains(e.relatedTarget as Node)) {
      setTopicOpen(false)
    }
  })

  document.addEventListener('pointerdown', (e: PointerEvent) => {
    if (!topicDetails?.open) return
    if (e.target instanceof Node && !topicDetails.contains(e.target)) {
      setTopicOpen(false)
    }
  })

  function showError(el: HTMLElement | null) {
    el?.classList.remove('hidden')
    el?.focus()
    el?.scrollIntoView({ behavior: 'smooth', block: 'center' })
  }

  function setSubmitting(busy: boolean) {
    if (!submitBtn) return
    submitBtn.disabled = busy
    submitBtn.setAttribute('aria-busy', busy ? 'true' : 'false')
    const defaultLabel = submitBtn.dataset.labelDefault ?? ''
    const busyLabel = submitBtn.dataset.labelBusy ?? defaultLabel
    if (submitLabel) {
      submitLabel.textContent = busy ? busyLabel : defaultLabel
    }
    submitBtn.classList.toggle('opacity-70', busy)
    submitBtn.classList.toggle('pointer-events-none', busy)
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const recaptchaError = document.getElementById('recaptcha-error')
    const submitError = document.getElementById('submit-error')

    recaptchaError?.classList.add('hidden')
    submitError?.classList.add('hidden')

    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    const recaptchaDone = !!(
      document.querySelector(
        'textarea[name="g-recaptcha-response"]'
      ) as HTMLTextAreaElement | null
    )?.value?.trim()
    if (!recaptchaDone) {
      showError(recaptchaError)
      return
    }

    setSubmitting(true)

    try {
      const formData = new FormData(form)
      const body = new URLSearchParams()
      for (const [key, value] of formData.entries()) {
        if (typeof value === 'string') body.append(key, value)
      }
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      })
      if (!res.ok) throw new Error(`Submission failed: ${res.status}`)
      window.location.href = form.action
    } catch (err) {
      console.error(err)
      setSubmitting(false)
      showError(submitError)
    }
  })
</script>
