---
import SummitPageLayout from '@/layouts/SummitPageLayout.astro'
import {
  localizeRoute,
  joinPagePath,
  useTranslations,
  getTranslation,
  getTalks,
  AVATAR_CDN_WIDTHS
} from '@/utils'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import type { Speaker } from '@/types/summit'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import TextParagraphs from '@/components/shared/TextParagraphs.astro'
import SessionsList from '@/components/summit/SessionsList.astro'

interface Props {
  entry: Speaker
  year: string
  isFallback?: boolean
}

const { entry, year, isFallback = false } = Astro.props
const { routeLocale: lang, currentBasePath } = Astro.locals
const t = useTranslations(lang)
const sessionBaseHref = joinPagePath(
  localizeRoute(currentBasePath, lang),
  year,
  'talks'
)
const sessions = await getTalks(year, entry.id)
const translation = getTranslation(entry, lang)
const bio = translation?.bio ?? entry.bio
---

<SummitPageLayout title={entry.name}>
  <main>
    <header class="bg-ice-indigo-50">
      <div class="px-content pt-page-offset pb-2xl">
        <div class="content-column">
          {isFallback && <div class="mb-lg flex justify-end">
            <TranslationDisclaimer isVisible={isFallback} style="summit" />
          </div>}
          <div
            class="flex flex-col items-start gap-xl tablet:flex-row tablet:items-end tablet:justify-between"
          >
            <div>
              <h1 class="mb-md text-neutral-900">{entry.name}</h1>
              {entry.tagLine && <p
                class="mb-0 text-body-lg-standard text-neutral-100"
              >
                {entry.tagLine}
              </p>}
            </div>
            <OptimizedImage
              class="rounded-full"
              src={entry.profilePicture}
              alt={t('summit.profile_image', { name: entry.name })}
              width={240}
              height={240}
              sizes="240px"
              widths={AVATAR_CDN_WIDTHS}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </header>
    <div class="px-content py-3xl">
      <div class="content-column">
        <section aria-label={t('profile.biography')} class="mb-2xl">
          <TextParagraphs text={bio} />
        </section>
        {sessions.length > 0 && <section
          aria-label={t('summit.sessions')}
          class="rounded-2xl border border-neutral-50 p-xl tablet:p-2xl"
        >
          <SessionsList
            sessions={sessions}
            sessionBaseHref={sessionBaseHref}
            lang={lang}
            year={year}
          />
        </section>}
      </div>
    </div>
  </main>
</SummitPageLayout>
