---
import { RICH_TEXT_MDX_COMPONENTS } from '@/components/mdx/richTextComponents'
import { render } from 'astro:content'
import ProfileAvatarFallback from '@/components/shared/ProfileAvatarFallback.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import ProfileHeroBand from '@/components/shared/ProfileHeroBand.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import {
  getProfileHeroColorClass,
  getProfileAvatarColorClass
} from '@/components/shared/profileColors'
import {
  type Locale,
  type SiteSection,
  useTranslations,
  getProfileColorIndex,
  buildSectionEntryBreadcrumbs,
  buildUmamiAttrs,
  getSectionPageLayout,
  isDemoPathSlug,
  getGatedCollection
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  section: SiteSection
  isFallback?: boolean
}

const { slug, contentLocale, section, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const allProfiles = await getGatedCollection('profiles')
const entry = allProfiles.find(
  (p) =>
    p.data.pathSlug === slug &&
    p.data.locale === contentLocale &&
    p.data.section === section
)

if (!entry) throw new Error(`Profile not found: ${slug} (${contentLocale})`)

const { Content: MdxContent } = await render(entry)
const { name, photo, photoAlt, tagline, role, cta, description } = entry.data

const title = name
const displayRole = role ?? tagline
const hasCta = Boolean(cta?.text && cta?.link)
const hasBody = Boolean(entry.body?.trim())
const hasIntro = Boolean(description || hasCta)
const dividerClass =
  'm-0 mb-2xl border-0 border-t border-neutral-25 dark:border-neutral-75'
const colorIndex = await getProfileColorIndex(
  entry.data.pathSlug,
  contentLocale
)
const heroColorClass = getProfileHeroColorClass(colorIndex)
const avatarColorClass = getProfileAvatarColorClass(colorIndex)

const avatarSizeClass =
  'h-[160px] w-[160px] tablet:h-[220px] tablet:w-[220px] desktop:h-[240px] desktop:w-[240px]'

const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  section,
  name,
  routeLocale,
  t
)

const Layout = getSectionPageLayout(section)
const noindex = isDemoPathSlug(entry.data.pathSlug)
const textColorClass = 'text-neutral-900 dark:text-neutral-0'
const nameClass = textColorClass
const roleClass = `inline-block border-b-4 border-link pb-sm text-h4 font-normal mt-0 mb-xl ${textColorClass} tablet:text-h4-md desktop:text-h4-lg`
---

<Layout
  title={title}
  description={description ?? displayRole ?? name}
  noindex={noindex}
>
  <main class="pb-3xl" data-pillar="mission">
    <div class="px-content">
      <div class="max-w-narrow m-auto min-w-0 w-full pt-page-offset">
        <Breadcrumbs breadcrumbs={breadcrumbs}>
          <TranslationDisclaimer isVisible={isFallback} />
        </Breadcrumbs>
      </div>
    </div>
    <ProfileHeroBand heroColorClass={heroColorClass} />
    <div class="px-content">
      <div
        class="max-w-narrow m-auto min-w-0 w-full -mt-6xl tablet:-mt-6xl desktop:-mt-7xl"
      >
        <div
          class={`relative shrink-0 overflow-hidden rounded-full ${avatarSizeClass} ${avatarColorClass}`}
        >
          {photo ? (
            <OptimizedImage
              src={photo}
              alt={photoAlt ?? name}
              width={240}
              height={240}
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
            />
          ) : (
            <div class="absolute inset-0">
              <ProfileAvatarFallback />
            </div>
          )}
        </div>
        {/* The profile header works like a blog post's (ADR-009, D3): a
          biography right after it opens with its Paragraph block's own top
          padding, the "first" one (A3), which is the whole gap. */}
        <div
          class="mt-3xl-tight flex flex-col gap-0 [&_h1]:mb-md [&_h1]:leading-tight tablet:mt-3xl [&:has(+[data-profile-body]>[data-intro-variant=paragraph]:first-child)>:last-child]:mb-0"
        >
          <h1 class={nameClass}>{name}</h1>
          {displayRole && <p class={roleClass}>{displayRole}</p>}
        </div>
        {/* The description belongs to the header (Figma 5554:63023): it
          sits the role's margin below it, without a paragraph's lead top. */}
        {description && <section
          data-prose
          aria-label={t('profile.description')}
          class="mb-2xl [--para-p-lead-pt:0px]"
        >
          <Paragraph content={description} />
        </section>}
        {hasCta && <div class="mb-2xl">
          <LinkButton
            href={cta!.link}
            variant={cta!.style === 'secondary' ? 'secondary' : 'primary'}
            size="lg"
            external={cta!.external}
            {...buildUmamiAttrs({
              pathname: Astro.url.pathname,
              lang: contentLocale,
              label: 'button_cta',
              baseComponent: 'profile',
              href: cta!.link,
              linkText: cta!.text
            })}
          >
            {cta!.text}
            <Icon name="arrow-right" slot="icon-right" />
          </LinkButton>
        </div>}
        {hasIntro && hasBody && <hr class={dividerClass} />}
        {/* A biography in Paragraph blocks is spaced like a blog post's
          (ADR-009, D3); the direct-child rules are for one written as plain
          Markdown. A divider inside a Paragraph sits like Figma's divider
          between blocks (5554:63037): the block's bottom padding above it,
          the next heading's own padding below. */}
        {hasBody && <section
          data-prose
          data-profile-body
          aria-label={t('profile.biography')}
          class:list={[
            'mb-2xl [&>h2:not(:first-of-type)]:mt-4xl desktop:[&>h2:not(:first-of-type)]:mt-5xl [&>h2]:mb-2xl [&>hr]:my-4xl desktop:[&>hr]:my-5xl [&>p:has(>a):has(+p:has(>a))]:mb-sm [&>[data-intro-variant=paragraph]>hr]:mt-(--block-pb) [&>[data-intro-variant=paragraph]>hr]:mb-0',
            !hasIntro && '[--para-lead-pt:var(--para-first-pt)]'
          ]}
        >
          <MdxContent components={{ ...RICH_TEXT_MDX_COMPONENTS, Paragraph }} />
        </section>}
      </div>
    </div>
  </main>
</Layout>
