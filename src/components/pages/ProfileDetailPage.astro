---
import { getCollection, render } from 'astro:content'
import ProfileAvatarFallback from '@/components/shared/ProfileAvatarFallback.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import TranslationDisclaimer from '@/components/shared/TranslationDisclaimer.astro'
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import Paragraph from '@/components/blocks/Paragraph.astro'
import {
  getProfileHeroColorClass,
  getProfileAvatarColorClass
} from '@/components/shared/profileColors'
import {
  type Locale,
  useTranslations,
  getProfileColorIndex,
  buildSectionEntryBreadcrumbs,
  buildUmamiAttrs,
  getSectionPageLayout,
  isDemoPathSlug
} from '@/utils'

interface Props {
  slug: string
  contentLocale: Locale
  isFallback?: boolean
}

const { slug, contentLocale, isFallback = false } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const allProfiles = await getCollection('profiles')
const entry = allProfiles.find(
  (p) => p.data.pathSlug === slug && p.data.locale === contentLocale
)

if (!entry) throw new Error(`Profile not found: ${slug} (${contentLocale})`)

const { Content: MdxContent } = await render(entry)
const { name, photo, photoAlt, tagline, role, cta, description } = entry.data

const isHackathon = entry.data.section === 'hackathon'
const title = isHackathon ? name : `${name} | Interledger Foundation`
const displayRole = role ?? tagline
const hasCta = Boolean(cta?.text && cta?.link)
const hasBody = Boolean(entry.body?.trim())
const colorIndex = await getProfileColorIndex(
  entry.data.pathSlug,
  contentLocale
)
const heroColorClass = getProfileHeroColorClass(colorIndex)
const avatarColorClass = getProfileAvatarColorClass(colorIndex)

const avatarSizeClass =
  'h-[160px] w-[160px] tablet:h-[220px] tablet:w-[220px] desktop:h-[240px] desktop:w-[240px]'

const breadcrumbs = buildSectionEntryBreadcrumbs(
  entry.data.pathSlug,
  entry.data.section,
  name,
  routeLocale,
  t('nav.home')
)

const Layout = getSectionPageLayout(entry.data.section)
const noindex = isDemoPathSlug(entry.data.pathSlug)
const nameClass = isHackathon
  ? 'text-h2 text-neutral-0 tablet:text-h2-md desktop:text-h2-lg'
  : 'text-h2 text-neutral-900 tablet:text-h2-md desktop:text-h2-lg'
const roleClass = isHackathon
  ? 'inline-block border-b-4 border-lavender-100 text-h4 font-normal text-neutral-0 tablet:text-h4-md desktop:text-h4-lg'
  : 'inline-block border-b-4 border-orchid-100 text-h4 font-normal text-neutral-900 tablet:text-h4-md desktop:text-h4-lg'
---

<Layout
  title={title}
  description={description ?? displayRole ?? name}
  noindex={noindex}
>
  <main class="pb-3xl" data-pillar="mission">
    <TranslationDisclaimer isVisible={isFallback} />
    <header
      class={`${heroColorClass} h-[200px] tablet:h-[230px] desktop:h-[320px]`}
    >
      <div class="max-w-250 m-auto px-2xl pt-2xl tablet:pt-4xl desktop:pt-5xl">
        <Breadcrumbs breadcrumbs={breadcrumbs} breakBeforeLastItem />
      </div>
    </header>
    <div class="max-w-250 m-auto px-2xl -mt-6xl tablet:-mt-6xl desktop:-mt-7xl">
      <div
        class={`relative shrink-0 overflow-hidden rounded-full ${avatarSizeClass} ${avatarColorClass}`}
      >
        {
          photo ? (
            <OptimizedImage
              src={photo}
              alt={photoAlt ?? name}
              width={240}
              height={240}
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full scale-[0.94] object-cover object-[center_18%] translate-y-[4%]"
            />
          ) : (
            <div class="absolute inset-0">
              <ProfileAvatarFallback />
            </div>
          )
        }
      </div>
      <div
        class="mt-xl flex flex-col gap-0 [&_h1]:mb-md [&_h1]:leading-tight [&_h4]:mt-0 [&_h4]:mb-xl [&_h4]:pb-0"
      >
        <h1 class={nameClass}>{name}</h1>
        {displayRole && <h4 class={roleClass}>{displayRole}</h4>}
      </div>
      {
        description && (
          <section
            data-prose
            aria-label={t('profile.description')}
            class="mb-2xl"
          >
            <Paragraph content={description} />
          </section>
        )
      }
      {
        hasCta && (
          <div class="mb-2xl">
            <LinkButton
              href={cta!.link}
              variant={cta!.style === 'secondary' ? 'secondary' : 'primary'}
              size="lg"
              external={cta!.external}
              {...buildUmamiAttrs({
                pathname: Astro.url.pathname,
                lang: contentLocale,
                section: 'cta',
                href: cta!.link,
                linkText: cta!.text,
                action: 'cta_button'
              })}
            >
              {cta!.text}
              <Icon name="arrow-right" slot="icon-right" />
            </LinkButton>
          </div>
        )
      }
      {
        hasBody && (
          <section
            data-prose
            aria-label={t('profile.biography')}
            class="mb-2xl"
          >
            <MdxContent components={{ Paragraph }} />
          </section>
        )
      }
    </div>
  </main>
</Layout>
