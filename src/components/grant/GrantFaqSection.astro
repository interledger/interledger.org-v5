---
import Icon from '@/components/shared/Icon.astro'
import FaqAnswerPanel from '@/components/shared/FaqAnswerPanel.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import BlockIntro from '@/components/shared/BlockIntro.astro'
import {
  blockIntroA11y,
  buildUmamiAttrs,
  normalizeBlockIntro,
  parseMarkdown,
  resolveCtaLink
} from '@/utils'
import { faqAccordionGroupName } from '@/scripts/faq-accordion'

interface FaqItem {
  question: string
  /** Markdown from the CKEditor `answer` field. */
  answer: string
}

interface Props {
  title: string
  subtitle?: string
  description: string
  ctaText?: string
  ctaLink?: string
  /** Opens the CTA in a new tab and shows the external icon. */
  ctaExternal?: boolean
  /** Marks the CTA a download and shows the download icon. */
  ctaDocument?: boolean
  items: FaqItem[]
}

const {
  title,
  subtitle,
  description,
  ctaText,
  ctaLink,
  ctaExternal,
  ctaDocument,
  items
} = Astro.props
const { routeLocale } = Astro.locals

const faqToggleUmamiAttrs = (question: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'toggle',
    baseComponent: 'faq',
    ariaLabel: question
  })

// Whitespace-only values are treated as absent, matching
// validateGrantPageFaqSection and generateGrantPageMDX — otherwise a lone
// trimmed-empty cta half renders a broken button. The intro drops a blank
// subtitle itself.
const trimmedCtaText = ctaText?.trim() || undefined
const trimmedCtaLink = ctaLink?.trim() || undefined

// Icon by link kind (INTORG-938). This button showed no icon at all, so an
// external link and a download looked the same as an internal one. The
// internal case still shows nothing: this CTA belongs to the grant page
// template, not to a component an editor picks (Sarah, 2026-08-09).
const resolvedCta = trimmedCtaLink
  ? resolveCtaLink({
      url: trimmedCtaLink,
      external: ctaExternal,
      document: ctaDocument
    })
  : null

const renderedItems = await Promise.all(
  items.map(async (item) => ({
    question: item.question,
    answerHtml: await parseMarkdown(item.answer, {
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  }))
)

// The FAQ split (ADR-009, B5): the section's title, subtitle and description
// are its intro, in the Split layout variant.
const intro = normalizeBlockIntro({
  heading: title,
  subheading: subtitle,
  description
})
const { headingId } = blockIntroA11y(intro, 'grant-faq')

// Unique so this grant FAQ doesn't exclusive-close another accordion on
// the same page when JS is off. initFaqAccordion strips `name`.
const accordionName = faqAccordionGroupName()
---

{/*
  The FAQ split (ADR-009, B5): intro and button max 40%, the accordion max
  60%, 120 apart on desktop; stacked in that order below. Until the grant
  template lets its sections own their spacing (Phase 2c) the page stack
  supplies the gaps around this section, so it drops its own: `pb-0` below,
  and no intro top spacer or heading padding above.
*/}
<section
  data-component="GrantFaqSection"
  data-intro-variant="split-layout"
  aria-labelledby={headingId}
  style="--intro-top: 0px; --intro-h2-pt: 0px"
  class="flex flex-col gap-3xl pb-0 desktop:grid desktop:grid-cols-[2fr_3fr] desktop:items-start desktop:gap-6xl"
>
  <div class="flex flex-col desktop:sticky desktop:top-6xl">
    <BlockIntro intro={intro} headingId={headingId} />
    {trimmedCtaText && trimmedCtaLink && <div class="pt-xl desktop:pt-2xl">
      <LinkButton
        href={resolvedCta!.href}
        variant="secondary"
        mode="auto"
        external={resolvedCta!.external}
        document={resolvedCta!.document}
        iconSide={resolvedCta!.icon ? 'right' : 'none'}
        class="w-full mx-auto tablet:w-auto tablet:mx-0"
        linkText={trimmedCtaText}
        umamiLabel="button_cta"
        umamiBaseComponent="faq"
      >
        {trimmedCtaText}
        {resolvedCta!.icon && (
          <Icon name={resolvedCta!.icon} slot="icon-right" />
        )}
      </LinkButton>
    </div>}
  </div>

  <!-- Right column. data-faq-hold-position keeps a desktop click from
       dragging the sticky title. Scroll anchoring stays off this column
       only, so the title can still anchor. -->
  <div
    class="flex min-w-0 flex-col gap-lg [overflow-anchor:none] tablet:gap-xl desktop:pt-lg"
    data-faq-accordion
    data-faq-hold-position="true"
  >
    {renderedItems.map((item) => <details
      name={accordionName}
      data-faq-item
      class="group w-full scroll-mt-(--site-header-height) border-b border-neutral-25 pb-lg first:pt-0 last:border-b-0 last:pb-0 tablet:pb-xl desktop:scroll-mt-(--site-header-height-desktop) dark:border-neutral-75"
    >
      <summary
        class="flex w-full cursor-pointer list-none items-center justify-between gap-sm text-left [&::-webkit-details-marker]:hidden"
        {...faqToggleUmamiAttrs(item.question)}
      >
        <span
          class="text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-100 group-open:text-neutral-900 dark:text-neutral-0 dark:group-open:text-neutral-0"
        >
          {item.question}
        </span>
        <Icon
          name="arrow-down"
          class="size-8 shrink-0 text-link transition-transform duration-200 group-open:rotate-180"
        />
      </summary>
      <FaqAnswerPanel>
        <div
          data-prose-faq
          class="mt-md mb-0 pb-0 font-poppins text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-75 dark:text-neutral-50 [&_:is(p,li)]:text-inherit [&_:is(p,a,li):not(:where(th,td)_*)]:text-h5 tablet:[&_:is(p,a,li):not(:where(th,td)_*)]:text-h5-md desktop:[&_:is(p,a,li):not(:where(th,td)_*)]:text-h5-lg [&_p+p]:mt-md [&_p+ul]:mt-md [&_p+ol]:mt-md [&_ul+p]:mt-md [&_ol+p]:mt-md [&_li>p:first-of-type]:inline [&_:is(p,ul,ol,.table-scroll):last-child]:mb-0"
          set:html={item.answerHtml}
        />
      </FaqAnswerPanel>
    </details>)}
  </div>
</section>

<style>
  :global([data-component='GrantFaqSection'] [data-prose-faq] > :last-child) {
    margin-bottom: 0;
    margin-block-end: 0;
  }
</style>

<script>
  import { initFaqAccordion } from '@/scripts/faq-accordion'

  initFaqAccordion()
</script>
