---
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import { isExternalHref, parseMarkdown } from '@/utils'

interface FaqItem {
  question: string
  /** Markdown from the CKEditor `answer` field. */
  answer: string
}

interface Props {
  title: string
  subtitle: string
  description: string
  ctaText: string
  ctaLink: string
  items: FaqItem[]
}

const { title, subtitle, description, ctaText, ctaLink, items } = Astro.props
const { routeLocale } = Astro.locals

const renderedItems = await Promise.all(
  items.map(async (item) => ({
    question: item.question,
    answerHtml: await parseMarkdown(item.answer, {
      pathname: Astro.url.pathname,
      lang: routeLocale
    })
  }))
)
---

<div class="mx-auto max-w-content min-w-90">
  <div
    class="flex flex-col gap-xl desktop:flex-row desktop:items-start desktop:gap-5xl"
  >
    <!-- Left column: title at top, contact CTA pinned to bottom -->
    <div
      class="flex flex-col desktop:w-[38%] desktop:shrink-0 desktop:sticky desktop:top-6xl"
    >
      <h2
        class="font-poppins text-h3 tablet:text-h3-md desktop:text-h3-lg text-neutral-900 my-0"
      >
        {title}
      </h2>

      <div class="mt-5xl hidden desktop:block desktop:pt-0">
        <h3 class="font-poppins text-xl font-normal text-neutral-900 my-0">
          {subtitle}
        </h3>
        <p
          class="mt-lg font-poppins text-base leading-relaxed text-neutral-75 mb-0"
        >
          {description}
        </p>
        <div class="mt-2xl">
          <LinkButton
            href={ctaLink}
            variant="secondary"
            external={isExternalHref(ctaLink)}
          >
            {ctaText}
          </LinkButton>
        </div>
      </div>
    </div>

    <!-- Right column: accordion -->
    <div class="flex-1">
      {
        renderedItems.map((item, index) => (
          <details
            open={index === 0}
            class="group border-b border-neutral-200 py-2xl first:pt-0 "
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-xl [&::-webkit-details-marker]:hidden">
              <span class="font-poppins text-base font-normal group-open:text-neutral-900 tablet:text-xl desktop:text-2xl ">
                {item.question}
              </span>
              <Icon
                name="arrow-down"
                class="size-8 shrink-0 text-purple-600 transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <div
              data-prose-faq
              class="mt-lg font-poppins text-base text-neutral-75 tablet:text-xl desktop:text-xl [&_p]:m-0 [&_p+p]:mt-md [&_ul]:m-0 [&_ol]:m-0 [&_p+ul]:mt-md [&_p+ol]:mt-md [&_ul+p]:mt-md [&_ol+p]:mt-md [&_li>p:first-of-type]:inline [&_a]:text-neutral-75"
              set:html={item.answerHtml}
            />
          </details>
        ))
      }
    </div>

    <!-- Bottom CTA for mobile -->
    <div class="desktop:hidden">
      <h3 class="font-poppins text-xl font-normal text-neutral-900 my-0">
        {subtitle}
      </h3>
      <p
        class="mt-lg font-poppins text-base leading-relaxed text-neutral-75 mb-0"
      >
        {description}
      </p>
      <div class="mt-2xl">
        <LinkButton
          href={ctaLink}
          variant="secondary"
          external={isExternalHref(ctaLink)}
          class="w-full mx-auto"
        >
          {ctaText}
        </LinkButton>
      </div>
    </div>
  </div>
</div>
