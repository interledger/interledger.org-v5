---
import type { Grantee } from '@/utils'
import { useTranslations } from '@/utils'
import GranteeCard from './GranteeCard.astro'

interface Props {
  grantees: Grantee[]
}

const { grantees } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
---

<h1
  class="my-xl text-neutral-900 text-h2 tablet:text-h2-md desktop:my-3xl desktop:text-h2-lg"
>
  {t('grantee.title')}
</h1>

<div class="flex w-full flex-col gap-lg">
  <p class="m-0 text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-75">
    {t('grantee.description')}
  </p>
  <p
    class="m-0 text-body-lg-standard text-neutral-75 tablet:text-body-lg-standard-md"
  >
    {t('grantee.intro')}
  </p>
</div>

<ol
  class="list-none p-0 m-0 mt-4xl flex flex-col gap-2xl tablet:mt-5xl desktop:mt-5xl"
  aria-label={t('aria.grantee.list')}
>
  {grantees.map((grantee) => <GranteeCard grantee={grantee} />)}
</ol>
