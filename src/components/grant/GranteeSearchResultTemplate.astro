---
/**
 * Markup source for client-side grantee search results. grantee-search-result.ts
 * clones these templates and fills the [data-grantee-search-*] slots. Keep the
 * structure aligned with GranteeCard.astro; both take their classes from
 * granteeCardClasses.ts. The description carries the same
 * data-grantee-description hooks, so grantee-description.ts drives its
 * read-more toggle once the results are rendered.
 */
import Icon from '@/components/shared/Icon.astro'
import { buttonVariants } from '@/components/shared/buttonVariants'
import { useTranslations } from '@/utils'
import { granteeCardClasses as classes } from './granteeCardClasses'

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const reportLinkClass = buttonVariants({
  variant: 'secondary',
  mode: 'light',
  size: 'sm'
})
---

<template id="grantee-search-result-template">
  <li class={classes.card}>
    <article class="flex flex-col gap-lg">
      <div class={classes.header}>
        <div data-grantee-description class="flex min-w-0 flex-col gap-sm">
          <h3 class={classes.name} data-grantee-search-name></h3>
          <p
            class={classes.description}
            data-grantee-search-description
            data-grantee-description-text
            hidden
          ></p>
          <button
            type="button"
            hidden
            data-grantee-description-toggle
            data-label-more={t('grantee.read_more')}
            data-label-less={t('grantee.read_less')}
            class={classes.readMore}
            aria-expanded="false"
          >
            <span data-grantee-description-toggle-label>
              {t('grantee.read_more')}
            </span>
            <Icon name="arrow-down" class={classes.readMoreIcon} />
          </button>
        </div>
        <ul class={classes.meta} data-grantee-search-meta-wrap hidden>
          <li class={classes.metaItem} data-grantee-search-country-wrap hidden>
            <Icon name="map-pin" class={classes.metaIcon} />
            <span>
              <span class="sr-only">{t('aria.grantee.location')}: </span>
              <span data-grantee-search-country></span>
            </span>
          </li>
          <li class={classes.metaItem} data-grantee-search-date-wrap hidden>
            <Icon name="calendar" class={classes.metaIcon} />
            <time data-grantee-search-date>
              <span class="sr-only">{t('aria.grantee.date')}: </span>
              <span data-grantee-search-date-text></span>
            </time>
          </li>
        </ul>
      </div>

      <ul
        class={classes.tags}
        aria-label={t('aria.grantee.tags')}
        data-grantee-search-tags-wrap
        hidden
      ></ul>

      <div class="flex flex-col gap-md">
        <p class={classes.grantCount} data-grantee-search-grant-count></p>
        <ul
          class={classes.projects}
          aria-label={t('aria.grantee.projects')}
          data-grantee-search-projects
        ></ul>
      </div>
    </article>
  </li>
</template>

<template data-grantee-search-tag-template>
  <li class="m-0">
    <a
      class="inline-block no-underline px-sm py-xs text-body-sm-standard text-neutral-100 border border-neutral-50 rounded-full bg-transparent transition-colors duration-200 ease-in-out hover:border-neutral-75 hover:text-neutral-150 focus-visible:outline-none focus-visible:border-link"
    ></a>
  </li>
</template>

<template data-grantee-search-project-template>
  <li class={classes.project}>
    <div class="flex min-w-0 flex-col gap-2xs">
      <p class={classes.program} data-grantee-search-program hidden></p>
      <h5 class={classes.projectName} data-grantee-search-project-name></h5>
      <p
        class={classes.budget}
        data-grantee-search-budget
        data-template={t('grantee.project.committed')}
        hidden
      ></p>
    </div>
    <p class={classes.noReports} data-grantee-search-no-reports hidden>
      {t('grantee.reports.none')}
    </p>
    <ul class={classes.reports} data-grantee-search-reports hidden></ul>
  </li>
</template>

<template data-grantee-search-report-template>
  <li class="m-0">
    <a class={reportLinkClass}>
      <span data-grantee-search-report-label></span>
      <span class="sr-only" data-grantee-search-report-project></span>
    </a>
  </li>
</template>
