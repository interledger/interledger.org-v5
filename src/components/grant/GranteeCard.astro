---
import type { GranteeDirectoryEntry, GranteeReportLink } from '@/utils'
import {
  useTranslations,
  buildUmamiAttrs,
  generateSlug,
  getGranteeFilterUrl
} from '@/utils'
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import PillLink from '@/components/shared/PillLink.astro'
import {
  granteeCardClasses as classes,
  granteeGrantCountKey
} from './granteeCardClasses'

// GranteeSearchResultTemplate.astro mirrors this markup for search results.
// Change both together; the shared classes live in granteeCardClasses.ts.

interface Props {
  grantee: GranteeDirectoryEntry
  directoryPath: string
  selectedYear?: string
}

const { grantee, directoryPath, selectedYear } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const { pathname } = Astro.url

const tagAttrs = (tag: string, href: string) =>
  buildUmamiAttrs({
    pathname,
    lang: routeLocale,
    label: 'button_ui',
    baseComponent: 'grantee_tag',
    linkText: `#${tag}`,
    href
  })

const reportAttrs = (report: GranteeReportLink) =>
  buildUmamiAttrs({
    pathname,
    lang: routeLocale,
    label: 'button_card',
    baseComponent: 'grantee_cards',
    linkText: report.label,
    href: report.href
  })

const projectCount = grantee.projects.length
---

<li data-grantee-card class={classes.card}>
  <article class={classes.article}>
    <div class={classes.header}>
      <h3 class={classes.name}>{grantee.name}</h3>
      {(grantee.country || grantee.startLabel) && <ul class={classes.meta}>
        {grantee.country && <li class={classes.metaItem}>
          <Icon name="map-pin" class={classes.metaIcon} />
          <span>
            <span class="sr-only">{t('aria.grantee.location')}: </span>
            {grantee.country}
          </span>
        </li>}
        {grantee.startLabel && <li class={classes.metaItem}>
          <Icon name="calendar" class={classes.metaIcon} />
          <time datetime={grantee.startMonth}>
            <span class="sr-only">{t('aria.grantee.date')}: </span>
            {grantee.startLabel}
          </time>
        </li>}
      </ul>}
    </div>

    {grantee.tags.length > 0 && <ul
      class={classes.tags}
      aria-label={t('aria.grantee.tags')}
    >
      {grantee.tags.map((tag) => {
        const href = getGranteeFilterUrl(
          directoryPath,
          selectedYear,
          generateSlug(tag)
        )
        return <li class="m-0">
          <PillLink href={href} {...tagAttrs(tag, href)}>{tag}</PillLink>
        </li>
      })}
    </ul>}

    <div class={classes.grants}>
      <p class={classes.grantCount}>
        {t(granteeGrantCountKey(projectCount), { count: projectCount })}
      </p>
      <ul class={classes.projects} aria-label={t('aria.grantee.projects')}>
        {grantee.projects.map((project) => <li class={classes.project}>
          <div class="flex min-w-0 flex-col gap-xs">
            {project.program && <p class={classes.program}>
              {project.program}
            </p>}
            <h5 class={classes.projectName}>{project.name}</h5>
            {project.budgetLabel && <p class={classes.budget}>
              {t('grantee.project.committed', {
                amount: project.budgetLabel
              })}
            </p>}
          </div>
          {project.reports && project.reports.length === 0 && <p
            class={classes.noReports}
          >
            {t('grantee.reports.none')}
          </p>}
          {project.reports && project.reports.length > 0 && <ul
            class={classes.reports}
          >
            {project.reports.map((report) => <li class="m-0">
              <LinkButton
                href={report.href}
                variant="secondary"
                mode="light"
                size="sm"
                {...reportAttrs(report)}
              >
                {report.label}
                <span class="sr-only">, {project.name}</span>
              </LinkButton>
            </li>)}
          </ul>}
        </li>)}
      </ul>
    </div>
  </article>
</li>
