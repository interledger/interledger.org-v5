---
/**
 * Markup source for client-side blog search rows. blog-search-result.ts
 * clones this template and fills [data-blog-search-*] slots — keep structure
 * and Tailwind classes aligned with BlogCard.astro and BlogCardByline.astro
 * (search rows use a plain <img>, since a client-rendered row can't run
 * Astro's build-time image pipeline, and static category pills rather than
 * ArticleCategories' filter links, since category filtering doesn't apply
 * during search).
 *
 * The byline's author anchor holds both an avatar and the fallback icon; the
 * populate script removes the one a row doesn't use, and the whole anchor
 * when a post has no author.
 */
import FallbackAuthorIcon from '@/components/shared/FallbackAuthorIcon.astro'
---

<template id="blog-search-result-template">
  <li
    class="flex flex-col-reverse gap-xl m-0 pb-2xl border-b border-neutral-25 desktop:flex-row desktop:justify-between desktop:gap-3xl"
  >
    <div class="flex w-full flex-col gap-lg desktop:basis-[70%]">
      {/* Deliberate Figma-verified exception: drops to the h4 token from tablet. */}
      <h3 class="m-0">
        <a
          class="text-h3 text-neutral-150 underline decoration-transparent transition-all duration-200 hover:decoration-inherit tablet:text-h4-md desktop:text-h4-lg"
          data-blog-search-link
        ></a>
      </h3>
      <p
        class="m-0 text-body-lg-standard text-neutral-75"
        data-blog-search-snippet
      ></p>
      <ul
        class="flex flex-wrap gap-xs list-none m-0 p-0"
        data-blog-search-categories
        hidden
      ></ul>
      <div
        class="flex flex-col gap-md text-neutral-100 **:text-body-sm-standard tablet:flex-row tablet:flex-wrap tablet:gap-xl"
      >
        {/* Linked only when the author has a profile; the hover underline is
        scoped to [href] so an unlinked name doesn't look clickable. */}
        <a
          class="group/author flex flex-nowrap items-center gap-sm text-neutral-100 no-underline"
          target="_blank"
          rel="author noopener noreferrer"
          data-blog-search-author
        >
          <img
            class="m-0 size-10 shrink-0 rounded-full object-cover"
            width="40"
            height="40"
            alt=""
            loading="lazy"
            decoding="async"
            data-blog-search-author-avatar
          />
          <span class="shrink-0" data-blog-search-author-fallback>
            <FallbackAuthorIcon
              svgClasses="w-[40px] h-[40px] rounded-full shrink-0"
            />
          </span>
          <span
            class="underline decoration-transparent transition-all duration-200 hover-hover:group-[[href]:hover]/author:decoration-inherit"
            data-blog-search-author-name
          ></span>
        </a>
        <div class="flex gap-xl py-sm">
          <time data-blog-search-date></time>
          <span class="text-neutral-75" data-blog-search-reading-time></span>
        </div>
      </div>
    </div>
    <div
      class="w-full desktop:basis-[30%]"
      data-blog-search-thumbnail-wrap
      hidden
    >
      {/* bg-* utilities carry the LQIP that blog-search-result.ts paints in
      as background-image, matching OptimizedImage's blur-up. */}
      <img
        class="object-cover rounded-3xl w-full aspect-240/140 max-h-[220px] tablet:max-h-[400px] desktop:max-h-[220px] bg-cover bg-center bg-no-repeat"
        loading="lazy"
        sizes="(min-width: 1200px) 420px, 100vw"
        data-blog-search-thumbnail
      />
    </div>
  </li>
</template>

<template data-blog-search-category-template>
  <li class="m-0">
    <span
      class="inline-block px-sm py-xs text-body-sm-standard text-neutral-100 border border-neutral-50 rounded-full bg-transparent"
    ></span>
  </li>
</template>
