---
import type { FoundationBlogFrontmatterType } from '@/schemas/content'
import type { BlogThumbnail } from '@/types/blog'
import {
  type UmamiAttrs,
  translatePath,
  COLLECTION_INDEX_SLUG,
  twMerge
} from '@/utils'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import ArticleCategories from './ArticleCategories.astro'
import BlogCardByline from './BlogCardByline.astro'

interface Props {
  blogData: FoundationBlogFrontmatterType
  umamiAttrs: (href: string, linkText: string) => UmamiAttrs
  excerpt: string
  postPath: string
  thumbnail: BlogThumbnail | null
  readingTime: number
  featured?: boolean
}

const {
  blogData,
  umamiAttrs,
  excerpt,
  postPath,
  thumbnail,
  readingTime,
  featured = false
} = Astro.props
const { routeLocale } = Astro.locals
const blogPath = translatePath(
  'foundation-blog',
  routeLocale,
  COLLECTION_INDEX_SLUG
)

const cardClasses = twMerge(
  'group/card relative flex flex-col-reverse gap-xl m-0 desktop:flex-1',
  // Stack full-width image on mobile/tablet (same as featured); side-by-side from desktop.
  !featured &&
    'pb-2xl border-b border-neutral-25 desktop:flex-row desktop:justify-between desktop:gap-3xl'
)
const cardHeaderClasses = twMerge(
  'text-h3 text-neutral-150 underline decoration-transparent transition-all duration-200 group-[&:hover:not(:has(.card-nested:hover))]/card:decoration-inherit desktop:text-h4-lg',
  featured ? 'tablet:text-h3-md' : 'tablet:text-h4-md'
)
// Full-width image below desktop, side-by-side ~30% column from desktop.
// A single max-h-[220px] crops banners at any width above ~377px (aspect-240/140),
// so mobile/tablet use a higher cap. Desktop returns to 220px in the narrow column.
const cardImageClasses =
  'object-cover rounded-3xl w-full aspect-240/140 max-h-[220px] tablet:max-h-[400px] desktop:max-h-[220px]'
const cardImageBorderClasses =
  'pointer-events-none absolute inset-0 z-1 rounded-3xl border-[3px] border-transparent transition-colors duration-200 group-[&:hover:not(:has(.card-nested:hover))]/card:border-orchid-100'
const cardBodyClasses = twMerge(
  'flex w-full flex-col gap-lg [&_a]:relative [&_a]:z-1',
  !featured && 'desktop:basis-[70%]'
)
const cardMediaClasses = twMerge('w-full', !featured && 'desktop:basis-[30%]')
---

<li class={cardClasses}>
  <div class={cardBodyClasses}>
    <h3 class="m-0">
      <a
        href={postPath}
        class={cardHeaderClasses}
        {...umamiAttrs(postPath, blogData.title)}
      >
        {blogData.title}
      </a>
    </h3>
    <p
      class="m-0 text-body-lg-standard text-neutral-75 tablet:text-body-lg-standard-md"
    >
      {blogData.description ? blogData.description : excerpt}
    </p>
    {
      blogData.categories.length > 0 && (
        <div class="card-nested">
          <ArticleCategories categories={blogData.categories} path={blogPath} />
        </div>
      )
    }
    <BlogCardByline
      bio={blogData.articleBios[0] ?? null}
      date={blogData.date}
      readingTime={readingTime}
      featured={featured}
      bylineClasses={featured ? 'flex-row' : ''}
    />
  </div>
  <div class={cardMediaClasses}>
    {
      thumbnail && (
        <div class="relative">
          <OptimizedImage
            loading={featured ? 'eager' : 'lazy'}
            fetchpriority={featured ? 'high' : 'auto'}
            src={thumbnail.src}
            width={1100}
            height={600}
            alt={thumbnail.alt}
            class={cardImageClasses}
          />
          <span aria-hidden="true" class={cardImageBorderClasses} />
        </div>
      )
    }
  </div>
  <a
    href={postPath}
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 z-0"
    {...umamiAttrs(postPath, blogData.title)}></a>
</li>
