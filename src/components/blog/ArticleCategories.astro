---
import type { BlogCategory } from '@/schemas/content'
import {
  buildUmamiAttrs,
  getTermUrl,
  translateTerm,
  useTranslations,
  CATEGORY_SEGMENT
} from '@/utils'
import PillLink from '@/components/shared/PillLink.astro'
interface Props {
  categories: BlogCategory[]
  path: string
}
const { categories, path } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const categoryAttrs = (label: string, href: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'button_ui',
    baseComponent: 'category_filter',
    linkText: `#${label}`,
    href
  })
---

<nav aria-label={t('aria.article_categories')}>
  <ul class="flex flex-wrap gap-xs list-none m-0 p-0">
    {
      categories.map((category) => {
        const label = translateTerm('blog.categories', category, t)
        const href = getTermUrl(path, CATEGORY_SEGMENT, category)
        return (
          <li class="m-0">
            <PillLink href={href} {...categoryAttrs(label, href)}>
              {label}
            </PillLink>
          </li>
        )
      })
    }
  </ul>
</nav>
