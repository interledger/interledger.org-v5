---
import type { AuthorBioType } from '@/schemas/content'
import {
  useTranslations,
  formatDate,
  twMerge,
  safeAbsoluteHref,
  buildUmamiAttrs
} from '@/utils'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'
import FallbackAuthorIcon from '@/components/shared/FallbackAuthorIcon.astro'

interface Props {
  bio: AuthorBioType | null
  date: Date
  readingTime: number
  featured: boolean
  bylineClasses: string
}

const { bio, date, readingTime, featured, bylineClasses: classes } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const bylineClasses = twMerge(
  'flex flex-col gap-md text-neutral-100 **:text-body-sm-standard tablet:flex-row tablet:flex-wrap tablet:gap-xl',
  classes
)
const authorHref = safeAbsoluteHref(bio?.link)
const authorLink = authorHref
  ? {
      href: authorHref,
      umami: buildUmamiAttrs({
        pathname: Astro.url.pathname,
        lang: routeLocale,
        label: 'link',
        baseComponent: 'blog',
        href: authorHref,
        linkText: bio?.author ?? ''
      })
    }
  : null
const AuthorWrap = authorLink ? 'a' : 'div'
const authorWrapProps =
  bio && authorLink
    ? {
        href: authorLink.href,
        'aria-label': t('aria.author_profile', {
          author: bio.author,
          newTab: t('aria.opens_new_tab')
        }),
        class:
          'card-nested group/author flex flex-nowrap items-center gap-sm text-neutral-100 no-underline',
        target: '_blank',
        rel: 'author noopener noreferrer',
        ...authorLink.umami
      }
    : { class: 'flex flex-nowrap items-center gap-sm' }
---

<div class={bylineClasses}>
  {
    bio && (
      <AuthorWrap {...authorWrapProps}>
        {bio.image ? (
          <OptimizedImage
            src={bio.image}
            alt=""
            width={40}
            height={40}
            class="m-0 size-10 rounded-full object-cover"
            pictureClass="shrink-0"
            loading={featured ? 'eager' : 'lazy'}
            fetchpriority={featured ? 'high' : 'auto'}
          />
        ) : (
          <FallbackAuthorIcon svgClasses="w-[40px] h-[40px] rounded-full shrink-0" />
        )}
        <span
          class={
            authorLink
              ? 'underline decoration-transparent transition-all duration-200 hover-hover:group-hover/author:decoration-inherit'
              : undefined
          }
        >
          {bio.author}
        </span>
      </AuthorWrap>
    )
  }
  <div class="flex gap-xl py-sm">
    <time datetime={date.toISOString()}>
      {formatDate(date, routeLocale)}
    </time>
    <span class="text-neutral-75"
      >{t('blog.reading_time', { readingTime })}</span
    >
  </div>
</div>
