---
import {
  useTranslations,
  buildUmamiAttrs,
  stripPagination,
  CATEGORY_SEGMENT,
  ALL_TERM_SLUG
} from '@/utils'
import type { Locale } from '@/utils'
import FilterDropdown from '@/components/shared/FilterDropdown.astro'
import FilterDropdownOption from '@/components/shared/FilterDropdownOption.astro'

interface Props {
  routeLocale: Locale
  contentLang: Locale
}

const { routeLocale, contentLang } = Astro.props
const t = useTranslations(routeLocale)

// Derive lang-switch hrefs from the current pathname so that any active
// category filter (including /category/all) is preserved when switching.
// - On a /lang/ URL: swap the locale suffix, keeping the rest of the path.
// - Otherwise: append /lang/<locale> to the current path.
const pathname = stripPagination(Astro.url.pathname)
const base = pathname.includes('/lang/')
  ? pathname.replace(/\/lang\/[^/]+$/, '')
  : pathname.includes(`/${CATEGORY_SEGMENT}/`)
    ? pathname
    : `${pathname}/${CATEGORY_SEGMENT}/${ALL_TERM_SLUG}`
const enHref = `${base}/lang/en`
const esHref = `${base}/lang/es`

const isEnActive = contentLang === 'en'
const isEnActiveOnEs = isEnActive && routeLocale === 'es'
const isEsActive = contentLang === 'es'

const btnAttrs = (href: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'button_ui',
    baseComponent: 'content_lang_filter',
    href
  })
---

<div
  class="flex flex-col flex-wrap gap-xl text-body-sm-emphasis text-neutral-75 tablet:flex-row tablet:items-center tablet:gap-md"
>
  <div class="flex flex-wrap items-center gap-md">
    <FilterDropdown
      id="language-filter-details"
      label={t('blog.lang_filter.label')}
      value={isEsActive
        ? t('blog.lang_filter.spanish')
        : t('blog.lang_filter.english')}
    >
      <FilterDropdownOption
        href={enHref}
        selected={isEnActive}
        {...btnAttrs(enHref)}
      >
        {t('blog.lang_filter.english')}
      </FilterDropdownOption>
      <FilterDropdownOption
        href={esHref}
        selected={isEsActive}
        {...btnAttrs(esHref)}
      >
        {t('blog.lang_filter.spanish')}
      </FilterDropdownOption>
    </FilterDropdown>
  </div>
  {
    isEsActive && (
      <span class="text-body-sm-standard italic">
        ({t('blog.lang_filter.more_en_available')})
      </span>
    )
  }
  {
    isEnActiveOnEs && (
      <span class="text-body-sm-standard italic">
        ({t('blog.lang_filter.es_available')})
      </span>
    )
  }
</div>
