---
import { type Talk } from '@/types/summit'
import {
  type Locale,
  generateSlug,
  truncateText,
  getTranslation,
  buildSessionCardUmamiAttrs,
  joinPagePath
} from '@/utils'

interface Props {
  sessions: Talk[]
  sessionBaseHref: string
  lang: Locale
  year: string
}
const { sessions, sessionBaseHref, lang } = Astro.props

const sessionsWithLinks = sessions.map((session) => {
  const translation = getTranslation(session, lang)
  const title = translation?.title ?? session.title
  const description = translation?.description ?? session.description
  return {
    ...session,
    title,
    description,
    href: joinPagePath(sessionBaseHref, generateSlug(session.title))
  }
})

const sessionAttrs = (title: string, href: string) =>
  buildSessionCardUmamiAttrs(Astro.url.pathname, lang, href, title)
---

<ul class="m-0 list-none p-0">
  {sessionsWithLinks.map((session) => <li class="mb-lg last:mb-0">
    <article>
      <h2 class="mb-sm">
        <a
          href={session.href}
          class="text-h4 text-neutral-900 no-underline tablet:text-h4-md desktop:text-h4-lg hover:text-link"
          {...sessionAttrs(session.title, session.href)}
        >
          {session.title}
        </a>
      </h2>
      {session.description && <p
        class="mb-0 text-body-lg-standard text-neutral-100"
      >
        {truncateText(session.description)}
      </p>}
    </article>
  </li>)}
</ul>
