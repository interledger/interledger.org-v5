---
import type { Talk, TalkPreview } from '@/types/summit'
import {
  type Locale,
  useTranslations,
  formatDateTime,
  getDurationInMinutes
} from '@/utils'

interface Props {
  talk: TalkPreview | Talk
  lang: Locale
  showRecordingLabel?: boolean
}

const { talk, showRecordingLabel = false, lang } = Astro.props
const t = useTranslations(lang)
---

<>
  <p class="mb-md text-body-lg-standard text-neutral-100">
    <time datetime={talk.startsAt}>{formatDateTime(talk.startsAt, lang)} </time>
    - {getDurationInMinutes(talk.startsAt, talk.endsAt)} min
    {talk.recordingUrl && showRecordingLabel && <span
      >({t('summit.recording_available')})</span
    >}
  </p>
  {talk.translations.length > 0 && <ul
    aria-label={t('summit.available_translations')}
    class="m-0 mb-md flex list-none flex-row flex-wrap gap-sm p-0 [&_li]:rounded-sm [&_li]:bg-ice-indigo-100 [&_li]:px-sm [&_li]:py-xs [&_li]:text-caption [&_li]:font-semibold [&_li]:text-neutral-900"
  >
    {talk.translations.map((language) => <li>{language}</li>)}
  </ul>}
</>
