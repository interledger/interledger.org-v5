---
import type { Speaker } from '@/types/summit'
import {
  generateSlug,
  buildUmamiAttrs,
  joinPagePath,
  AVATAR_CDN_WIDTHS
} from '@/utils'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'

interface Props {
  speaker: Speaker
  basePath: string
  /** 3 when the list sits under its own heading, as on a session page. */
  headingLevel?: 2 | 3
}

const { speaker, basePath, headingLevel = 2 } = Astro.props
const Heading = headingLevel === 3 ? 'h3' : 'h2'
const { routeLocale } = Astro.locals
const href = joinPagePath(basePath, generateSlug(speaker.name))

const attrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'button_card',
  baseComponent: 'speaker_cards',
  href,
  linkText: speaker.name
})
---

<li class="m-0 min-w-0">
  <a
    href={href}
    class="group flex items-center gap-lg rounded-lg no-underline hover:no-underline tablet:block"
    {...attrs}
  >
    <div
      class="aspect-square w-6xl shrink-0 overflow-hidden tablet:w-full tablet:max-w-50 rounded-3xl bg-neutral-25 outline-[3px] outline-transparent transition-[outline-color] duration-slow group-hover:outline-link group-focus-visible:outline-link"
    >
      <OptimizedImage
        src={speaker.profilePicture}
        alt=""
        width={240}
        height={240}
        sizes="(min-width: 810px) 200px, 120px"
        widths={AVATAR_CDN_WIDTHS}
        loading="lazy"
        pictureClass="block h-full w-full"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="min-w-0 desktop:pr-2xl">
      <Heading
        class="mt-0 mb-md text-h4 text-link underline decoration-current tablet:mt-lg tablet:text-h4-md desktop:text-h4-lg! group-hover:text-link-hover group-focus-visible:text-link-hover"
      >
        {speaker.name}
      </Heading>
      {speaker.tagLine && <p
        class="m-0 text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-900 dark:text-neutral-0"
      >
        {speaker.tagLine}
      </p>}
    </div>
  </a>
</li>
