---
import type { TalkPreview } from '@/types/summit'
import {
  generateSlug,
  truncateText,
  type Locale,
  getTranslation,
  buildSessionCardUmamiAttrs,
  joinPagePath,
  AVATAR_CDN_WIDTHS
} from '@/utils'
import SessionSubheader from './SessionSubheader.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'

interface Props {
  talkPreview: TalkPreview
  basePath: string
  lang: Locale
  year: string
}

const { talkPreview, basePath, lang } = Astro.props
const href = joinPagePath(basePath, generateSlug(talkPreview.title))
const translation = getTranslation(talkPreview, lang)
const description = translation?.description ?? talkPreview.description
const title = translation?.title ?? talkPreview.title

const attrs = buildSessionCardUmamiAttrs(Astro.url.pathname, lang, href, title)
---

<li class="flex flex-col gap-xl tablet:flex-row">
  <OptimizedImage
    class="w-[200px] h-[200px] rounded-full border-2 border-[var(--color-primary)]"
    pictureClass="shrink-0"
    src={talkPreview.speakerImage}
    alt={talkPreview.speakerName ?? ''}
    width={200}
    height={200}
    sizes="200px"
    widths={AVATAR_CDN_WIDTHS}
    loading="lazy"
  />
  <div class="[&_p]:text-body-sm-standard">
    <h2 class="mb-sm">
      <a
        href={href}
        class="text-h3 text-neutral-900 no-underline tablet:text-h3-md desktop:text-h3-lg hover:text-link"
        {...attrs}
      >
        {title}
      </a>
    </h2>
    <SessionSubheader
      talk={talkPreview}
      showRecordingLabel={true}
      lang={lang}
    />
    {description && <p>{truncateText(description)}</p>}
  </div>
</li>
