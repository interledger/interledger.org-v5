---
import type { TalkPreview } from '@/types/summit'
import {
  generateSlug,
  truncateText,
  type Locale,
  getTranslation,
  buildSessionCardUmamiAttrs,
  joinPagePath,
  AVATAR_CDN_WIDTHS
} from '@/utils'
import SessionSubheader from './SessionSubheader.astro'
import OptimizedImage from '@/components/shared/OptimizedImage.astro'

interface Props {
  talkPreview: TalkPreview
  basePath: string
  lang: Locale
}

const { talkPreview, basePath, lang } = Astro.props
const href = joinPagePath(basePath, generateSlug(talkPreview.title))
const translation = getTranslation(talkPreview, lang)
const description = translation?.description ?? talkPreview.description
const title = translation?.title ?? talkPreview.title

const attrs = buildSessionCardUmamiAttrs(Astro.url.pathname, lang, href, title)
---

<!-- A row, not a grid card: the photo sits beside the text from tablet up.
     Only the title is a link; the photo outline follows its hover and focus. -->
<li class="group flex flex-col gap-lg tablet:flex-row tablet:gap-xl">
  <div
    class="aspect-square w-6xl shrink-0 overflow-hidden rounded-3xl bg-neutral-25 outline-[3px] outline-transparent transition-[outline-color] duration-slow tablet:w-50 group-has-[a:hover]:outline-link group-has-[a:focus-visible]:outline-link"
  >
    <OptimizedImage
      src={talkPreview.speakerImage}
      alt={talkPreview.speakerName ?? ''}
      width={240}
      height={240}
      sizes="(min-width: 810px) 200px, 120px"
      widths={AVATAR_CDN_WIDTHS}
      loading="lazy"
      pictureClass="block h-full w-full"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="min-w-0">
    <!-- Size on the link, not the h2: the summit prose styles give every
         <a> a body size, and only a class on the element itself beats them. -->
    <h2
      class="mt-0 mb-md text-h4 tablet:mt-lg tablet:text-h4-md desktop:text-h4-lg"
    >
      <a
        href={href}
        class="text-h4 text-link underline decoration-current tablet:text-h4-md desktop:text-h4-lg hover:text-link-hover"
        {...attrs}
      >
        {title}
      </a>
    </h2>
    <SessionSubheader
      talk={talkPreview}
      showRecordingLabel={true}
      lang={lang}
    />
    {description && <p
      class="m-0 text-body-lg-standard text-neutral-100 dark:text-neutral-50"
    >
      {truncateText(description)}
    </p>}
  </div>
</li>
