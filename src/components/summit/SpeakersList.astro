---
import type { Speaker } from '@/types/summit'
import SpeakerCard from './SpeakerCard.astro'
import { useTranslations } from '@/utils'

interface Props {
  speakers: Speaker[]
  basePath: string
  /**
   * `grid` for the speakers index; `stack` for a session page: each photo
   * stays above its name on mobile too, in the index's columns from tablet.
   */
  layout?: 'grid' | 'stack'
  /** Passed to each card: 3 when the list sits under its own heading. */
  headingLevel?: 2 | 3
}

const { speakers, basePath, layout = 'grid', headingLevel = 2 } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
const LAYOUT_CLASSES: Record<NonNullable<Props['layout']>, string> = {
  grid: 'tablet:grid-cols-3 tablet:gap-x-xl tablet:gap-y-3xl desktop:grid-cols-4',
  stack:
    'tablet:grid-cols-3 tablet:gap-x-xl tablet:gap-y-3xl desktop:grid-cols-4 desktop:gap-x-2xl'
}
---

{speakers.length > 0 ? (
  <ul
    class:list={[
      'm-0 grid list-none grid-cols-1 gap-2xl p-0',
      LAYOUT_CLASSES[layout]
    ]}
  >
    {speakers.map((speaker) => (
      <SpeakerCard
        speaker={speaker}
        basePath={basePath}
        stacked={layout === 'stack'}
        headingLevel={headingLevel}
      />
    ))}
  </ul>
) : (
  <p>{t('summit.no_speakers')}</p>
)}
