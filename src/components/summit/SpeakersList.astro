---
import type { Speaker } from '@/types/summit'
import SpeakerCard from './SpeakerCard.astro'
import { useTranslations } from '@/utils'

interface Props {
  speakers: Speaker[]
  basePath: string
  /** Passed to each card: 3 when the list sits under its own heading. */
  headingLevel?: 2 | 3
}

const { speakers, basePath, headingLevel = 2 } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)
---

{speakers.length > 0 ? (
  <ul
    class="m-0 grid list-none grid-cols-1 gap-2xl p-0 tablet:grid-cols-3 tablet:gap-x-xl tablet:gap-y-3xl desktop:grid-cols-4"
  >
    {speakers.map((speaker) => (
      <SpeakerCard
        speaker={speaker}
        basePath={basePath}
        headingLevel={headingLevel}
      />
    ))}
  </ul>
) : (
  <p>{t('summit.no_speakers')}</p>
)}
