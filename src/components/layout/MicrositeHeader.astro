---
/**
 * Summit site header.
 * Composes navigation menu, action links, and mobile toggle.
 */
import FoundationLogo from '@/components/logos/FoundationLogo.astro'
import {
  getNavigation,
  useTranslations,
  translatePath,
  HOME_CONTENT_SLUG,
  buildNavLinkUmamiAttrs,
  buildNavCtaUmamiAttrs
} from '@/utils'
import MicrositeNavMenu from '@/components/layout/MicrositeNavMenu.astro'
import MicrositeNavActions from '@/components/layout/MicrositeNavActions.astro'
import HamburgerButton from '@/components/shared/HamburgerButton.astro'
import type { MicrositeSite } from '@/types/navigation'

interface Props {
  site: MicrositeSite
}

const { site } = Astro.props
const { routeLocale } = Astro.locals
const { mainMenu, ctaButton } = getNavigation(site, routeLocale)
const t = useTranslations(routeLocale)

const homePath = translatePath('summit-pages', routeLocale, HOME_CONTENT_SLUG)
const navLabel = t('nav.summit')
const logoLabel = t('aria.logo.summit')

const navLink = (href: string, linkText?: string, ariaLabel?: string) =>
  buildNavLinkUmamiAttrs(
    Astro.url.pathname,
    routeLocale,
    href,
    linkText,
    ariaLabel
  )

const ctaLink = (href: string, linkText?: string) =>
  buildNavCtaUmamiAttrs(Astro.url.pathname, routeLocale, href, linkText)
---

<header
  class="bg-black px-2xl sticky top-0 z-[2] border-t-2 border-neutral-75 shadow text-white text-[1rem]"
  role="banner"
>
  <nav
    class="flex items-center justify-between desktop:grid desktop:grid-cols-[1fr_auto_1fr] desktop:gap-xl max-desktop:h-[var(--site-header-height)]"
    role="navigation"
    aria-labelledby="block-microsite-navigation-menu"
    id="block-microsite-navigation"
    data-nav
  >
    <h2 class="sr-only" id="block-microsite-navigation-menu">{navLabel}</h2>
    <a
      href={homePath}
      class="w-[11em] flex-none desktop:col-start-1 desktop:col-end-2 desktop:justify-self-start desktop:z-[1]"
      aria-label={logoLabel}
      {...navLink(homePath, undefined, logoLabel)}
    >
      <FoundationLogo />
    </a>
    <div
      class="header-nav-wrapper header-nav-wrapper--microsite"
      data-nav-wrapper
      data-lenis-prevent
      data-offscreen="true"
      id="micrositeNavLinks"
    >
      <MicrositeNavMenu menuGroups={mainMenu} />
      {
        ctaButton && (
          <a
            class="block whitespace-nowrap py-xl px-lg no-underline text-current transition-colors duration-150 hover:bg-[#444] desktop:hidden"
            href={ctaButton.href || '#'}
            {...ctaLink(ctaButton.href || '#', ctaButton.label)}
            {...(ctaButton.openInNewTab
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {ctaButton.label}
          </a>
        )
      }
    </div>
    <MicrositeNavActions ctaButton={ctaButton} />
    <HamburgerButton
      controlsId="micrositeNavLinks"
      iconId="micrositeMenuIcon"
    />
  </nav>
</header>

<script>
  import './microsite-header.ts'
</script>
