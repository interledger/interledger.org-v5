---
import {
  translatePath,
  useTranslations,
  buildUmamiAttrs,
  getNavigation,
  localizeRoute,
  socialLinks,
  getFooterOnlyColumn,
  HACKATHON_HOME_SLUG,
  twMerge
} from '@/utils'
import type { NavigationSite } from '@/types/navigation'
import Icon from '@/components/shared/Icon.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import InterledgerIcon from '@/components/logos/InterledgerIcon.astro'
import HackathonFooterLogo from '@/components/logos/HackathonFooterLogo.astro'

interface Props {
  site?: NavigationSite
}

const { site = 'foundation' } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

// A hackathon primary carries no arrow, Subscribe included. See
// A hackathon primary carries no arrow (INTORG-1072). Keyed on the `site` prop
// rather than the base path because this component is already told its site,
// and a footer renders the same way whatever page it sits under.
const subscribeIcon = site === 'hackathon' ? null : 'arrow-right'

const { mainMenu } = getNavigation(site, routeLocale)

const footerOnlyColumn = getFooterOnlyColumn(site, routeLocale)

const footerColumns = footerOnlyColumn
  ? [...mainMenu, footerOnlyColumn]
  : mainMenu

const subscribeHref = translatePath(
  'foundation-pages',
  routeLocale,
  'subscribe'
)
const contactHref = translatePath('foundation-pages', routeLocale, 'contact')
const homeHref = localizeRoute('/', routeLocale)
const hackathonHomeHref = translatePath(
  'hackathon-pages',
  routeLocale,
  HACKATHON_HOME_SLUG
)

const footerLink = (href: string, ariaLabel?: string, linkText?: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'nav',
    baseComponent: 'footer',
    href,
    ariaLabel,
    linkText
  })

const footerSocialLink = (href: string, ariaLabel?: string) =>
  buildUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    label: 'button_cta',
    baseComponent: 'footer',
    href,
    ariaLabel
  })

const currentPath = Astro.url.pathname.replace(/\/$/, '')
const isActive = (href: string | null | undefined) =>
  !!href && currentPath === localizeRoute(href, routeLocale).replace(/\/$/, '')
const isHackathonSite = site === 'hackathon'

const footerExternalLinkIconClass = 'size-4 shrink-0 translate-y-[-1px]'
const footerLogoLinkClass =
  'inline-block rounded-sm text-neutral-100 visited:text-neutral-100 transition-opacity hover:opacity-80 focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-offset-4 focus-visible:outline-none [-webkit-tap-highlight-color:transparent]'
const navigationUlClass = twMerge(
  'm-0 grid list-none grid-cols-1 gap-3xl p-0 tablet:grid-cols-3 desktop:grid-cols-6',
  isHackathonSite ? 'tablet:grid-cols-2 desktop:grid-cols-3' : ''
)
---

<footer
  data-component="SiteFooter"
  class="bg-ice-mint-50 dark:bg-ice-indigo-100 px-lg tablet:px-xl desktop:px-3xl-tight"
  role="contentinfo"
>
  <div class="mx-auto max-w-wide min-w-[360px]">
    <!-- Top: Subscribe | Contact | Social -->
    <div
      class="grid grid-cols-1 gap-3xl pt-4xl pb-3xl tablet:pt-3xl-tight tablet:gap-2xl desktop:pt-4xl desktop:grid-cols-6 desktop:gap-4xl"
    >
      <!-- Subscribe -->
      <section
        aria-labelledby="footer-subscribe-heading"
        class="desktop:col-span-2"
      >
        <h5
          id="footer-subscribe-heading"
          class="mb-md text-h5-md text-neutral-900 desktop:text-h5-lg"
        >
          {t('footer.stay_up_to_date')}
        </h5>
        <p class="mb-xl text-body-sm-standard text-neutral-75">
          {t('footer.newsletter_description')}
        </p>
        <LinkButton
          href={subscribeHref}
          size="lg"
          iconSide={subscribeIcon ? 'right' : 'none'}
          class="w-full tablet:w-auto"
          {...buildUmamiAttrs({
            pathname: Astro.url.pathname,
            lang: routeLocale,
            label: 'button_cta',
            baseComponent: 'footer',
            href: subscribeHref,
            linkText: t('footer.subscribe')
          })}
        >
          {t('footer.subscribe')}
          {subscribeIcon && <Icon slot="icon-right" name={subscribeIcon} />}
        </LinkButton>
      </section>

      <!-- Contact -->
      <section
        aria-labelledby="footer-contact-heading"
        class="desktop:col-span-2"
      >
        <h5
          id="footer-contact-heading"
          class="mb-md text-h5-md text-neutral-900 desktop:text-h5-lg"
        >
          {t('footer.contact_us')}
        </h5>
        <p class="mb-xl text-body-sm-standard text-neutral-75">
          {t('footer.contact_description')}
        </p>
        <LinkButton
          href={contactHref}
          variant="secondary"
          size="lg"
          class="w-full tablet:max-w-fit"
          {...buildUmamiAttrs({
            pathname: Astro.url.pathname,
            lang: routeLocale,
            label: 'button_cta',
            baseComponent: 'footer',
            href: contactHref,
            linkText: t('footer.contact_us')
          })}
        >
          {t('footer.contact_us')}
        </LinkButton>
      </section>

      <!-- Social Links -->
      <section
        aria-labelledby="footer-social-heading"
        class="desktop:col-span-2"
      >
        <h5
          id="footer-social-heading"
          class="mb-md text-h5-md text-neutral-900 desktop:text-h5-lg"
        >
          {t('footer.social_links')}
        </h5>
        <ul
          class="mb-0 mt-md mx-0 flex list-none flex-wrap gap-md p-0 tablet:gap-xl
          desktop:gap-lg"
          role="list"
        >
          {
            socialLinks.map((link) => (
              <li>
                <LinkButton
                  href={link.href}
                  variant="secondary"
                  size="lg"
                  iconOnly
                  external
                  aria-label={t(link.labelKey)}
                  {...footerSocialLink(link.href, t(link.labelKey))}
                >
                  <Icon name={link.icon} class="size-6" />
                </LinkButton>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Navigation columns -->
    <nav
      aria-label={t('footer.nav_label')}
      class="border-t border-neutral-50 py-3xl"
    >
      <ul class={navigationUlClass} role="list">
        {
          footerColumns.map((group, groupIndex) => {
            const groupHeadingId = `footer-nav-group-${groupIndex}`
            return (
              <li class="min-w-0">
                <h6
                  id={groupHeadingId}
                  class="mb-xl text-h4 tablet:text-body-lg-standard-md font-normal uppercase tracking-wide text-neutral-900"
                >
                  {group.label}
                </h6>

                {group.items && group.items.length > 0 && !group.subGroups && (
                  <ul
                    class="m-0 flex list-none flex-col gap-xl tablet:gap-md p-0"
                    role="list"
                    aria-labelledby={groupHeadingId}
                  >
                    {group.items.map((item) => (
                      <li>
                        <LinkButton
                          variant="ghost"
                          href={item.href ?? '#'}
                          class={`whitespace-nowrap${item.openInNewTab ? ' gap-sm' : ''}`}
                          aria-current={
                            isActive(item.href) ? 'page' : undefined
                          }
                          external={item.openInNewTab}
                          {...footerLink(
                            item.href ?? '#',
                            undefined,
                            item.label
                          )}
                        >
                          {item.label}
                          {item.openInNewTab && (
                            <Icon
                              slot="icon-right"
                              name="external-link"
                              class={footerExternalLinkIconClass}
                            />
                          )}
                        </LinkButton>
                      </li>
                    ))}
                  </ul>
                )}

                {group.subGroups && group.subGroups.length > 0 && (
                  <div class="flex flex-col gap-xl tablet:flex-wrap desktop:flex-col">
                    {group.subGroups.map((sub, subIndex) => {
                      const subHeadingId = `${groupHeadingId}-sub-${subIndex}`
                      return (
                        <div class="flex flex-col gap-md">
                          <p
                            id={subHeadingId}
                            class="mb-2 text-caption font-normal uppercase tracking-wide text-neutral-100 whitespace-nowrap tablet:text-neutral-900"
                          >
                            <span class="border-b border-neutral-100 pb-sm tablet:border-neutral-900">
                              {sub.label}
                            </span>
                          </p>
                          <ul
                            class="m-0 flex list-none flex-col gap-xl tablet:gap-md p-0"
                            role="list"
                            aria-labelledby={subHeadingId}
                          >
                            {sub.items.map((item) => (
                              <li>
                                <LinkButton
                                  variant="ghost"
                                  href={item.href ?? '#'}
                                  class={`whitespace-nowrap${item.openInNewTab ? ' gap-sm' : ''}`}
                                  aria-current={
                                    isActive(item.href) ? 'page' : undefined
                                  }
                                  external={item.openInNewTab}
                                  {...footerLink(
                                    item.href ?? '#',
                                    undefined,
                                    item.label
                                  )}
                                >
                                  {item.label}
                                  {item.openInNewTab && (
                                    <Icon
                                      slot="icon-right"
                                      name="external-link"
                                      class={footerExternalLinkIconClass}
                                    />
                                  )}
                                </LinkButton>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )
                    })}
                  </div>
                )}
              </li>
            )
          })
        }
      </ul>
    </nav>

    <!-- Bottom: copyright, legal links, logo -->
    <div
      class="border-t border-neutral-50 pt-3xl pb-3xl-tight text-center flex flex-col items-center gap-3xl"
    >
      <p class="text-body-sm-standard text-neutral-75">
        {t('footer.copyright')}
      </p>
      {
        isHackathonSite && (
          <a
            href={hackathonHomeHref}
            aria-label={t('footer.logo_hackathon')}
            class={footerLogoLinkClass}
            {...footerLink(
              hackathonHomeHref,
              t('footer.logo_hackathon'),
              t('footer.logo_hackathon')
            )}
          >
            <HackathonFooterLogo class="h-6 w-auto tablet:h-7.5 desktop:h-8.75" />
          </a>
        )
      }
      <a
        href={homeHref}
        aria-label={t('footer.logo_home')}
        class={footerLogoLinkClass}
        {...footerLink(homeHref, t('footer.logo_home'), t('footer.logo_home'))}
      >
        <InterledgerIcon class="h-10 w-10" />
      </a>
    </div>
  </div>
</footer>
