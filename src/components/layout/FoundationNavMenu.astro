---
import Icon from '@/components/shared/Icon.astro'
import NavMenuLink from '@/components/shared/NavMenuLink.astro'
import type { MenuGroup } from '@/types/navigation'
import { buildSubmenuToggleUmamiAttrs, useTranslations } from '@/utils'

interface Props {
  menuGroups: MenuGroup[]
  theme?: 'light' | 'dark'
}

const { menuGroups, theme = 'light' } = Astro.props
const isDark = theme === 'dark'
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

/** Wide mega menus need a static parent so multi-column panels align to the header. */
const MEGA_MENU_STATIC_POSITION_SUBGROUP_THRESHOLD = 3

/**
 * A panel with more columns than this is wider than the menu bar can hang off
 * one button. `data-wide-panel` lets navigation.css centre it on the nav bar
 * and cap its width there. See "Dropdown panel anchoring".
 */
const hasWidePanel = (group: MenuGroup) =>
  (group.subGroups?.length ?? 0) > MEGA_MENU_STATIC_POSITION_SUBGROUP_THRESHOLD

const toSlug = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')

const submenuToggleAttrs = (groupLabel: string) =>
  buildSubmenuToggleUmamiAttrs(Astro.url.pathname, routeLocale, groupLabel)

const navButtonClass = `peer inline-flex items-center text-current whitespace-nowrap nav-bar:rounded-lg border-none bg-transparent transition-colors duration-200 group/submenu nav-bar:data-[active=true]:underline nav-bar:data-[active=true]:decoration-current nav-bar:data-[active=true]:decoration-2 nav-bar:data-[active=true]:underline-offset-8 focus-visible:outline-none w-full justify-between py-lg px-lg text-h4-md nav-bar:w-auto nav-bar:justify-start nav-bar:py-sm nav-bar:pl-lg nav-bar:pr-xs nav-bar:text-base`

const navButtonChevronClass =
  'ml-sm inline-flex size-2xl shrink-0 items-center justify-center origin-center text-neutral-75 transition-transform duration-150 motion-reduce:transition-none nav-bar:group-hover:rotate-180 group-data-[open=true]/submenu:rotate-180 nav-bar:size-5 nav-bar:text-current'

const panelBgClass = isDark
  ? 'nav-bar:bg-neutral-150 nav-bar:border nav-bar:border-neutral-100'
  : 'nav-bar:bg-white nav-bar:border nav-bar:border-neutral-25'

// In the drawer, header-nav.ts owns the open height: it sets the panel's
// measured height inline and then drops the cap, because a fixed viewport cap
// clipped any taller panel with no way to reach the rest of the list.
// `max-h-screen` only covers the gap before that script runs, and stays scoped
// to the drawer so it can't outrank `nav-bar:max-h-none` on the dropdown.
const panelMobileClass =
  'block max-h-0 overflow-hidden border-0 bg-transparent shadow-none ' +
  'transition-[max-height] duration-500 ease-out motion-reduce:transition-none ' +
  'nav-drawer:peer-data-[open=true]:max-h-screen'

const panelDesktopClass =
  'nav-bar:absolute nav-bar:invisible nav-bar:opacity-0 nav-bar:top-[calc(100%+1.5rem)] ' +
  'nav-bar:max-h-none nav-bar:overflow-visible ' +
  'nav-bar:transition-opacity nav-bar:duration-fast ' +
  'nav-bar:shadow-[2px_3px_6px_-3px_hsla(0,0%,0%,0.06),-2px_3px_6px_-3px_hsla(0,0%,0%,0.06)] ' +
  'nav-bar:before:absolute nav-bar:before:bottom-full nav-bar:before:inset-x-0 nav-bar:before:h-xl nav-bar:before:content-[""] ' +
  'nav-bar:group-hover:visible nav-bar:group-hover:opacity-100 nav-bar:group-hover:left-0 ' +
  'nav-bar:peer-data-[open=true]:visible nav-bar:peer-data-[open=true]:opacity-100 nav-bar:peer-data-[open=true]:left-0'

const panelToggleClass = `submenu-panel ${panelMobileClass} ${panelDesktopClass} ${panelBgClass}`

const submenuListClass =
  'list-none flex flex-col gap-y-0 nav-bar:block nav-bar:gap-0 nav-bar:ps-0'

const flatSubmenuPanelClass = `w-full px-lg ${panelToggleClass} nav-bar:min-w-full nav-bar:px-2xl nav-bar:py-xl nav-bar:group-hover:w-max nav-bar:peer-data-[open=true]:w-max`

const megaMenuClass = `flex flex-col gap-y-0 px-lg ${panelToggleClass} nav-bar:grid nav-bar:gap-3xl nav-bar:p-3xl`

const subGroupHeadingTextClass = isDark
  ? 'text-neutral-50 border-neutral-75'
  : 'text-neutral-75 border-neutral-100'

const megaSubGroupClass =
  'mt-lg flex flex-col gap-y-md nav-bar:mt-0 nav-bar:gap-0'

const subGroupHeadingClass = `nav-subgroup-heading w-full border-b text-caption uppercase tracking-wide whitespace-nowrap pb-sm nav-bar:mb-xs nav-bar:pb-md ${subGroupHeadingTextClass}`
---

<ul
  class="list-none flex flex-col nav-drawer:gap-sm gap-xl ps-0 nav-bar:flex nav-bar:flex-row nav-bar:items-center nav-bar:justify-center nav-bar:gap-md nav-bar:relative"
  id="siteNavMenu"
  data-component="FoundationNavMenu"
  data-nav-list
>
  {
    menuGroups.map((group) => {
      const groupSlug = toSlug(group.label)
      const buttonId = `nav-menu-${groupSlug}-button`
      const panelId = `nav-menu-${groupSlug}-panel`

      return (
        <li
          class={`group ${hasWidePanel(group) ? 'nav-bar:static' : 'nav-bar:relative'}`}
          data-menu-level="1"
          data-wide-panel={hasWidePanel(group) ? '' : undefined}
        >
          <button
            type="button"
            id={buttonId}
            aria-expanded="false"
            aria-controls={panelId}
            aria-label={t('nav.submenu_toggle', { label: group.label })}
            {...submenuToggleAttrs(group.label)}
            class={navButtonClass}
            data-submenu-button
            data-open="false"
          >
            <span aria-hidden="true">{group.label}</span>
            <span class={navButtonChevronClass} aria-hidden="true">
              <Icon name="arrow-down" class="size-8 nav-bar:size-5" />
            </span>
          </button>

          {group.subGroups && group.subGroups.length > 0 ? (
            <section
              id={panelId}
              class={megaMenuClass}
              aria-labelledby={buttonId}
              style={`--mega-menu-cols: ${group.subGroups.length}; grid-template-columns: repeat(var(--mega-menu-cols), minmax(min-content, max-content));`}
            >
              {group.subGroups.map((subGroup) => (
                <div class={megaSubGroupClass}>
                  <h3 class={subGroupHeadingClass}>{subGroup.label}</h3>
                  <ul class={submenuListClass}>
                    {subGroup.items.map((item) => (
                      <li data-menu-level="2">
                        <NavMenuLink
                          href={item.href || '#'}
                          label={item.label}
                          theme={theme}
                          variant="mega"
                          openInNewTab={item.openInNewTab}
                        />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ) : group.items && group.items.length > 0 ? (
            <section
              id={panelId}
              class={flatSubmenuPanelClass}
              aria-labelledby={buttonId}
            >
              <ul class={submenuListClass}>
                {group.items.map((item) => (
                  <li data-menu-level="2">
                    <NavMenuLink
                      href={item.href || '#'}
                      label={item.label}
                      theme={theme}
                      openInNewTab={item.openInNewTab}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
        </li>
      )
    })
  }
</ul>
