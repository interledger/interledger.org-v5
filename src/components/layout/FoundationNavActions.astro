---
import type { MenuItem } from '@/types/navigation'
import LanguageSwitcher from '@/components/shared/LanguageSwitcher.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import Icon from '@/components/shared/Icon.astro'
import { buildNavCtaUmamiAttrs } from '@/utils'

interface Props {
  ctaButton?: MenuItem
  hideCtaIcon?: boolean
}

const { ctaButton, hideCtaIcon = false } = Astro.props
const { routeLocale } = Astro.locals

const ctaAttrs =
  ctaButton &&
  buildNavCtaUmamiAttrs(
    Astro.url.pathname,
    routeLocale,
    ctaButton.href || '#',
    ctaButton.label
  )
---

<div
  class="flex items-center gap-md nav-bar:col-start-3 nav-bar:col-end-4 nav-bar:row-start-1 nav-bar:self-center nav-bar:justify-self-end nav-drawer:flex-col nav-drawer:items-start nav-drawer:px-lg"
  data-component="FoundationNavActions"
>
  {
    ctaButton && (
      <LinkButton
        href={ctaButton.href || '#'}
        variant="primary"
        size="sm"
        external={ctaButton.openInNewTab}
        iconSide={hideCtaIcon ? 'none' : undefined}
        class="nav-drawer:hidden"
        {...ctaAttrs}
      >
        {ctaButton.label}
        {!hideCtaIcon && <Icon slot="icon-right" name="arrow-right" />}
      </LinkButton>
    )
  }
  <LanguageSwitcher class="nav-drawer:hidden" />
</div>
