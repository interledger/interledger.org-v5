---
/**
 * Hackathon site header. Always dark — no scroll theme flip.
 */
import FoundationNavMenu from '@/components/layout/FoundationNavMenu.astro'
import FoundationNavActions from '@/components/layout/FoundationNavActions.astro'
import HackathonNavLogo from '@/components/logos/HackathonNavLogo.astro'
import HamburgerButton from '@/components/shared/HamburgerButton.astro'
import LanguageSwitcher from '@/components/shared/LanguageSwitcher.astro'
import LinkButton from '@/components/shared/LinkButton.astro'
import {
  translatePath,
  useTranslations,
  getNavigation,
  buildDeferredUmamiAttrs,
  getAlternateLocale,
  getAlternateLocaleHref
} from '@/utils'

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const alternateLocale = getAlternateLocale(routeLocale)
const alternateLocaleHref = getAlternateLocaleHref(
  routeLocale,
  Astro.locals.currentSlug,
  Astro.locals.currentBasePath
)
const alternateLocaleLabel = alternateLocale?.toUpperCase() ?? ''

const { mainMenu, ctaButton } = getNavigation('hackathon', routeLocale)
const homeHref = translatePath('hackathon-pages', routeLocale, 'overview')
const navLabel = t('nav.hackathon')
const logoLabel = t('aria.logo.hackathon')

const navLink = (href: string, linkText?: string, ariaLabel?: string) =>
  buildDeferredUmamiAttrs({
    pathname: Astro.url.pathname,
    lang: routeLocale,
    section: 'nav',
    href,
    linkText,
    ariaLabel
  })
---

<header
  class="hackathon-header sticky top-0 z-[2] px-lg desktop:px-2xl text-base"
  data-component="HackathonHeader"
>
  <nav
    class="mx-auto w-full max-w-wide flex items-center justify-between desktop:grid desktop:grid-cols-[auto_1fr_auto] desktop:gap-xl desktop:h-(--site-header-height-desktop) max-desktop:h-(--site-header-height)"
    aria-labelledby="block-hackathon-navigation-menu"
    id="block-hackathon-navigation"
    data-nav
  >
    <h2 class="sr-only" id="block-hackathon-navigation-menu">{navLabel}</h2>
    <a
      href={homeHref}
      class="flex items-center self-center flex-none desktop:col-start-1 desktop:col-end-2 desktop:z-[1]"
      aria-label={logoLabel}
      {...navLink(homeHref, undefined, logoLabel)}
    >
      <HackathonNavLogo />
    </a>
    <div
      class="header-nav-wrapper header-nav-wrapper--foundation"
      data-nav-wrapper
      data-lenis-prevent
      data-offscreen="true"
      id="hackathonNavLinks"
    >
      <div class="max-desktop:block desktop:hidden px-lg pt-lg pb-xl">
        <div class="flex items-center justify-between gap-xl">
          {
            alternateLocaleHref && alternateLocaleLabel ? (
              <a
                href={alternateLocaleHref}
                hreflang={alternateLocale}
                class="foundation-drawer-language-label font-poppins text-h3 font-normal no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orchid-100"
                aria-label={t('nav.switch_language', {
                  locale: alternateLocaleLabel
                })}
                {...navLink(
                  alternateLocaleHref,
                  t('nav.language'),
                  t('nav.switch_language', { locale: alternateLocaleLabel })
                )}
              >
                {t('nav.language')}
              </a>
            ) : (
              <span class="foundation-drawer-language-label font-poppins text-h3 font-normal">
                {t('nav.language')}
              </span>
            )
          }
          <LanguageSwitcher />
        </div>
      </div>
      <hr
        class="desktop:hidden mx-lg mt-md mb-xl border-t border-neutral-25 dark:border-neutral-75"
      />
      <FoundationNavMenu menuGroups={mainMenu} theme="dark" />
      {
        ctaButton && (
          <div class="desktop:hidden mx-lg mt-2xl mb-4xl">
            <LinkButton
              href={ctaButton.href || '#'}
              variant="primary"
              size="sm"
              external={ctaButton.openInNewTab}
              class="w-full"
              {...navLink(ctaButton.href || '#', ctaButton.label)}
            >
              {ctaButton.label}
            </LinkButton>
          </div>
        )
      }
    </div>
    <FoundationNavActions ctaButton={ctaButton} hideCtaIcon />
    <HamburgerButton
      controlsId="hackathonNavLinks"
      iconId="hackathonMenuIcon"
    />
  </nav>
</header>

<!-- Synchronous init: set data-offscreen before first paint on desktop so the
     browser never renders the drawer in mobile-closed state then flips it.
     The module script below handles all interactions; this only sets the
     initial attribute to match the viewport. -->
<script is:inline>
  ;(function () {
    const w = document.getElementById('hackathonNavLinks')
    if (w && window.matchMedia('(min-width: 1200px)').matches) {
      w.dataset.offscreen = 'false'
      w.removeAttribute('inert')
    }
  })()
</script>

<script>
  import './hackathon-header.ts'
</script>
