---
import {
  useTranslations,
  buildSectionNavLinkUmamiAttrs,
  type Locale
} from '@/utils'

interface FaqNavSection {
  id: string
  heading: string
}

interface Props {
  sections: FaqNavSection[]
  uiLocale: Locale
}

const { sections, uiLocale } = Astro.props
const t = useTranslations(uiLocale)
const { routeLocale } = Astro.locals

const sectionNavAttrs = (id: string, heading: string) =>
  buildSectionNavLinkUmamiAttrs(
    Astro.url.pathname,
    routeLocale,
    'faq',
    id,
    heading
  )
---

<nav
  data-faq-nav
  data-lenis-prevent
  aria-label={t('faq.sections_nav')}
  class="tablet:sticky tablet:top-[calc(var(--site-header-height)+var(--spacing-2xl))] tablet:max-h-[calc(100dvh-var(--site-header-height)-var(--spacing-2xl)-var(--spacing-2xl))] tablet:overflow-y-auto desktop:top-[calc(var(--site-header-height-desktop)+var(--spacing-2xl))] desktop:max-h-[calc(100dvh-var(--site-header-height-desktop)-var(--spacing-2xl)-var(--spacing-2xl))]"
>
  <ul class="m-0 flex list-none flex-col gap-2xl p-0 desktop:gap-xl">
    {
      sections.map((section, index) => (
        <li class="m-0">
          <a
            href={`#${section.id}`}
            data-faq-nav-link
            data-target={section.id}
            data-active={index === 0 ? 'true' : 'false'}
            aria-current={index === 0 ? 'true' : undefined}
            class="group flex flex-col gap-sm rounded-lg text-left no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link"
            {...sectionNavAttrs(section.id, section.heading)}
          >
            <span class="flex items-start gap-md pl-md">
              <span
                aria-hidden="true"
                class="size-1 shrink-0 mt-2.5 rounded-full bg-neutral-75 transition-colors duration-200 group-hover:bg-neutral-900 group-data-[active=true]:bg-link dark:bg-neutral-50 dark:group-hover:bg-neutral-0"
              />
              <span class="text-body-sm-standard text-neutral-75 transition-colors duration-200 group-hover:text-neutral-900 group-data-[active=true]:text-link dark:text-neutral-50 dark:group-hover:text-neutral-0">
                {section.heading}
              </span>
            </span>
            <span
              aria-hidden="true"
              class="h-px w-0 bg-link transition-all duration-200 group-data-[active=true]:w-full"
            />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Scoped per instance via [data-faq-nav] so multiple FAQ pages' scripts
  // don't collide.
  import { initSectionNavScrollspy } from '@/scripts/section-nav-scrollspy'

  initSectionNavScrollspy({
    containerSelector: '[data-faq-nav]',
    linkSelector: '[data-faq-nav-link]'
  })
</script>
