---
import { getRfcById, type PublishedRfcId } from '@/data/docs/rfcs'
import { getRfcImageUrl, getRfcSnapshot } from '@/utils/docs/rfcSnapshots'
import { renderRfcMarkdown } from '@/utils/docs/renderRfcMarkdown'

interface Props {
  id: PublishedRfcId
  docsBasePath?: string
}

const { id, docsBasePath = '/developers' } = Astro.props
const rfc = getRfcById(id)
const markdown = getRfcSnapshot(id)

if (markdown instanceof Error) {
  throw markdown
}

const html = renderRfcMarkdown(markdown, {
  sourceUrl: rfc.sourceRawUrl,
  docsBasePath,
  localImageUrl: getRfcImageUrl
})

if (html instanceof Error) {
  throw html
}
---

<div set:html={html} />
