---
import { renderRfcMarkdown } from '@/utils/docs/renderRfcMarkdown'

interface Props {
  source: string
  docsBasePath?: string
}

const { source, docsBasePath = '/developers' } = Astro.props

const response = await fetch(source)

if (!response.ok) {
  throw new Error(
    `Failed to fetch RFC markdown from ${source}: ${response.status} ${response.statusText}`
  )
}

const html = renderRfcMarkdown(await response.text(), {
  sourceUrl: source,
  docsBasePath
})
---

<div set:html={html} />
