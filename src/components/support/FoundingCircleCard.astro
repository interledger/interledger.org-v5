---
/**
 * One Founding Circle tier on /support-us (INTORG-1247).
 *
 * Heading, seat count, gift amount, summary, benefits, and a CTA supplied by
 * the caller — either a Fundraise Up element or an ordinary `LinkButton`,
 * which is why the CTA arrives through a slot rather than as props. The
 * Visionaries tier books a meeting instead of opening checkout.
 *
 * Benefits are always visible rather than sitting behind a disclosure: what a
 * donor gets is the reason to pick one tier over another, so hiding it behind
 * a click makes the three cards impossible to compare at a glance.
 */

interface Props {
  heading: string
  /** Seats line, e.g. "50 of 50 seats available". */
  seats: string
  /** Gift size for this tier, e.g. "$1,000 or more". */
  amount: string
  summary: string
  benefits: string
  benefitsLabel: string
}

const { heading, seats, amount, summary, benefits, benefitsLabel } = Astro.props
---

<article
  data-component="FoundingCircleCard"
  data-umami-component="founding-circle-card"
  class="flex h-full flex-col gap-xl rounded-3xl border border-neutral-50 bg-white p-xl"
>
  <div class="flex flex-col gap-sm">
    <h3
      class="m-0 text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-900"
    >
      {heading}
    </h3>
    <!--
      A seat count is supporting detail, not a heading, and it changes as the
      circle fills. `<p>` keeps the heading hierarchy unbroken.
    -->
    <p class="mb-0 text-body-sm-emphasis text-primary">{seats}</p>
  </div>

  <p class="mb-0 text-h5 tablet:text-h5-md desktop:text-h5-lg text-neutral-900">
    {amount}
  </p>

  <p
    class="mb-0 text-body-lg-standard tablet:text-body-lg-standard-md text-neutral-100"
  >
    {summary}
  </p>

  <div class="flex flex-col gap-xs border-t border-neutral-25 pt-lg">
    <p class="mb-0 text-body-sm-emphasis text-neutral-900">{benefitsLabel}</p>
    <p class="mb-0 text-body-sm-standard text-neutral-75">{benefits}</p>
  </div>

  <!--
    `mt-auto` pins the CTA to the card's bottom edge so the three buttons line
    up across a row whose cards have different amounts of copy.
  -->
  <div class="mt-auto">
    <slot name="cta" />
  </div>
</article>
