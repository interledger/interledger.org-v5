---
/**
 * One Founding Circle tier on /support-us (INTORG-1247).
 *
 * Heading, seat count, one-line summary, a disclosure for the benefits, and a
 * CTA supplied by the caller — either a Fundraise Up element or an ordinary
 * `LinkButton`, which is why the CTA arrives through a slot rather than as
 * props. The Visionaries tier books a meeting instead of opening checkout.
 *
 * The benefits disclosure is a native `<details>`, matching `FaqItem`:
 * keyboard-operable and screen-reader-announced with no JavaScript, and it
 * still works if the accordion script never loads. It is deliberately *not*
 * wired to `initFaqAccordion` — these are three independent disclosures, and
 * the exclusive grouping that script provides would close one tier's benefits
 * when a donor opened another's while comparing them.
 */
import Icon from '@/components/shared/Icon.astro'
import { buildUmamiAttrs, useTranslations } from '@/utils'

interface Props {
  heading: string
  /** Seats line, e.g. "50 of 50 seats available". */
  seats: string
  summary: string
  benefits: string
  /** Distinguishes this card's analytics events from its siblings'. */
  tierId: string
}

const { heading, seats, summary, benefits, tierId } = Astro.props
const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const benefitsToggleUmamiAttrs = buildUmamiAttrs({
  pathname: Astro.url.pathname,
  lang: routeLocale,
  label: 'toggle',
  baseComponent: `founding_circle_${tierId}`,
  ariaLabel: `${t('support.circle.benefits_label')} — ${heading}`
})
---

<article
  data-component="FoundingCircleCard"
  data-umami-component="founding-circle-card"
  class="flex h-full flex-col gap-xl rounded-3xl border border-neutral-50 bg-white p-xl"
>
  <div class="flex flex-col gap-sm">
    <h3
      class="m-0 text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-900"
    >
      {heading}
    </h3>
    <!--
      A seat count is supporting detail, not a heading, and it changes as the
      circle fills. `<p>` keeps the heading hierarchy unbroken.
    -->
    <p class="mb-0 text-body-sm-emphasis text-primary">{seats}</p>
  </div>

  <p
    class="mb-0 text-body-lg-standard tablet:text-body-lg-standard-md text-neutral-100"
  >
    {summary}
  </p>

  <details class="group border-t border-neutral-25 pt-lg">
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-lg rounded-sm text-body-sm-emphasis text-neutral-900 [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
      {...benefitsToggleUmamiAttrs}
    >
      {t('support.circle.benefits_label')}
      <Icon
        name="arrow-down"
        class="size-6 shrink-0 text-link transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
      />
    </summary>
    <p class="mt-md mb-0 text-body-sm-standard text-neutral-75">{benefits}</p>
  </details>

  <!--
    `mt-auto` pins the CTA to the card's bottom edge so the three buttons line
    up across a row whose cards have different amounts of copy.
  -->
  <div class="mt-auto">
    <slot name="cta" />
  </div>
</article>
