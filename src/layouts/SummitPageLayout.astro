---
/**
 * Summit pages use the foundation page chrome, with the summit nav and
 * `Interledger Summit` in the document title.
 *
 * The page is light, like foundation. Hackathon is the dark site.
 */
import { useTranslations } from '@/utils'
import BaseLayout from './BaseLayout.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import FoundationHeader from '@/components/layout/FoundationHeader.astro'
import TableScrollSupport from '@/components/shared/TableScrollSupport.astro'
import HeroImagePreload from '@/components/shared/HeroImagePreload.astro'
import type { HeroLcpPreloadConfig } from '@/utils'

interface Props {
  title: string
  description?: string
  ogImageUrl?: string
  canonicalURL?: string
  noindex?: boolean
  /** Emits `<link rel="preload">` for a summit hero LCP candidate in `<head>`. */
  heroLcpPreload?: HeroLcpPreloadConfig
}

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const site = Astro.site!
const {
  title,
  description,
  ogImageUrl = new URL('/img/og-summit.png', site).href,
  canonicalURL,
  noindex = false,
  heroLcpPreload
} = Astro.props

// Single source of site identity. `BaseLayout` turns this into `data-site` on
// <html>, where the button token overrides key off it, and blocks inside the
// page read it from locals rather than re-deriving it. Set in the layout
// frontmatter, which runs before `<slot />` renders (Jonathan, #520).
Astro.locals.site = 'summit'
---

<BaseLayout
  title={title}
  titleSuffix={t('site.title.summit')}
  description={description}
  ogImageUrl={ogImageUrl}
  canonicalURL={canonicalURL}
  theme="light"
  bodyClass="flex flex-col min-h-full min-w-[360px] overflow-x-clip"
  noindex={noindex}
>
  <Fragment slot="head">
    {heroLcpPreload && <HeroImagePreload config={heroLcpPreload} />}
  </Fragment>
  <FoundationHeader slot="header" site="summit" theme="light" />
  <TableScrollSupport />
  <slot />
  <SiteFooter site="summit" slot="footer" />
</BaseLayout>
