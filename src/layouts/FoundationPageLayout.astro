---
/**
 * Foundation site layout.
 * Extends BaseLayout with Foundation header/footer.
 *
 * The foundation site has one mode: light. Whole pages never render dark, so
 * this layout pins the page theme instead of taking it as a prop.
 *
 * `headerTheme` is a separate concern and stays. The header flips to its dark
 * variant over the dark sections of the home page (see foundation-header.ts).
 * That is header chrome on a light page, not a page theme. Hackathon and
 * summit are the dark sites, and they have their own layouts.
 */
import BaseLayout from './BaseLayout.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import FoundationHeader from '@/components/layout/FoundationHeader.astro'
import TableScrollSupport from '@/components/shared/TableScrollSupport.astro'
import HeroImagePreload from '@/components/shared/HeroImagePreload.astro'
import type { HeroLcpPreloadConfig } from '@/utils'

interface Props {
  title: string
  description?: string
  ogType?: string
  ogImageUrl?: string
  canonicalURL?: string
  datePublished?: string
  headerTheme?: 'light' | 'dark'
  bodyClass?: string
  noindex?: boolean
  /** Emits `<link rel="preload">` for homepage or PageHero LCP candidates in `<head>`. */
  heroLcpPreload?: HeroLcpPreloadConfig
}

const defaultBodyClass =
  'flex flex-col min-h-full min-w-[360px] overflow-x-clip'

const {
  title,
  description,
  ogType,
  ogImageUrl,
  canonicalURL,
  datePublished,
  headerTheme = 'light',
  bodyClass = defaultBodyClass,
  noindex = false,
  heroLcpPreload
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  ogImageUrl={ogImageUrl}
  canonicalURL={canonicalURL}
  datePublished={datePublished}
  theme="light"
  bodyClass={bodyClass}
  noindex={noindex}
>
  <Fragment slot="head">
    <slot name="head" />
    {heroLcpPreload && <HeroImagePreload config={heroLcpPreload} />}
  </Fragment>
  <FoundationHeader slot="header" theme={headerTheme} />
  <TableScrollSupport />
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
