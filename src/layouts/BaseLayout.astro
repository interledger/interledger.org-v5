---
/**
 * Base HTML layout shell.
 * Provides <head> with meta tags, OG/Twitter cards, and analytics.
 * Use named slots for header/footer customization.
 */
import '../styles/tailwind.css'
import SeoHead from '@/components/shared/SeoHead.astro'
import SmoothScroll from '@/components/shared/SmoothScroll.astro'
import { useTranslations, buildCanonicalMeta, isPreviewPathname } from '@/utils'

interface Props {
  title: string
  titleSuffix?: string
  description?: string
  theme?: 'light' | 'dark'
  ogType?: string
  ogImageUrl?: string
  canonicalURL?: string
  bodyClass?: string
  bodyStyle?: string
  datePublished?: string
  /** Demo/QA pages: robots noindex,nofollow */
  noindex?: boolean
  /**
   * Emit cross-locale `hreflang` alternates. Off where the twin may not exist
   * or is not a translation — e.g. paginated listings past page 1. Preview
   * routes are gated centrally below and don't need to pass this.
   */
  localeAlternates?: boolean
}

// `site` is set by the microsite layout's frontmatter, which runs before the
// slot that renders this component's children. Absent on the foundation site,
// which needs no token override. Reading it here rather than taking a prop
// keeps one source of site identity (Jonathan, #520).
const { routeLocale, currentSlug, currentBasePath, site } = Astro.locals
const t = useTranslations(routeLocale)
const canonicalMeta = buildCanonicalMeta(
  Astro.site!,
  routeLocale,
  currentSlug,
  currentBasePath
)
const {
  title,
  titleSuffix = t('site.title.foundation'),
  description = t('site.description'),
  theme = 'light',
  ogType = 'website',
  ogImageUrl = new URL('/img/og-foundation.png', Astro.site).href,
  canonicalURL = canonicalMeta.canonical,
  bodyClass = '',
  bodyStyle = '',
  datePublished,
  noindex = false,
  localeAlternates = true
} = Astro.props

// Preview routes need a query param that hreflang URLs can't carry, so their
// alternates 500 on `Missing documentId`. Gating by pathname here means a new
// preview route can't reintroduce them by forgetting the prop.
const emitLocaleAlternates =
  localeAlternates && !isPreviewPathname(Astro.url.pathname)

const PROD_UMAMI_WEBSITE_ID = '50d81dd1-bd02-4f82-8a55-34a09ccbbbd9'
---

<!doctype html>
<html lang={routeLocale} data-theme={theme} data-site={site}>
  <head>
    <link
      rel="preload"
      href="/fonts/poppins-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead
      title={title}
      description={description}
      siteName={titleSuffix}
      ogType={ogType}
      ogImageUrl={ogImageUrl}
      canonicalURL={canonicalURL}
      hreflang={emitLocaleAlternates ? canonicalMeta.hreflang : undefined}
      xDefault={emitLocaleAlternates ? canonicalMeta.xDefault : undefined}
      datePublished={datePublished}
      noindex={noindex}
    />
    <slot name="head" />
    <script
      defer
      src="https://uwa.interledger.org/script.js"
      data-website-id={PROD_UMAMI_WEBSITE_ID}
      data-domains="interledger.org"></script>
  </head>

  <body class={bodyClass} style={bodyStyle}>
    <SmoothScroll />
    <slot name="header" />
    <slot />
    <slot name="footer" />
  </body>
</html>
