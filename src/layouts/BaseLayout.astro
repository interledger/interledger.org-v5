---
/**
 * Base HTML layout shell.
 * Provides <head> with meta tags, OG/Twitter cards, and analytics.
 * Use named slots for header/footer customization.
 */
import '../styles/tailwind.css'
import SeoHead from '@/components/shared/SeoHead.astro'
import SmoothScroll from '@/components/shared/SmoothScroll.astro'
import { useTranslations, buildCanonicalMeta } from '@/utils'
import type { MicrositeSite } from '@/types/navigation'

interface Props {
  title: string
  titleSuffix?: string
  description?: string
  theme?: 'light' | 'dark'
  /**
   * Which site this page belongs to, emitted as `data-site` on <html>.
   *
   * Separate from `theme` on purpose. Both microsites are permanently dark, so
   * `data-theme` cannot tell them apart, and some tokens are per-site rather
   * than per-theme — the hackathon's apricot buttons, for one. Omitted on the
   * foundation site, which needs no override (INTORG-1083).
   */
  site?: MicrositeSite
  ogType?: string
  ogImageUrl?: string
  canonicalURL?: string
  bodyClass?: string
  bodyStyle?: string
  datePublished?: string
  /** Demo/QA pages: robots noindex,nofollow */
  noindex?: boolean
}

const { routeLocale, currentSlug, currentBasePath } = Astro.locals
const t = useTranslations(routeLocale)
const canonicalMeta = buildCanonicalMeta(
  Astro.site!,
  routeLocale,
  currentSlug,
  currentBasePath
)
const {
  title,
  titleSuffix = t('site.title.foundation'),
  description = t('site.description'),
  theme = 'light',
  site,
  ogType = 'website',
  ogImageUrl = new URL('/img/og-foundation.png', Astro.site).href,
  canonicalURL = canonicalMeta.canonical,
  bodyClass = '',
  bodyStyle = '',
  datePublished,
  noindex = false
} = Astro.props

const PROD_UMAMI_WEBSITE_ID = '50d81dd1-bd02-4f82-8a55-34a09ccbbbd9'
const NON_PROD_UMAMI_WEBSITE_ID = '60547518-fd38-4f64-abf3-d03688e321b9'
const isProduction =
  (process.env.CONTEXT ?? import.meta.env.CONTEXT) === 'production'
const umamiWebsiteId = isProduction
  ? PROD_UMAMI_WEBSITE_ID
  : NON_PROD_UMAMI_WEBSITE_ID
---

<!doctype html>
<html lang={routeLocale} data-theme={theme} data-site={site}>
  <head>
    <link
      rel="preload"
      href="/fonts/poppins-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead
      title={title}
      description={description}
      siteName={titleSuffix}
      ogType={ogType}
      ogImageUrl={ogImageUrl}
      canonicalURL={canonicalURL}
      hreflang={canonicalMeta.hreflang}
      xDefault={canonicalMeta.xDefault}
      datePublished={datePublished}
      noindex={noindex}
    />
    <slot name="head" />
    <script
      defer
      src="https://uwa.interledger.org/script.js"
      data-website-id={umamiWebsiteId}
      data-domains={isProduction ? 'interledger.org' : undefined}></script>
  </head>

  <body class={bodyClass} style={bodyStyle}>
    <SmoothScroll />
    <slot name="header" />
    <slot />
    <slot name="footer" />
  </body>
</html>
