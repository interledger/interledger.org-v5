---
/**
 * Hackathon site layout.
 * Dark theme on a neutral-150 page (rgb(13, 13, 13)). Shared blocks keep
 * their existing styles until later PRs add hackathon-specific variants.
 * The shared FoundationFooter stays on its light ice-mint surface.
 */
import { useTranslations } from '@/utils'
import BaseLayout from './BaseLayout.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import MicrositeHeader from '@/components/layout/MicrositeHeader.astro'
import TableScrollSupport from '@/components/shared/TableScrollSupport.astro'

interface Props {
  title: string
  description?: string
  ogImageUrl?: string
  canonicalURL?: string
  noindex?: boolean
}

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const site = Astro.site!
const {
  title,
  description,
  ogImageUrl = new URL('/img/og-hackathon.png', site).href,
  canonicalURL,
  noindex = false
} = Astro.props
---

<BaseLayout
  title={title}
  titleSuffix={t('site.title.hackathon')}
  description={description}
  ogImageUrl={ogImageUrl}
  canonicalURL={canonicalURL}
  theme="dark"
  bodyClass="flex min-h-full min-w-[360px] flex-col overflow-x-hidden bg-neutral-150 text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-50"
  noindex={noindex}
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/poppins-extrabold.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <MicrositeHeader site="hackathon" slot="header" />
  <TableScrollSupport />
  <div
    class="hackathon-main flex-1 text-h4 tablet:text-h4-md desktop:text-h4-lg [&>section]:w-full [&>section]:py-2xl [&_[data-prose]>h1]:text-h2-lg [&_[data-prose]>h2]:text-h2 tablet:[&_[data-prose]>h2]:text-h2-md desktop:[&_[data-prose]>h2]:text-h2-lg [&_[data-prose]>h3]:text-h3 [&_[data-prose]>h4]:text-h4"
  >
    <slot />
  </div>
  <SiteFooter site="hackathon" slot="footer" />
</BaseLayout>

<style>
  /* Body links only — LinkButton keeps its own palette. :global because
     anchors live in child components, not this file. */
  .hackathon-main :global(a:not([data-component='LinkButton'])) {
    color: var(--color-link);
    transition-property: color;
    transition-duration: 300ms;
  }

  .hackathon-main :global(a:not([data-component='LinkButton']):hover) {
    color: var(--color-link-hover);
  }
</style>
