---
/**
 * Hackathon site layout.
 * Dark theme on a neutral-150 page (rgb(13, 13, 13)). Shared blocks keep
 * their existing styles until later PRs add hackathon-specific variants.
 * The shared FoundationFooter stays on its light ice-mint surface.
 */
import { useTranslations } from '@/utils'
import BaseLayout from './BaseLayout.astro'
import FoundationFooter from '@/components/layout/FoundationFooter.astro'
import MicrositeHeader from '@/components/layout/MicrositeHeader.astro'
import TableScrollSupport from '@/components/shared/TableScrollSupport.astro'

interface Props {
  title: string
  description?: string
  ogImageUrl?: string
  canonicalURL?: string
  noindex?: boolean
}

const { routeLocale } = Astro.locals
const t = useTranslations(routeLocale)

const site = Astro.site!
const {
  title,
  description,
  ogImageUrl = new URL('/img/og-hackathon.png', site).href,
  canonicalURL,
  noindex = false
} = Astro.props
---

<BaseLayout
  title={title}
  titleSuffix={t('site.title.hackathon')}
  description={description}
  ogImageUrl={ogImageUrl}
  canonicalURL={canonicalURL}
  theme="dark"
  bodyClass="flex min-h-full min-w-[360px] flex-col overflow-x-hidden bg-neutral-150 text-h4 tablet:text-h4-md desktop:text-h4-lg text-neutral-50"
  noindex={noindex}
>
  <MicrositeHeader site="hackathon" slot="header" />
  <TableScrollSupport />
  <div
    class="flex-1 text-h4 tablet:text-h4-md desktop:text-h4-lg [&>section]:w-full [&>section]:py-2xl [&_h1]:text-h2-lg [&_h2]:text-h3-md [&_h3]:text-h3 [&_h4]:text-h4 [&_a:not([data-component='LinkButton'])]:text-current [&_a:not([data-component='LinkButton'])]:transition-colors [&_a:not([data-component='LinkButton'])]:duration-slow [&_a:not([data-component='LinkButton']):hover]:text-[hsla(26,100%,76%,1)]"
  >
    <slot />
  </div>
  <FoundationFooter site="hackathon" slot="footer" />
</BaseLayout>
