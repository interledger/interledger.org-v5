---
import SectionEntryPage from '@/components/pages/SectionEntryPage.astro'
import HackathonContentPage from '@/components/pages/HackathonContentPage.astro'
import { getLocalizedPaths, getCrossSectionPaths } from '@/utils'

export async function getStaticPaths() {
  const pages = (await getLocalizedPaths('hackathon-pages', 'en', 'page')).map(
    (p) => ({ ...p, props: { ...p.props, kind: 'page' as const } })
  )
  const crossSectionPaths = await getCrossSectionPaths(
    'hackathon',
    'en',
    'page'
  )
  return [...crossSectionPaths, ...pages]
}

const { slug, locale: contentLocale, kind, isFallback, section } = Astro.props
const commonProps = { slug, contentLocale, isFallback }
---

<SectionEntryPage kind={kind} section={section} {...commonProps}>
  <HackathonContentPage {...commonProps} />
</SectionEntryPage>
