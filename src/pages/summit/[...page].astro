---
import SummitContentPage from '@/components/pages/SummitContentPage.astro'
import SectionEntryPage from '@/components/pages/SectionEntryPage.astro'
import {
  getLocalizedPaths,
  getCrossSectionPaths,
  HOME_CONTENT_SLUG
} from '@/utils'

export async function getStaticPaths() {
  const pages = (
    await getLocalizedPaths('summit-pages', 'en', 'page', {
      excludeSlug: HOME_CONTENT_SLUG
    })
  ).map((p) => ({ ...p, props: { ...p.props, kind: 'page' as const } }))
  const crossSectionPaths = await getCrossSectionPaths('summit', 'en', 'page')
  return [...crossSectionPaths, ...pages]
}

const { slug, locale: contentLocale, kind, isFallback, section } = Astro.props
const commonProps = { slug, contentLocale, isFallback, section }
---

<SectionEntryPage kind={kind} {...commonProps}>
  <SummitContentPage slug={slug} contentLocale={contentLocale} />
</SectionEntryPage>
