---
/**
 * Temp QA page for Agenda (INTORG-1022). Not linked from nav. noindex.
 * URL: /preview/agenda
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Agenda from '@/components/blocks/Agenda.astro'

const dayOne = [
  {
    time: '8:30 am – 9:00 am',
    activity: 'Registration',
    additionalInfo: '* Participants arrive & register\n* Breakfast is available'
  },
  {
    time: '9:00 am – 9:30 am',
    activity: 'Welcome & housekeeping',
    additionalInfo: '* Welcome, overview of theme & guidelines'
  },
  {
    time: '9:30 am – 10:15 am',
    activity: 'Kickoff briefing'
  }
]

const dayTwo = [
  {
    time: '9:00 am – 9:20 am',
    activity: 'Morning stand-up',
    additionalInfo:
      '* Confirm demo order and AV needs\n* Final submission checklist at the help desk'
  },
  {
    time: '9:20 am – 12:00 pm',
    activity: 'Final build & freeze',
    additionalInfo:
      '* Last push before code freeze at noon\n* Mentors available for demo polish only'
  },
  {
    time: '12:45 pm – 2:30 pm',
    activity: 'Team demos',
    additionalInfo:
      '* 5 minutes per team including Q&A\n* Live scoring by the judge panel'
  }
]
---

<BaseLayout title="Agenda preview" noindex={true}>
  <main class="page-stack pb-section">
    <section class="px-content pt-page-offset">
      <div class="content-column">
        <p class="mb-xl text-body-sm-standard text-neutral-75">
          Temp QA page for INTORG-1022. VoiceOver on a row with extra info
          should read “Time, …, 1 of 3” (not 1 of 6). The third Day 1 slot has
          no additional info, so that row is 1 of 2.
        </p>
        <div data-prose class="mx-auto max-w-content">
          <Agenda heading="Day 1 — Friday, 6 November 2026" items={dayOne} />
          <Agenda heading="Day 2 — Saturday, 7 November 2026" items={dayTwo} />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
