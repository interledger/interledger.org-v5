---
import type { Page, GetStaticPaths } from 'astro'
import { paginatePodcastEpisodes } from '@/utils'
import type { PodcastPageData } from '@/utils'
import type { Locale } from '@/utils'
import type { PodcastItemType } from '@/schemas/content'
import PodcastPage from '@/components/pages/PodcastPage.astro'

type Props = {
  page: Page<PodcastItemType>
  podcastPage: PodcastPageData
  contentLocale: Locale
  isFallback: boolean
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  return paginatePodcastEpisodes({ paginate, lang: 'es' })
}
---

<PodcastPage {...Astro.props} />
