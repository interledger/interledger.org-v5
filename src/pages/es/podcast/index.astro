---
import PodcastPage from '@/components/pages/PodcastPage.astro'
import { defaultLocale, type Locale, PODCAST_PAGE_SLUG } from '@/utils'
import { getCollection } from 'astro:content'

const pageLang: Locale = 'es'

const pages = await getCollection('podcast-pages')
const localizedPodcastPage = pages.find(
  (page) =>
    page.data.pathSlug === PODCAST_PAGE_SLUG && page.data.locale === pageLang
)

const contentLocale = localizedPodcastPage ? pageLang : defaultLocale
const isFallback = !localizedPodcastPage
---

<PodcastPage
  slug={PODCAST_PAGE_SLUG}
  contentLocale={contentLocale}
  isFallback={isFallback}
/>
