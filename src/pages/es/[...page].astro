---
import FoundationContentPage from '@/components/pages/FoundationContentPage.astro'
import SectionEntryPage from '@/components/pages/SectionEntryPage.astro'
import {
  getLocalizedPaths,
  getCrossSectionPaths,
  grantOverviewRouteParam
} from '@/utils'

export async function getStaticPaths() {
  const [foundationPages, grantPages, grantOverviews, crossSectionPaths] =
    await Promise.all([
      getLocalizedPaths('foundation-pages', 'es', 'page'),
      getLocalizedPaths('grant-pages', 'es', 'page'),
      getLocalizedPaths('grant-overview-pages', 'es', 'page'),
      getCrossSectionPaths('foundation', 'es', 'page')
    ])

  return [
    ...crossSectionPaths,
    ...foundationPages.map((p) => ({
      ...p,
      props: { ...p.props, kind: 'page' as const }
    })),
    ...grantPages.map((p) => ({
      params: { page: `grant/${p.params.page}` },
      props: { ...p.props, kind: 'grant-page' as const }
    })),
    ...grantOverviews.map((p) => ({
      params: { page: grantOverviewRouteParam(p.props.slug) },
      props: { ...p.props, kind: 'grant-overview-page' as const }
    }))
  ]
}

const { slug, locale: contentLocale, kind, isFallback, section } = Astro.props
const commonProps = { slug, contentLocale, isFallback }
---

<SectionEntryPage kind={kind} section={section} {...commonProps}>
  <FoundationContentPage {...commonProps} />
</SectionEntryPage>
