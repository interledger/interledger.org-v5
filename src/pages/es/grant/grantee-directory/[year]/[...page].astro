---
import type { GetStaticPaths, Page } from 'astro'
import { granteeDirectorySources } from '@/data/airtable/granteeDirectorySources'
import GranteeDirectoryPage from '@/components/pages/GranteeDirectoryPage.astro'
import {
  getGranteeListingData,
  paginateGranteesByYear,
  type GranteeDirectoryEntry,
  type GranteeFilterOption
} from '@/utils'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const listing = getGranteeListingData(granteeDirectorySources(), 'es')
  if (listing instanceof Error) throw listing
  return paginateGranteesByYear({ paginate, ...listing })
}

interface Props {
  page: Page<GranteeDirectoryEntry>
  years: GranteeFilterOption[]
  tags: GranteeFilterOption[]
  selectedYear?: string
  selectedTag?: string
}

const props = Astro.props
---

<GranteeDirectoryPage {...props} />
