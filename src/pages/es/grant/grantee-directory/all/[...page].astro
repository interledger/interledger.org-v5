---
/**
 * Legacy `/es/grant/grantee-directory/all/<tag>` bookmarks. See the EN twin.
 */
import type { GetStaticPaths } from 'astro'
import rawGranteeData from '@/data/airtable/grantee-data.json'
import {
  getGranteeListingData,
  grantGranteeDirectoryPath,
  legacyAllYearsRedirects,
  localizeRoute
} from '@/utils'

export const getStaticPaths: GetStaticPaths = async () => {
  const listing = getGranteeListingData(rawGranteeData, 'es')
  if (listing instanceof Error) throw listing
  return legacyAllYearsRedirects(
    listing,
    localizeRoute(grantGranteeDirectoryPath(), 'es')
  )
}
---
