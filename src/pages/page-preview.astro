---
/**
 * Page Preview Route (SSR)
 * Fetches draft content from Strapi for preview before publishing
 * URL: /page-preview?documentId={documentId}
 * Fundraising pages add `&type=fundraising`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import FundraisingPagePreview from '@/components/pages/FundraisingPagePreview.astro'
import DynamicZone from '@/components/blocks/DynamicZone.astro'
import TableScrollSupport from '@/components/shared/TableScrollSupport.astro'
import PageHero from '@/components/shared/PageHero.astro'
import FundraiseUpScript from '@/components/support/FundraiseUpScript.astro'
import {
  applyPreviewNoStore,
  fetchStrapi,
  hasFundraiseUpElementId
} from '@/utils'

interface HeroCta {
  text?: string
  link?: string
  style?: 'primary' | 'secondary'
  external?: boolean
  document?: boolean
}

interface MediaFile {
  url?: string
  alternativeText?: string | null
}

interface LocalizedMedia {
  image?: MediaFile | null
  alternativeText?: string | null
}

interface FoundationPagePreview {
  title?: string
  description?: string
  hero?: {
    title?: string
    description?: string
    media?: LocalizedMedia | null
    backgroundImageMobile?: MediaFile | null
    hero_call_to_action?: HeroCta | null
  }
  content?: Array<{ __component: string; [key: string]: unknown }>
}

export const prerender = false
applyPreviewNoStore(Astro.response.headers)

const documentId = Astro.url.searchParams.get('documentId')
if (!documentId) {
  return Astro.redirect('/404')
}

// Build populate query for dynamic zone with nested relations
// Note: In Strapi v5, using `on` for any component in a dynamic zone
// requires listing ALL component types — unlisted types are excluded.
const populateParams = new URLSearchParams({
  status: 'draft',
  'populate[hero][populate][media][populate]': 'image',
  'populate[hero][populate][backgroundImageMobile]': 'true',
  'populate[hero][populate][hero_call_to_action]': 'true',
  'populate[content][on][blocks.paragraph][populate]': '*',
  'populate[content][on][blocks.agenda][populate][items]': '*',
  'populate[content][on][blocks.blockquote][populate]': '*',
  'populate[content][on][blocks.quote][populate]': '*',
  'populate[content][on][blocks.cta-strip][populate]': '*',
  'populate[content][on][blocks.carousel][populate][logos][populate]': '*',
  'populate[content][on][blocks.profile][populate][profile][populate]': '*',
  'populate[content][on][blocks.profile-grid][populate][profiles][populate]':
    '*',
  'populate[content][on][blocks.faq][populate][items]': '*',
  'populate[content][on][blocks.cta-buttons][populate][buttons]': '*',
  'populate[content][on][blocks.event-card][populate][when]': '*',
  'populate[content][on][blocks.event-card][populate][where]': '*',
  'populate[content][on][blocks.event-card][populate][apply][populate]': '*',
  'populate[content][on][blocks.code-block][populate]': '*',
  'populate[content][on][blocks.donation-cards][populate][cards]': '*',
  'populate[content][on][blocks.split-layout][populate][media][populate]':
    'image',
  'populate[content][on][blocks.split-layout][populate][cta]': 'true',
  'populate[content][on][blocks.card-grid][populate][infoCards][populate]': '*',
  'populate[content][on][blocks.card-grid][populate][titleCards][populate]':
    '*',
  'populate[content][on][blocks.card-grid][populate][resourceCards][populate]':
    '*',
  'populate[content][on][blocks.card-grid][populate][navigationCards][populate]':
    '*'
})

// The admin preview link for a Fundraising Page sets type=fundraising.
// That document is not in foundation-pages, so the default lookup 404s.
const isFundraising = Astro.url.searchParams.get('type') === 'fundraising'
const apiId = isFundraising ? 'fundraising-pages' : 'foundation-pages'

const response = await fetchStrapi<FoundationPagePreview>(
  `api/${apiId}/${documentId}?${populateParams.toString()}`
)
if (response instanceof Error) {
  return Astro.redirect('/404')
}
const page = response.data
if (!page) {
  return Astro.redirect('/404')
}

const title = page.title || 'Preview'
const metaDescription = page.description || undefined
const heroTitle = page.hero?.title || page.title
const heroDescription = page.hero?.description
const heroImage = page.hero?.media?.image?.url
const heroImageAlt =
  page.hero?.media?.alternativeText ?? page.hero?.media?.image?.alternativeText
const heroImageMobile = page.hero?.backgroundImageMobile?.url
const heroImageMobileAlt = page.hero?.backgroundImageMobile?.alternativeText
const heroCta = page.hero?.hero_call_to_action
const content = page.content || []
const needsFundraiseUp =
  hasFundraiseUpElementId(content) || hasFundraiseUpElementId(heroCta)
---

{
  isFundraising ? (
    <FundraisingPagePreview
      title={title}
      description={metaDescription}
      heroTitle={heroTitle}
      heroDescription={heroDescription}
      heroImage={heroImage}
      heroImageAlt={heroImageAlt}
      heroImageMobile={heroImageMobile}
      heroImageMobileAlt={heroImageMobileAlt}
      heroCta={heroCta}
      content={content}
    />
  ) : (
    <BaseLayout title={`[PREVIEW] ${title}`} description={metaDescription}>
      <Fragment slot="head">
        {/* A CMS preview is not a publish. Never let it charge a card. */}
        {needsFundraiseUp && <FundraiseUpScript testMode={true} />}
      </Fragment>
      <TableScrollSupport />
      <main class="pb-3xl">
        <div class="bg-yellow-400 py-2 text-center font-semibold text-black">
          PREVIEW MODE - This content is not published
        </div>

        {heroTitle && (
          <PageHero
            title={heroTitle}
            description={heroDescription}
            image={heroImage}
            imageMobile={heroImageMobile}
            imageAlt={heroImageAlt}
            imageMobileAlt={heroImageMobileAlt}
            cta={heroCta}
          />
        )}

        {content.length > 0 && (
          <section class="px-content py-4xl">
            <div class="content-column min-w-0" data-prose-blog>
              <DynamicZone blocks={content} />
            </div>
          </section>
        )}
      </main>
    </BaseLayout>
  )
}
