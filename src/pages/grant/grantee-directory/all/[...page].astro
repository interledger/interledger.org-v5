---
/**
 * Legacy `/grant/grantee-directory/all/<tag>` bookmarks. Colliding tags
 * (`all`, digits) go to `/tag/<slug>`; everything else drops the `/all` prefix.
 */
import type { GetStaticPaths } from 'astro'
import rawGranteeData from '@/data/airtable/grantee-data.json'
import {
  getGranteeListingData,
  grantGranteeDirectoryPath,
  legacyAllYearsRedirects
} from '@/utils'

export const getStaticPaths: GetStaticPaths = async () => {
  const listing = getGranteeListingData(rawGranteeData, 'en')
  if (listing instanceof Error) throw listing
  return legacyAllYearsRedirects(listing, grantGranteeDirectoryPath())
}
---
