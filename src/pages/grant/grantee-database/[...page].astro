---
import type { GetStaticPaths, Page } from 'astro'
import rawGranteeData from '@/data/airtable/grantee-data.json'
import GranteeDatabasePage from '@/components/pages/GranteeDatabasePage.astro'
import {
  parseGranteeRecords,
  uniqueFilterOptions,
  GRANTEE_PAGE_SIZE,
  type Grantee,
  type GranteeFilterOption
} from '@/utils'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = parseGranteeRecords(rawGranteeData, 'en')
  if (all instanceof Error) throw all

  const years = uniqueFilterOptions(all, 'year')
  const programs = uniqueFilterOptions(all, 'program')
  const countries = uniqueFilterOptions(all, 'country')

  return paginate(all, { pageSize: GRANTEE_PAGE_SIZE }).map((route) => ({
    ...route,
    props: {
      ...route.props,
      years,
      programs,
      countries
    }
  }))
}

interface Props {
  page: Page<Grantee>
  years: GranteeFilterOption[]
  programs: GranteeFilterOption[]
  countries: GranteeFilterOption[]
}

const props = Astro.props
---

<GranteeDatabasePage {...props} />
