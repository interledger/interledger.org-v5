{
  "name": "interledger-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0 <=24.x.x"
  },
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:netlify": "npx netlify dev --command 'npx serve dist -l 5557' --target-port 5557 --framework '#custom'",
    "astro": "astro",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx,json,md,astro}' && node scripts/format-mdx.mjs --write && eslint --max-warnings=0 --fix .",
    "lint": "prettier --check '**/*.{js,mjs,ts,tsx,json,md,astro}' && node scripts/format-mdx.mjs --check && eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "optimize:images": "tsx ./scripts/optimize-images.ts",
    "prebuild": "node scripts/evict-content-store.mjs && pnpm run optimize:images",
    "sync:sessionize": "tsx ./scripts/sync-sessionize.ts",
    "sync:airtable": "tsx ./scripts/import-airtable.ts"
  },
  "dependencies": {
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.38.5",
    "@interledger/docs-design-system": "^0.11.2",
    "@linear/sdk": "^87.0.0",
    "@netlify/blobs": "^10.7.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/showdown": "^2.0.6",
    "astro": "^6.4.8",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "html-to-text": "^9.0.5",
    "lenis": "^1.3.26",
    "markdown-it": "^14.3.2",
    "marked": "^17.0.6",
    "node-html-parser": "^7.1.0",
    "sharp": "^0.34.5",
    "shiki": "^4.5.0",
    "showdown": "^2.1.0",
    "starlight-fullview-mode": "^0.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^5.3.0",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
