# Two groups of rules serve /404.html with a 404 status, and they differ on
# purpose:
# - The /404 rules are forced with "!". Netlify serves a real file before any
#   rule, so without "!" the 404 page answers 200 at its own URL.
# - The grantee ".../tag/*" stop rules below are not forced. A canonical
#   grantee page that exists must still be served as a file; they only catch
#   missing ones before the legacy /:year/:tag rules can loop.

/404         /404.html    404!
/404.html    /404.html    404!

# Grantee directory legacy URLs [INTORG-1112]
# Netlify applies the first matching rule, and a real page always wins over
# any rule, so the order below is load-bearing.
#
# 1. /all/:tag comes first so "all" is not captured as :year.
# 2. The 404s come next. The legacy /:year/:tag rules below also match
#    canonical /:year/tag/:slug (the second segment is the literal "tag"),
#    which would 301 to /:year/tag/tag/:slug and loop. Canonical pages that
#    exist are served as files; missing ones stop here with a 404.
# 3. The legacy /:year/:tag rules.
#
# Page destinations end in "/", except after :splat. The * keeps the
# request's trailing slash, so ":splat/" would turn /all/x/2/ into …/2//.
# Without it, /all/x/2/ redirects once; /all/x/2 gets a second 301 from
# Netlify to add the slash.
#
# These live here, not in redirects.ts: Astro appends its rules after this
# file and emits a dynamic [...page] destination as a literal "*", so every
# match lands on a 404.

/grant/grantee-directory/all/:tag    /grant/grantee-directory/tag/:tag/         301
/grant/grantee-directory/all/:tag/*  /grant/grantee-directory/tag/:tag/:splat    301
/es/grant/grantee-directory/all/:tag    /es/grant/grantee-directory/tag/:tag/         301
/es/grant/grantee-directory/all/:tag/*  /es/grant/grantee-directory/tag/:tag/:splat    301

/grant/grantee-directory/:year/tag/*    /404.html    404
/grant/grantee-directory/tag/*          /404.html    404
/es/grant/grantee-directory/:year/tag/*    /404.html    404
/es/grant/grantee-directory/tag/*          /404.html    404

/grant/grantee-directory/:year/:tag    /grant/grantee-directory/:year/tag/:tag/         301
/grant/grantee-directory/:year/:tag/*  /grant/grantee-directory/:year/tag/:tag/:splat    301
/es/grant/grantee-directory/:year/:tag    /es/grant/grantee-directory/:year/tag/:tag/         301
/es/grant/grantee-directory/:year/:tag/*  /es/grant/grantee-directory/:year/tag/:tag/:splat    301
